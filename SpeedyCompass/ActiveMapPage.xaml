<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             x:Class="SpeedyCompass.ActiveMapPage"
             x:Name="ThisPage"
             Title="Active Ride">

    <Grid RowDefinitions="Auto, *, Auto" BackgroundColor="{AppThemeBinding Light=White, Dark=#121212}">

        <!-- 1. Top Bar: Launch Native Google Maps -->
        <Grid Grid.Row="0" Padding="15,15,15,10">
            <Button Text="Start Google Maps" 
                    Clicked="OnLaunchNativeNavClicked"
                    HorizontalOptions="Fill"
                    CornerRadius="25"
                    HeightRequest="50"
                    BackgroundColor="DodgerBlue"
                    TextColor="White"
                    FontAttributes="Bold"
                    Shadow="{Shadow Brush=Black, Offset='0,4', Opacity=0.3, Radius=8}" />
        </Grid>

        <!-- 2. The Map (Middle row guarantees corners are free) -->
        <!-- IsShowingUser is set to True to show the native blue ping alongside the custom marker -->
        <maps:Map x:Name="NavMap" Grid.Row="1" IsShowingUser="True" />

        <!-- 3. Bottom Area: Floating User Banners (Carousel) -->
        <Grid Grid.Row="2" Padding="0,15,0,30">
            <CollectionView x:Name="RidersCollectionView"
                            ItemsSource="{Binding RidersRoster, Source={x:Reference ThisPage}}"
                            HeightRequest="100"
                            HorizontalScrollBarVisibility="Never">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="15" SnapPointsType="MandatorySingle" SnapPointsAlignment="Center" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid WidthRequest="220" Margin="15,0,0,0">
                            <!-- The Visible Card -->
                            <Frame CornerRadius="12" HasShadow="True" Padding="15" BorderColor="Transparent" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                                <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                                    <Label Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontAttributes="Bold" FontSize="16" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                                    <Label Grid.Row="1" Grid.Column="0" Text="{Binding SpeedDisplay}" TextColor="DodgerBlue" FontSize="14" FontAttributes="Bold" Margin="0,5,0,0"/>

                                    <Image Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Source="info_icon.png" WidthRequest="24" HeightRequest="24" VerticalOptions="Center" Opacity="0.5"/>
                                </Grid>
                            </Frame>

                            <!-- Invisible Button Overlay to catch 3-second Long Press -->
                            <Button Opacity="0" Pressed="OnBannerPressed" Released="OnBannerReleased" CommandParameter="{Binding .}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- 4. The 3-Second Hold Details Popup (Spans all rows to darken screen) -->
        <ContentView x:Name="DetailsPopup" Grid.RowSpan="3" IsVisible="True" BackgroundColor="#80000000" AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All">
            <Frame HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="300" CornerRadius="15" Padding="20" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                <StackLayout Spacing="10">
                    <Label x:Name="PopupNameLabel" FontAttributes="Bold" FontSize="20" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                    <BoxView HeightRequest="1" Color="LightGray" Margin="0,5"/>

                    <Grid ColumnDefinitions="Auto, *" RowSpacing="10">
                        <Label Grid.Row="0" Grid.Column="0" Text="Speed: " FontAttributes="Bold" TextColor="Gray"/>
                        <Label Grid.Row="0" Grid.Column="1" x:Name="PopupSpeedLabel" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>

                        <Label Grid.Row="1" Grid.Column="0" Text="Altitude: " FontAttributes="Bold" TextColor="Gray"/>
                        <Label Grid.Row="1" Grid.Column="1" x:Name="PopupAltitudeLabel" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>

                        <Label Grid.Row="2" Grid.Column="0" Text="Coords: " FontAttributes="Bold" TextColor="Gray"/>
                        <Label Grid.Row="2" Grid.Column="1" x:Name="PopupLocationLabel" FontSize="12" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                    </Grid>

                    <Button Text="Close" Clicked="OnClosePopupClicked" Margin="0,15,0,0" BackgroundColor="DodgerBlue" TextColor="White" CornerRadius="10"/>
                </StackLayout>
            </Frame>
        </ContentView>

    </Grid>
</ContentPage>