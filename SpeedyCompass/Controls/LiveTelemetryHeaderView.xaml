<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SpeedyCompass.Controls"
             x:Class="SpeedyCompass.Controls.LiveTelemetryHeaderView">

    <Grid Padding="20,15,20,15" BackgroundColor="Transparent">
        <!-- We pass these gestures back to the LobbyPage so the drawer still swipes perfectly! -->
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnHeaderTapped" />
            <PanGestureRecognizer PanUpdated="OnHeaderPanUpdated" />
        </Grid.GestureRecognizers>

        <Grid ColumnDefinitions="1.2*, 1*, Auto" ColumnSpacing="10">

            <!-- Left: Speed, Location & Destination -->
            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">

                <!-- THE FIX: Highly visible Speedometer -->
                <Label x:Name="MySpeedLabel" Text="0 km/h" FontSize="22" FontAttributes="Bold" TextColor="MediumSeaGreen" Margin="0,0,0,4"/>

                <StackLayout Orientation="Horizontal" Spacing="4">
                    <Label Text="Distance" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333, Dark=White}" VerticalOptions="Center"/>
                    <Label x:Name="MyDistanceLabel" Text="-- km" FontSize="12" FontAttributes="Bold" TextColor="DodgerBlue" VerticalOptions="Center"/>
                </StackLayout>

                <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, *" RowSpacing="2" ColumnSpacing="5">
                    <!-- Origin Coordinates -->
                    <Label Grid.Row="0" Grid.Column="0" Text="🏁" FontSize="10" TextColor="Gray" VerticalOptions="Start" Margin="0,1,0,0"/>
                    <Label Grid.Row="0" Grid.Column="1" x:Name="TelemetryOriginLabel" Text="Acquiring GPS..." FontSize="11" TextColor="Gray" LineBreakMode="TailTruncation" MaxLines="1" VerticalOptions="Start"/>

                    <!-- Destination -->
                    <Label Grid.Row="1" Grid.Column="0" Text="📍" FontSize="10" TextColor="DodgerBlue" VerticalOptions="Start" Margin="0,1,0,0"/>
                    <Label Grid.Row="1" Grid.Column="1" x:Name="TelemetryDestLabel" Text="Destination" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333, Dark=White}" LineBreakMode="WordWrap" MaxLines="3" VerticalOptions="Start"/>
                </Grid>
            </VerticalStackLayout>

            <!-- Middle: Progress Bar Layout -->
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                <Label Text="Route" FontSize="11" TextColor="Gray" FontAttributes="Bold" HorizontalOptions="Center"/>

                <Grid HorizontalOptions="Center" WidthRequest="60" HeightRequest="60">
                    <controls:CircularProgressBar x:Name="RouteProgressBar" WidthRequest="60" HeightRequest="60" StrokeThickness="5" ProgressColor="MediumSeaGreen" TrackColor="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" />
                    <Label x:Name="MyProgressPercentLabel" Text="0%" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333, Dark=White}" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Grid>

                <StackLayout Orientation="Horizontal" HorizontalOptions="Center" Spacing="2">
                    <Label x:Name="MyTotalTraveledLabel" Text="0.0" FontSize="10" FontAttributes="Bold" TextColor="Gray"/>
                    <Label Text="/" FontSize="10" TextColor="Gray" VerticalOptions="Center"/>
                    <Label x:Name="MyTotalRouteLabel" Text="-- km" FontSize="10" TextColor="Gray" VerticalOptions="Center"/>
                </StackLayout>
            </VerticalStackLayout>

            <!-- Right: Arrival Time, Top Speed, & Elevation -->
            <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" HorizontalOptions="End" Spacing="6">

                <!-- Arrival Time -->
                <VerticalStackLayout Spacing="0">
                    <Label Text="Arrival time" FontSize="10" TextColor="Gray" FontAttributes="Bold" HorizontalOptions="End"/>
                    <Label x:Name="MyEtaLabel" Text="--:--" FontSize="14" FontAttributes="Bold" TextColor="DarkOrange" HorizontalOptions="End"/>
                </VerticalStackLayout>

                <!-- Top Speed -->
                <VerticalStackLayout Spacing="0">
                    <Label Text="Top Speed" FontSize="10" TextColor="Gray" FontAttributes="Bold" HorizontalOptions="End"/>
                    <Label x:Name="MyTopSpeedLabel" Text="0 km/h" FontSize="12" FontAttributes="Bold" TextColor="#D32F2F" HorizontalOptions="End"/>
                </VerticalStackLayout>

                <!-- NEW: Elevation -->
                <VerticalStackLayout Spacing="0">
                    <Label Text="Elevation" FontSize="10" TextColor="Gray" FontAttributes="Bold" HorizontalOptions="End"/>
                    <Label x:Name="MyElevationLabel" Text="-- m" FontSize="12" FontAttributes="Bold" TextColor="MediumPurple" HorizontalOptions="End"/>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentView>