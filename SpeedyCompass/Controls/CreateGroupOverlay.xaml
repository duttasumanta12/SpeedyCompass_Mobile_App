<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SpeedyCompass.Controls.CreateGroupOverlay"
             IsVisible="False"
             ZIndex="2000">

    <Grid BackgroundColor="#B3000000" InputTransparent="False" Padding="20">
        <Border VerticalOptions="Center" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" Padding="25">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="25"/>
            </Border.StrokeShape>
            <ScrollView>
                <StackLayout Spacing="20">
                    <Label Text="Configure Convoy" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <Label Text="Set up the safety parameters for this ride." FontSize="13" TextColor="Gray" HorizontalOptions="Center" Margin="0,-10,0,10"/>

                    <!-- Group Name -->
                    <StackLayout Spacing="5">
                        <Label Text="Convoy Name" FontAttributes="Bold" FontSize="14"/>
                        <Border Stroke="#E0E0E0" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light=#F9F9F9, Dark=#2A2A2A}" Padding="15,0" HeightRequest="50">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Entry x:Name="NewGroupNameEntry" Placeholder="e.g. Sunday Morning Canyon" BackgroundColor="Transparent" VerticalOptions="Center"/>
                        </Border>
                    </StackLayout>

                    <!-- Group Size -->
                    <StackLayout Spacing="5">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Max Group Size" FontAttributes="Bold" FontSize="14"/>
                            <Label x:Name="CreateSizeLabel" Grid.Column="1" Text="10 Riders" FontAttributes="Bold" TextColor="DodgerBlue"/>
                        </Grid>
                        <Slider x:Name="CreateSizeSlider" Minimum="2" Maximum="30" Value="10" MinimumTrackColor="DodgerBlue" ValueChanged="OnCreateSizeSliderChanged"/>
                    </StackLayout>

                    <!-- Lag Warning -->
                    <StackLayout Spacing="5">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Lag Warning Distance" FontAttributes="Bold" FontSize="14"/>
                            <Label x:Name="CreateLagLabel" Grid.Column="1" Text="500m" FontAttributes="Bold" TextColor="DodgerBlue"/>
                        </Grid>
                        <Slider x:Name="CreateLagSlider" Minimum="0" Maximum="2000" Value="500" MinimumTrackColor="DodgerBlue" ValueChanged="OnCreateLagSliderChanged"/>
                        <Label Text="Alerts the Admin if a rider falls behind this distance." FontSize="11" TextColor="Gray"/>
                    </StackLayout>

                    <!-- Splinter Warning -->
                    <StackLayout Spacing="5">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Splinter Warning" FontAttributes="Bold" FontSize="14"/>
                            <Label x:Name="CreateSplinterLabel" Grid.Column="1" Text="2000m" FontAttributes="Bold" TextColor="DodgerBlue"/>
                        </Grid>
                        <Slider x:Name="CreateSplinterSlider" Minimum="0" Maximum="10000" Value="2000" MinimumTrackColor="DodgerBlue" ValueChanged="OnCreateSplinterSliderChanged"/>
                        <Label Text="Alerts if the group stretches too far from front to back." FontSize="11" TextColor="Gray"/>
                    </StackLayout>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0,15,0,0">
                        <Button Grid.Column="0" Text="Cancel" BackgroundColor="#F0F0F0" TextColor="#333333" FontAttributes="Bold" CornerRadius="12" HeightRequest="50" Clicked="OnCancelClicked"/>
                        <Button Grid.Column="1" Text="Generate PIN" BackgroundColor="DarkOrange" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="50" Clicked="OnGenerateClicked"/>
                    </Grid>
                </StackLayout>
            </ScrollView>
        </Border>
    </Grid>
</ContentView>