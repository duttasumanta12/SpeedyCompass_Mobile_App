<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SpeedyCompass.Controls.SafetyActionsTabView">

    <!-- UPGRADE: Centralized Resource Dictionary keeps the UI code clean -->
    <ContentView.Resources>
        <!-- Global animation state for all dashboard tiles -->
        <Style TargetType="Border" x:Key="InteractiveTileStyle">
            <Setter Property="StrokeShape">
                <Setter.Value>
                    <RoundRectangle CornerRadius="20" />
                </Setter.Value>
            </Setter>
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="Scale" Value="1.0" />
                                <Setter Property="Opacity" Value="1.0" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="Scale" Value="0.94" />
                                <Setter Property="Opacity" Value="0.7" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>

        <!-- Specific style for standard light/dark tiles -->
        <Style TargetType="Border" BasedOn="{StaticResource InteractiveTileStyle}" x:Key="StandardTileStyle">
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Stroke" Value="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=#2A2A2A}" />
        </Style>
    </ContentView.Resources>

    <VerticalStackLayout Spacing="16" Padding="16,24">

        <!-- PTT Walkie-Talkie Card -->
        <Border x:Name="PttCard" 
                HeightRequest="90" 
                IsVisible="False" 
                StrokeThickness="0" 
                BackgroundColor="{AppThemeBinding Light=#2C3E50, Dark=#1A1C1E}" 
                Style="{StaticResource InteractiveTileStyle}">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnPttClicked" />
            </Border.GestureRecognizers>
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,4" Opacity="0.15" Radius="8" />
            </Border.Shadow>

            <Grid ColumnDefinitions="Auto, *, Auto" Padding="20,0">
                <Border Grid.Column="0" WidthRequest="50" HeightRequest="50" StrokeThickness="0" BackgroundColor="#27AE60" VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="25" />
                    </Border.StrokeShape>
                    <Label Text="mic" FontFamily="MaterialSymbols" TextColor="White" FontSize="26" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>

                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="16,0,0,0" Spacing="2">
                    <Label Text="PUSH TO TALK" FontSize="18" FontAttributes="Bold" TextColor="White" />
                    <Label Text="Global Convoy Channel" FontSize="13" TextColor="#B0BEC5" />
                </VerticalStackLayout>

                <Ellipse Grid.Column="2" WidthRequest="12" HeightRequest="12" Fill="#27AE60" VerticalOptions="Center"/>
            </Grid>
        </Border>

        <!-- DASHBOARD GRID: Square tiles for massive, glove-friendly touch targets -->
        <Grid ColumnDefinitions="*, *" ColumnSpacing="16" HeightRequest="130">

            <!-- Refuel Tile -->
            <Border Grid.Column="0" Style="{StaticResource StandardTileStyle}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRefuelStopClicked" />
                </Border.GestureRecognizers>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                    <Label Text="local_gas_station" FontFamily="MaterialSymbols" FontSize="38" TextColor="{AppThemeBinding Light=#333333, Dark=White}" HorizontalOptions="Center"/>
                    <Label Text="REFUEL" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333333, Dark=White}" HorizontalOptions="Center" CharacterSpacing="1"/>
                </VerticalStackLayout>
            </Border>

            <!-- Rest Tile -->
            <Border Grid.Column="1" Style="{StaticResource StandardTileStyle}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRestStopClicked" />
                </Border.GestureRecognizers>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                    <Label Text="local_cafe" FontFamily="MaterialSymbols" FontSize="38" TextColor="{AppThemeBinding Light=#333333, Dark=White}" HorizontalOptions="Center"/>
                    <Label Text="REST" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333333, Dark=White}" HorizontalOptions="Center" CharacterSpacing="1"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- ======================================================= -->
        <!-- THE FIX: NEW FORMATION BUTTON -->
        <!-- ======================================================= -->
        <Border HeightRequest="76" StrokeThickness="1.5" Stroke="#673AB7" BackgroundColor="{AppThemeBinding Light=#F3E5F5, Dark=#311B92}" Style="{StaticResource InteractiveTileStyle}">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnFormationChangeClicked" />
            </Border.GestureRecognizers>

            <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                <Label Text="view_stream" FontFamily="MaterialSymbols" FontSize="26" TextColor="{AppThemeBinding Light=#673AB7, Dark=White}" VerticalOptions="Center"/>
                <Label Text="CHANGE FORMATION" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#673AB7, Dark=White}" VerticalOptions="Center" CharacterSpacing="1.5"/>
            </HorizontalStackLayout>
        </Border>

        <!-- Native Nav -->
        <Border HeightRequest="76" StrokeThickness="1.5" Stroke="#0F9D58" BackgroundColor="{AppThemeBinding Light=#F1FAF4, Dark=#15261B}" Style="{StaticResource InteractiveTileStyle}">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnLaunchNativeNavClicked" />
            </Border.GestureRecognizers>

            <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                <Label Text="navigation" FontFamily="MaterialSymbols" FontSize="26" TextColor="#0F9D58" VerticalOptions="Center"/>
                <Label Text="OPEN NATIVE GPS" FontSize="16" FontAttributes="Bold" TextColor="#0F9D58" VerticalOptions="Center" CharacterSpacing="1.5"/>
            </HorizontalStackLayout>
        </Border>

        <Border HeightRequest="80" StrokeThickness="0" Margin="0,24,0,0" Style="{StaticResource InteractiveTileStyle}">
            <Border.Background>
                <LinearGradientBrush EndPoint="1,0">
                    <GradientStop Color="#D32F2F" Offset="0.0" />
                    <GradientStop Color="#C62828" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnEmergencyStopClicked" />
            </Border.GestureRecognizers>
            <Border.Shadow>
                <Shadow Brush="Red" Offset="0,4" Opacity="0.3" Radius="12" />
            </Border.Shadow>

            <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                <Label Text="warning" FontFamily="MaterialSymbols" FontSize="28" TextColor="White" VerticalOptions="Center"/>
                <Label Text="EMERGENCY STOP" FontSize="18" FontAttributes="Bold" TextColor="White" VerticalOptions="Center" CharacterSpacing="1.5"/>
            </HorizontalStackLayout>
        </Border>

    </VerticalStackLayout>
</ContentView>