<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SpeedyCompass.Controls.ActiveGroupsList"
             xmlns:controls="clr-namespace:SpeedyCompass.Controls"
             x:Name="thisControl">

    <!-- Wrap everything in a Grid to support the Loading Overlay -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Search Bar -->
            <RowDefinition Height="*" />
            <!-- List -->
        </Grid.RowDefinitions>

        <!-- ========================================== -->
        <!-- SEARCH BAR                                 -->
        <!-- ========================================== -->
        <!-- UPGRADE: Standardized margins and added subtle border stroke for definition -->
        <Border Grid.Row="0" Margin="16,16,16,8" Padding="0" StrokeThickness="1" Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#1E1E1E}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12"/>
            </Border.StrokeShape>
            <SearchBar x:Name="GroupSearchBar" 
                       Placeholder="Search convoys..." 
                       TextChanged="OnSearchTextChanged" 
                       BackgroundColor="Transparent"
                       CancelButtonColor="#9E9E9E"/>
        </Border>

        <!-- ========================================== -->
        <!-- MAIN LIST AREA                             -->
        <!-- ========================================== -->
        <RefreshView Grid.Row="1" x:Name="GroupsRefreshView" Refreshing="OnRefreshRequested" RefreshColor="#00E676" Margin="0,8,0,0">

            <CollectionView ItemsSource="{Binding ItemsSource, Source={x:Reference thisControl}}"
                            RemainingItemsThreshold="2"
                            RemainingItemsThresholdReached="OnRemainingItemsThresholdReached">

                <!-- LIST HEADER -->
                <CollectionView.Header>
                    <HorizontalStackLayout Margin="24,8,24,16" Spacing="8" VerticalOptions="Center">
                        <Label Text="groups" FontFamily="MaterialSymbols" FontSize="24" TextColor="{AppThemeBinding Light=#1976D2, Dark=#64B5F6}" VerticalOptions="Center"/>
                        <Label Text="ACTIVE CONVOYS" FontSize="14" FontAttributes="Bold" CharacterSpacing="1.5" TextColor="{AppThemeBinding Light=#757575, Dark=#9E9E9E}" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </CollectionView.Header>

                <!-- EMPTY STATE -->
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="16" Margin="0,64,0,0">
                        <!-- UPGRADE: Replaced non-standard 'transportation' with 'explore' for the compass/map vibe -->
                        <Label Text="explore" FontFamily="MaterialSymbols" FontSize="56" TextColor="{AppThemeBinding Light=#E0E0E0, Dark=#424242}" HorizontalOptions="Center" />
                        <Label Text="{Binding EmptyMessage, Source={x:Reference thisControl}}" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#757575, Dark=#9E9E9E}" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <!-- ========================================== -->
                <!-- CONVOY ITEM TEMPLATE                       -->
                <!-- ========================================== -->
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <!-- UPGRADE: Replaced heavy Shadow with a clean 1px stroke for better scroll performance -->
                        <Border Margin="16,0,16,12" StrokeThickness="1" Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" BackgroundColor="{AppThemeBinding Light=White, Dark=#252525}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16"/>
                            </Border.StrokeShape>

                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="16" Padding="16">

                                <!-- ICON CONTAINER -->
                                <!-- UPGRADE: Replaced deprecated Frame with Border. Fixed red/blue color clashing. -->
                                <Border Grid.Column="0" WidthRequest="48" HeightRequest="48" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#FFEBEE, Dark=#4A0000}" VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="24"/>
                                    </Border.StrokeShape>
                                    <Label Text="share_location" FontFamily="MaterialSymbols" FontSize="24" TextColor="#E53935" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>

                                <!-- CONVOY INFO -->
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding GroupName}" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#212121, Dark=White}"/>

                                    <!-- Added micro-icon for members -->
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="group" FontFamily="MaterialSymbols" FontSize="14" TextColor="#9E9E9E" VerticalOptions="Center"/>
                                        <Label Text="{Binding MemberCountDisplay}" FontSize="13" TextColor="#757575" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>

                                    <!-- Added micro-icon and styling for Admin badge -->
                                    <HorizontalStackLayout Spacing="4" IsVisible="{Binding IsMyAdmin}" Margin="0,4,0,0">
                                        <Label Text="admin_panel_settings" FontFamily="MaterialSymbols" FontSize="14" TextColor="#FB8C00" VerticalOptions="Center"/>
                                        <Label Text="YOU ARE ADMIN" FontSize="10" TextColor="#FB8C00" FontAttributes="Bold" CharacterSpacing="1" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <!-- ACTIONS -->
                                <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">

                                    <!-- Delete Button: Replaced close_small with standard 'delete' icon for destructive semantics -->
                                    <Button Text="delete" 
                                            FontFamily="MaterialSymbols" 
                                            FontSize="20"
                                            BackgroundColor="{AppThemeBinding Light=#FFF0F0, Dark=#331111}" 
                                            TextColor="#E53935" 
                                            CornerRadius="12" 
                                            WidthRequest="44" 
                                            HeightRequest="44" 
                                            Padding="0" 
                                            IsVisible="{Binding IsMyAdmin}" 
                                            Clicked="OnDeleteGroupClicked" 
                                            CommandParameter="{Binding GroupName}"/>

                                    <!-- Join Button -->
                                    <Button Text="{Binding JoinButtonText}" 
                                            BackgroundColor="{Binding JoinButtonColor}" 
                                            TextColor="White" 
                                            FontSize="14"
                                            FontAttributes="Bold" 
                                            CornerRadius="12" 
                                            HeightRequest="44" 
                                            MinimumWidthRequest="80"
                                            Padding="16,0"
                                            Clicked="OnJoinGroupClicked" 
                                            CommandParameter="{Binding .}" 
                                            IsEnabled="{Binding CanJoin}">
                                        <Button.Shadow>
                                            <Shadow Brush="{Binding JoinButtonColor}" Offset="0,4" Opacity="0.3" Radius="8"/>
                                        </Button.Shadow>
                                    </Button>
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <!-- ========================================== -->
                <!-- PAGINATION FOOTER                          -->
                <!-- ========================================== -->
                <CollectionView.Footer>
                    <Grid Padding="24" IsVisible="{Binding IsLoadingMore, Source={x:Reference thisControl}}">
                        <ActivityIndicator IsRunning="True" Color="#00E676" HorizontalOptions="Center" />
                    </Grid>
                </CollectionView.Footer>

            </CollectionView>
        </RefreshView>

        <!-- GLOBAL LOADING OVERLAY -->
        <controls:LoadingOverlay x:Name="GlobalLoadingOverlay" 
                                 Grid.RowSpan="2" 
                                 ZIndex="9999" />

    </Grid>
</ContentView>