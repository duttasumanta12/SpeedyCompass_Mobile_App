<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SpeedyCompass.Controls.ActiveGroupsList"
             xmlns:controls="clr-namespace:SpeedyCompass.Controls"
             x:Name="thisControl">

    <!-- Wrap everything in a Grid to support the Loading Overlay -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Search Bar -->
            <RowDefinition Height="*" />
            <!-- List -->
        </Grid.RowDefinitions>

        <!-- 2. Search Bar -->
        <Border Grid.Row="0" Margin="20,10,20,5" Padding="0" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#1E1E1E}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12"/>
            </Border.StrokeShape>
            <SearchBar x:Name="GroupSearchBar" 
                       Placeholder="Search convoys..." 
                       TextChanged="OnSearchTextChanged" 
                       BackgroundColor="Transparent"
                       CancelButtonColor="Gray"/>
        </Border>

        <!-- List Area -->
        <RefreshView Grid.Row="1" x:Name="GroupsRefreshView" Refreshing="OnRefreshRequested" Margin="0,5,0,0">

            <!-- 3. Pagination Setup: RemainingItemsThreshold="2" fires the event when 2 items are left -->
            <CollectionView ItemsSource="{Binding ItemsSource, Source={x:Reference thisControl}}"
                            RemainingItemsThreshold="2"
                            RemainingItemsThresholdReached="OnRemainingItemsThresholdReached">

                <CollectionView.Header>
                    <Label Text="Active Convoys" FontSize="18" FontAttributes="Bold" Margin="25,5,0,15" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                </CollectionView.Header>

                <!-- 1. Dynamic Empty List Message -->
                <CollectionView.EmptyView>
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10" Margin="0,50,0,0">
                        <Label Text="transportation" FontFamily="MaterialSymbols" FontSize="48" HorizontalOptions="Center" Opacity="0.5"/>
                        <Label Text="{Binding EmptyMessage, Source={x:Reference thisControl}}" TextColor="Gray" HorizontalOptions="Center"/>
                    </StackLayout>
                </CollectionView.EmptyView>

                <!-- Item Template -->
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="20,0,20,15" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=White, Dark=#252525}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16"/>
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,4" Opacity="0.05" Radius="10"/>
                            </Border.Shadow>

                            <Grid ColumnDefinitions="Auto, *, Auto" Padding="15">
                                <!-- Icon -->
                                <Frame Grid.Column="0" BackgroundColor="#E6F2FF" CornerRadius="12" WidthRequest="50" HeightRequest="50" HasShadow="False" BorderColor="Transparent" Padding="0" Margin="0,0,15,0" VerticalOptions="Center">
                                    <Label Text="share_location" FontFamily="MaterialSymbols" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#CC0000" />
                                </Frame>

                                <!-- Info -->
                                <StackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding GroupName}" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333333, Dark=White}"/>
                                    <Label Text="{Binding MemberCountDisplay}" FontSize="13" TextColor="Gray"/>
                                    <Label Text="You are the Admin" FontSize="11" TextColor="DarkOrange" FontAttributes="Bold" IsVisible="{Binding IsMyAdmin}"/>
                                </StackLayout>

                                <!-- Actions -->
                                <StackLayout Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalOptions="Center">
                                    <Button Text="close_small" 
                                            FontFamily="MaterialSymbols" 
                                            FontSize="24"
                                            BackgroundColor="#FFF0F0" 
                                            TextColor="#CC0000" 
                                            CornerRadius="10" 
                                            WidthRequest="40" 
                                            HeightRequest="40" 
                                            Padding="0" 
                                            IsVisible="{Binding IsMyAdmin}" 
                                            Clicked="OnDeleteGroupClicked" 
                                            CommandParameter="{Binding GroupName}"/>

                                    <Button Text="{Binding JoinButtonText}" BackgroundColor="{Binding JoinButtonColor}" TextColor="White" CornerRadius="10" WidthRequest="80" HeightRequest="40" FontAttributes="Bold" Clicked="OnJoinGroupClicked" CommandParameter="{Binding .}" IsEnabled="{Binding CanJoin}">
                                        <Button.Shadow>
                                            <Shadow Brush="{Binding JoinButtonColor}" Offset="0,4" Opacity="0.3" Radius="8"/>
                                        </Button.Shadow>
                                    </Button>
                                </StackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <!-- 3. Pagination Footer Loader -->
                <CollectionView.Footer>
                    <Grid Padding="20" IsVisible="{Binding IsLoadingMore, Source={x:Reference thisControl}}">
                        <ActivityIndicator IsRunning="True" Color="MediumSeaGreen" HorizontalOptions="Center" />
                    </Grid>
                </CollectionView.Footer>

            </CollectionView>
        </RefreshView>

        <controls:LoadingOverlay x:Name="GlobalLoadingOverlay" Grid.RowSpan="100" 
                      Grid.ColumnSpan="100" 
                      ZIndex="9999" />

    </Grid>
</ContentView>