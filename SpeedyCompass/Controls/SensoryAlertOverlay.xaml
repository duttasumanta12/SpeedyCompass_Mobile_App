<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SpeedyCompass.Controls.SensoryAlertOverlay"
             IsVisible="False"
             InputTransparent="True"
             Opacity="0">

    <!-- Added x:Name to background grid so we can swap colors -->
    <Grid x:Name="AlertBackgroundGrid" BackgroundColor="Red">
        <StackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
            <!-- Added x:Name to Icon and Title -->
            <Label x:Name="AlertIconLabel" Text="🛑" FontSize="100" HorizontalTextAlignment="Center" />
            <Label x:Name="AlertTitleLabel" Text="EMERGENCY STOP!" TextColor="White" FontSize="36" FontAttributes="Bold" HorizontalTextAlignment="Center" />
            <Label x:Name="AlertSenderLabel" Text="Triggered by: Unknown" TextColor="White" FontSize="20" HorizontalTextAlignment="Center" />
        </StackLayout>
    </Grid>
</ContentView>