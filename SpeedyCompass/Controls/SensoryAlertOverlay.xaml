<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SpeedyCompass.Controls.SensoryAlertOverlay"
             IsVisible="False"
             InputTransparent="True"
             Opacity="0">

    <!-- UPGRADE: Replaced flat red with a rich, alarming gradient -->
    <Grid x:Name="AlertBackgroundGrid" Padding="24">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#E53935" Offset="0.0" />
                <GradientStop Color="#B71C1C" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <!-- UPGRADE: MaximumWidthRequest prevents stretching on tablets/landscape -->
        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="16" MaximumWidthRequest="400">

            <!-- UPGRADE: Replaced emoji with Material Symbol, added drop shadow -->
            <Grid HorizontalOptions="Center" HeightRequest="200" WidthRequest="200">

                <!-- Standard Material Icon (For Crash/Weather/Refuel) -->
                <!-- Font size increased slightly to match the new 200x200 container -->
                <Label x:Name="AlertIconLabel" 
                       Text="emergency" 
                       FontFamily="MaterialSymbols"
                       TextColor="White"
                       FontSize="140" 
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       HorizontalTextAlignment="Center">
                    <Label.Shadow>
                        <Shadow Brush="Black" Offset="0,4" Radius="8" Opacity="0.3"/>
                    </Label.Shadow>
                </Label>

                <!-- Image for Formations -->
                <!-- AspectFit ensures it scales up cleanly to fill the 200x200 box -->
                <Image x:Name="FormationImage"
                       IsVisible="False"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       Aspect="AspectFit">
                    <Image.Shadow>
                        <Shadow Brush="Black" Offset="0,4" Radius="8" Opacity="0.3"/>
                    </Image.Shadow>
                </Image>
            </Grid>

            <!-- UPGRADE: Added CharacterSpacing for ALL CAPS legibility -->
            <Label x:Name="AlertTitleLabel" 
                   Text="EMERGENCY STOP!" 
                   TextColor="White" 
                   FontSize="32" 
                   FontAttributes="Bold" 
                   CharacterSpacing="2"
                   HorizontalTextAlignment="Center" />

            <!-- UPGRADE: Softened text color to establish visual hierarchy -->
            <Label x:Name="AlertSenderLabel" 
                   Text="Triggered by: Unknown" 
                   TextColor="#FFCDD2" 
                   FontSize="18" 
                   HorizontalTextAlignment="Center" />

            <VerticalStackLayout x:Name="CrashControlsContainer" 
                                 IsVisible="False" 
                                 Spacing="32" 
                                 Margin="0,32,0,0">

                <!-- Countdown Section -->
                <VerticalStackLayout Spacing="8">
                    <Label x:Name="CrashCountdownLabel" 
                           Text="10" 
                           FontSize="80" 
                           FontAttributes="Bold" 
                           TextColor="White" 
                           HorizontalOptions="Center" />

                    <Label Text="Sending emergency alert to group automatically..." 
                           FontSize="15" 
                           TextColor="#FFCDD2" 
                           HorizontalOptions="Center" 
                           HorizontalTextAlignment="Center" 
                           LineHeight="1.2"/>
                </VerticalStackLayout>

                <!-- Action Buttons Section -->
                <VerticalStackLayout Spacing="16">
                    <!-- UPGRADE: Enlarged touch target, added shadow for primary action -->
                    <Button Text="I AM OKAY (CANCEL)" 
                            BackgroundColor="White" 
                            TextColor="#B71C1C" 
                            FontAttributes="Bold" 
                            FontSize="16" 
                            HeightRequest="64" 
                            CornerRadius="32" 
                            Clicked="OnCrashCancelledClicked">
                        <Button.Shadow>
                            <Shadow Brush="Black" Offset="0,4" Radius="8" Opacity="0.25"/>
                        </Button.Shadow>
                    </Button>

                    <Button Text="SEND EMERGENCY NOW" 
                            BackgroundColor="#212121" 
                            TextColor="White" 
                            FontAttributes="Bold" 
                            FontSize="16" 
                            HeightRequest="64" 
                            CornerRadius="32" 
                            Clicked="OnCrashEmergencyClicked"/>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Grid>
</ContentView>