<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SpeedyCompass.Controls.MapPinView"
             x:Name="this"
             InputTransparent="True"
             CascadeInputTransparent="True">

    <!-- THE MAGIC OFFSET: We move the component's center (-50, -75) here 
         so LobbyPage just binds ScreenX/ScreenY directly! -->
    <Grid TranslationX="-50" 
          TranslationY="-75" 
          WidthRequest="100" 
          HorizontalOptions="Center" 
          InputTransparent="True">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Bubble Border -->
        <Border Grid.Row="0" 
                BackgroundColor="#E61E1E1E" 
                Stroke="{Binding PinColor, Source={x:Reference this}}" 
                StrokeThickness="2" 
                StrokeShape="RoundRectangle 10" 
                Padding="8,4" 
                HorizontalOptions="Fill"
                InputTransparent="True">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,4" Opacity="0.3" Radius="5"/>
            </Border.Shadow>

            <VerticalStackLayout Spacing="2" InputTransparent="True">
                <!-- Username -->
                <Label Text="{Binding Username, Source={x:Reference this}}" 
                       TextColor="White" 
                       FontSize="10" 
                       FontAttributes="Bold" 
                       HorizontalOptions="Center" 
                       LineBreakMode="TailTruncation" 
                       MaxLines="1"/>

                <!-- Speed & Battery Row -->
                <StackLayout Orientation="Horizontal" HorizontalOptions="Center" Spacing="8">

                    <!-- Hide both Speed & Battery for the local rider -->
                    <StackLayout.Triggers>
                        <DataTrigger TargetType="StackLayout" 
                                     Binding="{Binding Username, Source={x:Reference this}}" 
                                     Value="You">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </StackLayout.Triggers>

                    <!-- Speed -->
                    <Label Text="{Binding Speed, Source={x:Reference this}}" 
                           TextColor="DodgerBlue" 
                           FontSize="11" 
                           FontAttributes="Bold" 
                           VerticalOptions="Center"/>

                    <!-- Battery Level -->
                    <StackLayout Orientation="Horizontal" Spacing="2" VerticalOptions="Center">
                        <Label Text="battery_full" FontFamily="MaterialSymbols" FontSize="9" TextColor="LightGreen" VerticalOptions="Center"/>
                        <Label Text="{Binding BatteryLevel, Source={x:Reference this}}" 
                               TextColor="LightGreen" 
                               FontSize="10" 
                               FontAttributes="Bold"
                               VerticalOptions="Center"/>
                    </StackLayout>

                </StackLayout>
            </VerticalStackLayout>
        </Border>

        <!-- Tail (referencing local PinColor) -->
        <Path Grid.Row="1" 
              Data="M 0,0 L 12,0 L 6,8 Z" 
              Fill="{Binding PinColor, Source={x:Reference this}}" 
              HorizontalOptions="Center" 
              Margin="0,-2,0,0"/>
    </Grid>
</ContentView>