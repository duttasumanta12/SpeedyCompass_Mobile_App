<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SpeedyCompass.Controls.JoinGroupOverlay"
             IsVisible="False"
             ZIndex="2000">

    <Grid BackgroundColor="#B3000000" InputTransparent="False" Padding="20">
        <Border VerticalOptions="Center" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" Padding="25">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="25"/>
            </Border.StrokeShape>
            <StackLayout Spacing="20">
                <Label Text="Enter Convoy PIN" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center"/>
                <Label Text="Ask the Convoy Admin for the 6-digit access code." FontSize="13" TextColor="Gray" HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="0,-10,0,10"/>

                <Border Stroke="#E0E0E0" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light=#F9F9F9, Dark=#2A2A2A}" Padding="15,0" HeightRequest="60">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="15"/>
                    </Border.StrokeShape>
                    <Entry x:Name="JoinPinEntry" Placeholder="• • • • • •" Keyboard="Numeric" MaxLength="6" FontSize="24" FontAttributes="Bold" HorizontalTextAlignment="Center" BackgroundColor="Transparent" VerticalOptions="Center"/>
                </Border>

                <Grid ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0,15,0,0">
                    <Button Grid.Column="0" Text="Cancel" BackgroundColor="#F0F0F0" TextColor="#333333" FontAttributes="Bold" CornerRadius="12" HeightRequest="50" Clicked="OnCancelClicked"/>
                    <Button Grid.Column="1" Text="Join Ride" BackgroundColor="MediumSeaGreen" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="50" Clicked="OnConfirmClicked"/>
                </Grid>
            </StackLayout>
        </Border>
    </Grid>
</ContentView>