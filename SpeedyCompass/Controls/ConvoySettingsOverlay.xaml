<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SpeedyCompass.Controls.ConvoySettingsOverlay"
             IsVisible="False"
             ZIndex="2500">

    <Grid BackgroundColor="#CC000000" Padding="20">
        <Border Margin="10,40" VerticalOptions="Center" MaximumHeightRequest="700" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" Padding="25">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="25"/>
            </Border.StrokeShape>
            <Grid RowDefinitions="Auto, *, Auto" RowSpacing="15">

                <!-- Dynamic Header -->
                <VerticalStackLayout Grid.Row="0" Spacing="5">
                    <Label x:Name="HeaderTitleLabel" Text="Convoy Settings" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <Label x:Name="HeaderSubtitleLabel" Text="Adjust live telemetry rules." FontSize="13" TextColor="Gray" HorizontalOptions="Center" Margin="0,-5,0,5"/>
                </VerticalStackLayout>

                <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Always">
                    <VerticalStackLayout Spacing="15" Padding="0,5,15,5">

                        <!-- Group Name (Hidden during Edit Mode) -->
                        <StackLayout x:Name="GroupNameContainer" Spacing="5">
                            <Label Text="Convoy Name" FontAttributes="Bold" FontSize="14"/>
                            <Border Stroke="#E0E0E0" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light=#F9F9F9, Dark=#2A2A2A}" Padding="15,0" HeightRequest="50">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <Entry x:Name="GroupNameEntry" Placeholder="e.g. Sunday Morning Canyon" BackgroundColor="Transparent" VerticalOptions="Center"/>
                            </Border>
                        </StackLayout>

                        <!-- Group Size -->
                        <StackLayout Spacing="5">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Max Group Size" FontAttributes="Bold" VerticalOptions="Center"/>
                                <Label x:Name="SizeValueLabel" Grid.Column="1" Text="15 Riders" TextColor="MediumSeaGreen" FontAttributes="Bold"/>
                            </Grid>
                            <Label Text="Cap the total number of allowed riders." FontSize="11" TextColor="Gray"/>
                            <Slider x:Name="SizeSlider" Minimum="2" Maximum="30" Value="15" ValueChanged="OnSizeSliderChanged" MinimumTrackColor="MediumSeaGreen"/>
                        </StackLayout>

                        <!-- Lag Warning -->
                        <StackLayout Spacing="5">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Lag Warning Distance" FontAttributes="Bold" VerticalOptions="Center"/>
                                <Label x:Name="LagValueLabel" Grid.Column="1" Text="500m" TextColor="DodgerBlue" FontAttributes="Bold"/>
                            </Grid>
                            <Label Text="Alerts the Lead if a rider falls this far behind." FontSize="11" TextColor="Gray"/>
                            <Slider x:Name="LagSlider" Minimum="0" Maximum="5000" Value="500" ValueChanged="OnSliderChanged" MinimumTrackColor="DodgerBlue"/>
                        </StackLayout>

                        <!-- NEW: Off-Route Detection Sensitivity -->
                        <!-- Architectural standard: Loose for Highways, Tight for Cities. Crucial standard standard for Perspective #2 users. -->
                        <StackLayout Spacing="5">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Reroute Sensitivity" FontAttributes="Bold" VerticalOptions="Center"/>
                                <Label x:Name="SensitivityValueLabel" Grid.Column="1" Text="200m" TextColor="Orange" FontAttributes="Bold"/>
                            </Grid>
                            <Label Text="Distance standard before app standard says standard standard 'Diverted'. Loose standard allows standard Gmaps variance." FontSize="11" TextColor="Gray"/>
                            <Slider x:Name="SensitivitySlider" Minimum="50" Maximum="1000" Value="200" ValueChanged="OnSliderChanged" MinimumTrackColor="Orange"/>
                        </StackLayout>

                        <!-- Splinter Warning -->
                        <StackLayout Spacing="5">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Splinter Warning" FontAttributes="Bold" VerticalOptions="Center"/>
                                <Label x:Name="SplinterValueLabel" Grid.Column="1" Text="2000m" TextColor="Orange" FontAttributes="Bold"/>
                            </Grid>
                            <Label Text="Alerts if the convoy stretches too far from front to back." FontSize="11" TextColor="Gray"/>
                            <Slider x:Name="SplinterSlider" Minimum="0" Maximum="10000" Value="2000" ValueChanged="OnSliderChanged" MinimumTrackColor="Orange"/>
                        </StackLayout>

                        <!-- Pitstop Reminder -->
                        <StackLayout Spacing="5">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Pitstop Reminder" FontAttributes="Bold" VerticalOptions="Center"/>
                                <Label x:Name="PitstopValueLabel" Grid.Column="1" Text="100 km" TextColor="DodgerBlue" FontAttributes="Bold"/>
                            </Grid>
                            <Label Text="Voice reminder for a rest stop (0 to turn off)." FontSize="11" TextColor="Gray"/>
                            <Slider x:Name="PitstopSlider" Minimum="0" Maximum="300" Value="100" ValueChanged="OnSliderChanged" MinimumTrackColor="DodgerBlue"/>
                        </StackLayout>

                        <!-- Dynamic Routing -->
                        <StackLayout Orientation="Horizontal" Spacing="10" Margin="0,5,0,5">
                            <Switch x:Name="DynamicRoutingSwitch" OnColor="MediumSeaGreen" IsToggled="True" VerticalOptions="Center"/>
                            <StackLayout VerticalOptions="Center">
                                <Label Text="Dynamic Group Routing" FontAttributes="Bold" FontSize="14"/>
                                <Label Text="Sync the Lead's route to the whole group." FontSize="12" TextColor="Gray"/>
                            </StackLayout>
                        </StackLayout>

                        <!-- Divider -->
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E0E0E0, Dark=#333}" Margin="0,10"/>

                        <!-- Broadcast Optimizations (Admin-Enforced Protocol) -->
                        <Label Text="Network Sync Protocol" FontAttributes="Bold" FontSize="16" HorizontalOptions="Center" Margin="0,0,0,10"/>

                        <StackLayout Spacing="5">
                            <Label Text="Convoy Tracking Protocol" FontAttributes="Bold" VerticalOptions="Center"/>
                            <Label Text="Dictates network aggressiveness for all riders." FontSize="11" TextColor="Gray"/>
                            <Border StrokeThickness="1" Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#1E1E1E}" HeightRequest="40">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8"/>
                                </Border.StrokeShape>
                                <Picker x:Name="ProtocolPicker" Title="Select Protocol" FontSize="13">
                                    <Picker.Items>
                                        <x:String>City / Tight Formations (Aggressive)</x:String>
                                        <x:String>Highway / Long Haul (Optimized)</x:String>
                                    </Picker.Items>
                                </Picker>
                            </Border>
                        </StackLayout>

                        <StackLayout Spacing="5">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Min Broadcast Distance" FontAttributes="Bold" FontSize="14"/>
                                <Label x:Name="MinUpdateValueLabel" Grid.Column="1" Text="10m" FontAttributes="Bold" TextColor="DodgerBlue"/>
                            </Grid>
                            <Label Text="Low standard speed standard updates standard (City standard driving). Higher standard value saves battery room-wide." FontSize="11" TextColor="Gray"/>
                            <Slider x:Name="MinUpdateSlider" Minimum="5" Maximum="50" Value="10" MinimumTrackColor="DodgerBlue" ValueChanged="OnSliderChanged"/>
                        </StackLayout>

                        <StackLayout Spacing="5">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Max Broadcast Distance" FontAttributes="Bold" FontSize="14"/>
                                <Label x:Name="MaxUpdateValueLabel" Grid.Column="1" Text="100m" FontAttributes="Bold" TextColor="DodgerBlue"/>
                            </Grid>
                            <Label Text="High standard speed standard updates standard (Highway standard driving)." FontSize="11" TextColor="Gray"/>
                            <Slider x:Name="MaxUpdateSlider" Minimum="50" Maximum="500" Value="100" MinimumTrackColor="DodgerBlue" ValueChanged="OnSliderChanged"/>
                        </StackLayout>

                    </VerticalStackLayout>
                </ScrollView>

                <!-- Dynamic Buttons -->
                <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="15">
                    <Button Grid.Column="0" Text="Cancel" BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#333}" TextColor="{AppThemeBinding Light=#333, Dark=White}" FontAttributes="Bold" CornerRadius="12" HeightRequest="50" Clicked="OnCancelClicked"/>
                    <Button x:Name="SubmitButton" Grid.Column="1" Text="Generate PIN" BackgroundColor="DarkOrange" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="50" Clicked="OnSubmitClicked"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ContentView>