<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SpeedyCompass.Controls.ConvoySettingsOverlay"
             IsVisible="False"
             ZIndex="2500">

    <!-- Deep dark background to focus attention on the modal -->
    <Grid BackgroundColor="#CC121212" Padding="16">

        <Border Margin="0,40" 
                VerticalOptions="Center" 
                MaximumHeightRequest="750" 
                StrokeThickness="1" 
                Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" 
                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" 
                Padding="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,10" Opacity="0.3" Radius="20"/>
            </Border.Shadow>

            <Grid RowDefinitions="Auto, *, Auto">

                <!-- ========================================== -->
                <!-- HEADER                                     -->
                <!-- ========================================== -->
                <VerticalStackLayout Grid.Row="0" Spacing="4" Padding="24,24,24,16" BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#1A1A1A}">
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                        <Label Text="admin_panel_settings" FontFamily="MaterialSymbols" FontSize="26" TextColor="{AppThemeBinding Light=#212121, Dark=White}" VerticalOptions="Center"/>
                        <Label x:Name="HeaderTitleLabel" Text="Convoy Settings" FontSize="20" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#212121, Dark=White}" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <Label x:Name="HeaderSubtitleLabel" Text="Adjust live telemetry rules and group limits." FontSize="13" TextColor="#757575" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Divider -->
                <BoxView Grid.Row="0" VerticalOptions="End" HeightRequest="1" Color="{AppThemeBinding Light=#EEEEEE, Dark=#2A2A2A}"/>

                <!-- ========================================== -->
                <!-- SCROLLABLE SETTINGS CONTENT                -->
                <!-- ========================================== -->
                <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
                    <VerticalStackLayout Spacing="24" Padding="24">

                        <!-- GROUP NAME -->
                        <VerticalStackLayout x:Name="GroupNameContainer" Spacing="8">
                            <Label Text="Convoy Name" FontAttributes="Bold" FontSize="14" TextColor="{AppThemeBinding Light=#212121, Dark=White}"/>
                            <Border Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#252525}" Padding="16,0" HeightRequest="52">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <Entry x:Name="GroupNameEntry" Placeholder="e.g. Sunday Morning Canyon" TextColor="{AppThemeBinding Light=#212121, Dark=White}" BackgroundColor="Transparent" VerticalOptions="Center"/>
                            </Border>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#EEEEEE, Dark=#2A2A2A}" />

                        <!-- GROUP SIZE -->
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="16">
                            <Label Grid.Column="0" Text="groups" FontFamily="MaterialSymbols" FontSize="24" TextColor="#00E676" VerticalOptions="Start" Margin="0,2,0,0"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Max Group Size" FontAttributes="Bold" FontSize="15" TextColor="{AppThemeBinding Light=#212121, Dark=White}" VerticalOptions="Center"/>
                                    <Label x:Name="SizeValueLabel" Grid.Column="1" Text="15 Riders" TextColor="#00E676" FontAttributes="Bold"/>
                                </Grid>
                                <Label Text="Cap the total number of allowed riders in this group." FontSize="13" TextColor="#757575"/>
                                <Slider x:Name="SizeSlider" Minimum="2" Maximum="30" Value="15" ValueChanged="OnSizeSliderChanged" MinimumTrackColor="#00E676" Margin="0,4,0,0"/>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- LAG WARNING -->
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="16">
                            <Label Grid.Column="0" Text="social_distance" FontFamily="MaterialSymbols" FontSize="24" TextColor="#1E88E5" VerticalOptions="Start" Margin="0,2,0,0"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Lag Warning Distance" FontAttributes="Bold" FontSize="15" TextColor="{AppThemeBinding Light=#212121, Dark=White}" VerticalOptions="Center"/>
                                    <Label x:Name="LagValueLabel" Grid.Column="1" Text="500m" TextColor="#1E88E5" FontAttributes="Bold"/>
                                </Grid>
                                <Label Text="Alerts the Lead rider if someone falls this far behind." FontSize="13" TextColor="#757575"/>
                                <Slider x:Name="LagSlider" Minimum="0" Maximum="5000" Value="500" ValueChanged="OnSliderChanged" MinimumTrackColor="#1E88E5" Margin="0,4,0,0"/>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- REROUTE SENSITIVITY -->
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="16">
                            <Label Grid.Column="0" Text="alt_route" FontFamily="MaterialSymbols" FontSize="24" TextColor="#FB8C00" VerticalOptions="Start" Margin="0,2,0,0"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Reroute Sensitivity" FontAttributes="Bold" FontSize="15" TextColor="{AppThemeBinding Light=#212121, Dark=White}" VerticalOptions="Center"/>
                                    <Label x:Name="SensitivityValueLabel" Grid.Column="1" Text="200m" TextColor="#FB8C00" FontAttributes="Bold"/>
                                </Grid>
                                <Label Text="Distance threshold before the app declares a rider 'Off Route'. A loose setting allows for slight GPS variance." FontSize="13" TextColor="#757575" LineHeight="1.2"/>
                                <Slider x:Name="SensitivitySlider" Minimum="50" Maximum="1000" Value="200" ValueChanged="OnSliderChanged" MinimumTrackColor="#FB8C00" Margin="0,4,0,0"/>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- SPLINTER WARNING -->
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="16">
                            <Label Grid.Column="0" Text="linear_scale" FontFamily="MaterialSymbols" FontSize="24" TextColor="#FB8C00" VerticalOptions="Start" Margin="0,2,0,0"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Splinter Warning" FontAttributes="Bold" FontSize="15" TextColor="{AppThemeBinding Light=#212121, Dark=White}" VerticalOptions="Center"/>
                                    <Label x:Name="SplinterValueLabel" Grid.Column="1" Text="2000m" TextColor="#FB8C00" FontAttributes="Bold"/>
                                </Grid>
                                <Label Text="Alerts the group if the convoy stretches too far from the Lead rider to the Sweep rider." FontSize="13" TextColor="#757575" LineHeight="1.2"/>
                                <Slider x:Name="SplinterSlider" Minimum="0" Maximum="10000" Value="2000" ValueChanged="OnSliderChanged" MinimumTrackColor="#FB8C00" Margin="0,4,0,0"/>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- PITSTOP REMINDER -->
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="16">
                            <Label Grid.Column="0" Text="local_cafe" FontFamily="MaterialSymbols" FontSize="24" TextColor="#1E88E5" VerticalOptions="Start" Margin="0,2,0,0"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Pitstop Reminder" FontAttributes="Bold" FontSize="15" TextColor="{AppThemeBinding Light=#212121, Dark=White}" VerticalOptions="Center"/>
                                    <Label x:Name="PitstopValueLabel" Grid.Column="1" Text="100 km" TextColor="#1E88E5" FontAttributes="Bold"/>
                                </Grid>
                                <Label Text="Automated voice reminder for a rest stop. Set to 0 to turn off." FontSize="13" TextColor="#757575"/>
                                <Slider x:Name="PitstopSlider" Minimum="0" Maximum="300" Value="100" ValueChanged="OnSliderChanged" MinimumTrackColor="#1E88E5" Margin="0,4,0,0"/>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- DYNAMIC ROUTING -->
                        <Border StrokeThickness="1" Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#252525}" Padding="16">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="16">
                                <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="sync_alt" FontFamily="MaterialSymbols" FontSize="20" TextColor="#00E676" VerticalOptions="Center"/>
                                        <Label Text="Dynamic Group Routing" FontAttributes="Bold" FontSize="15" TextColor="{AppThemeBinding Light=#212121, Dark=White}" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                    <Label Text="Automatically synchronize the Lead rider's route and waypoints to the entire group." FontSize="13" TextColor="#757575" LineHeight="1.2"/>
                                </VerticalStackLayout>
                                <Switch x:Name="DynamicRoutingSwitch" Grid.Column="1" OnColor="#00E676" IsToggled="True" VerticalOptions="Center"/>
                            </Grid>
                        </Border>

                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#EEEEEE, Dark=#2A2A2A}" />

                        <!-- ========================================== -->
                        <!-- NETWORK PROTOCOL                           -->
                        <!-- ========================================== -->
                        <VerticalStackLayout Spacing="16">
                            <Label Text="NETWORK SYNC PROTOCOL" FontAttributes="Bold" FontSize="12" TextColor="#9E9E9E" CharacterSpacing="1"/>

                            <!-- Protocol Picker -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Convoy Tracking Protocol" FontAttributes="Bold" FontSize="15" TextColor="{AppThemeBinding Light=#212121, Dark=White}"/>
                                <Label Text="Dictates network aggressiveness for all riders. City driving requires faster updates." FontSize="13" TextColor="#757575"/>
                                <Border StrokeThickness="1" Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#252525}" HeightRequest="48" Margin="0,4,0,0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12"/>
                                    </Border.StrokeShape>
                                    <Picker x:Name="ProtocolPicker" Title="Select Protocol" FontSize="14" TextColor="{AppThemeBinding Light=#212121, Dark=White}" Margin="8,0">
                                        <Picker.Items>
                                            <x:String>City / Tight Formations (Aggressive)</x:String>
                                            <x:String>Highway / Long Haul (Optimized)</x:String>
                                        </Picker.Items>
                                    </Picker>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Min Distance -->
                            <VerticalStackLayout Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Min Broadcast Distance" FontAttributes="Bold" FontSize="14" TextColor="{AppThemeBinding Light=#424242, Dark=#E0E0E0}"/>
                                    <Label x:Name="MinUpdateValueLabel" Grid.Column="1" Text="10m" FontAttributes="Bold" TextColor="#1E88E5"/>
                                </Grid>
                                <Label Text="Frequent updates at low speeds. Higher values conserve battery group-wide." FontSize="12" TextColor="#757575"/>
                                <Slider x:Name="MinUpdateSlider" Minimum="5" Maximum="50" Value="10" MinimumTrackColor="#1E88E5" ValueChanged="OnSliderChanged"/>
                            </VerticalStackLayout>

                            <!-- Max Distance -->
                            <VerticalStackLayout Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Max Broadcast Distance" FontAttributes="Bold" FontSize="14" TextColor="{AppThemeBinding Light=#424242, Dark=#E0E0E0}"/>
                                    <Label x:Name="MaxUpdateValueLabel" Grid.Column="1" Text="100m" FontAttributes="Bold" TextColor="#1E88E5"/>
                                </Grid>
                                <Label Text="Distance threshold for guaranteed location updates at high speeds (Highway driving)." FontSize="12" TextColor="#757575"/>
                                <Slider x:Name="MaxUpdateSlider" Minimum="50" Maximum="500" Value="100" MinimumTrackColor="#1E88E5" ValueChanged="OnSliderChanged"/>
                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>

                <!-- Divider -->
                <BoxView Grid.Row="1" VerticalOptions="End" HeightRequest="1" Color="{AppThemeBinding Light=#EEEEEE, Dark=#2A2A2A}"/>

                <!-- ========================================== -->
                <!-- BOTTOM ACTIONS                             -->
                <!-- ========================================== -->
                <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="16" Padding="24" BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#1A1A1A}">
                    <Button Grid.Column="0" 
                            Text="CANCEL" 
                            BackgroundColor="{AppThemeBinding Light=#EEEEEE, Dark=#333333}" 
                            TextColor="{AppThemeBinding Light=#424242, Dark=White}" 
                            FontAttributes="Bold" 
                            FontSize="14"
                            CharacterSpacing="1"
                            CornerRadius="24" 
                            HeightRequest="52" 
                            Clicked="OnCancelClicked"/>

                    <!-- Primary Call to Action -->
                    <Button x:Name="SubmitButton" 
                            Grid.Column="1" 
                            Text="GENERATE PIN" 
                            BackgroundColor="#FB8C00" 
                            TextColor="White" 
                            FontAttributes="Bold" 
                            FontSize="14"
                            CharacterSpacing="1"
                            CornerRadius="24" 
                            HeightRequest="52" 
                            Clicked="OnSubmitClicked">
                        <Button.Shadow>
                            <Shadow Brush="#FB8C00" Offset="0,4" Opacity="0.3" Radius="8"/>
                        </Button.Shadow>
                    </Button>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</ContentView>