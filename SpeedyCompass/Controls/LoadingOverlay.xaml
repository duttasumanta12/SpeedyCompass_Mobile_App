<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SpeedyCompass.Controls.LoadingOverlay"
             x:Name="thisControl"
             IsVisible="False">

    <!-- Semi-transparent background blocking touches -->
    <Grid BackgroundColor="#CC1E1E1E" InputTransparent="False">
        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="15">
            <ActivityIndicator IsRunning="True" Color="DodgerBlue" HorizontalOptions="Center" WidthRequest="50" HeightRequest="50"/>
            <Label Text="{Binding Message, Source={x:Reference thisControl}}" 
                   TextColor="White" 
                   FontSize="16" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center"/>
        </VerticalStackLayout>
    </Grid>
</ContentView>