<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SpeedyCompass.Controls.DestinationSearchView"
             x:Name="thisControl">

    <!-- UPGRADE: Centralized Z-Index overlay structure -->
    <Grid VerticalOptions="Start" ZIndex="20">

        <!-- ========================================== -->
        <!-- 1. THE INSTRUCTION BANNER (Background)     -->
        <!-- ========================================== -->
        <!-- UPGRADE: Added 'info' icon and softened the black background for a modern blur effect -->
        <Border x:Name="InstructionBanner" 
                VerticalOptions="Start" 
                HorizontalOptions="Center" 
                Margin="16,88,16,0" 
                Padding="16,12" 
                StrokeThickness="0" 
                BackgroundColor="#CC000000" 
                ZIndex="10">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20"/>
            </Border.StrokeShape>
            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                <Label Text="info" FontFamily="MaterialSymbols" FontSize="18" TextColor="#90CAF9" VerticalOptions="Center"/>
                <Label Text="Search above to set the Convoy destination" TextColor="White" FontAttributes="Bold" FontSize="13" VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </Border>

        <!-- ========================================== -->
        <!-- 2. SEARCH UI & AUTOCOMPLETE OVERLAY        -->
        <!-- ========================================== -->
        <VerticalStackLayout Margin="16,16,16,0" Spacing="8" ZIndex="30">

            <!-- Search Bar & Confirm Button -->
            <Grid x:Name="SearchUIGrid" ColumnDefinitions="*, Auto" ColumnSpacing="12">

                <Border Grid.Column="0" Padding="0" StrokeThickness="1" Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="28"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,4" Opacity="0.1" Radius="8"/>
                    </Border.Shadow>

                    <SearchBar x:Name="DestinationSearchBar" 
                               TextChanged="OnSearchTextChanged" 
                               Placeholder="Search destination..." 
                               SearchButtonPressed="OnSearchPressed" 
                               BackgroundColor="Transparent" 
                               TextColor="{AppThemeBinding Light=#212121, Dark=White}"
                               CancelButtonColor="#9E9E9E"/>
                </Border>

                <!-- UPGRADE: Replaced emoji with Material Symbol checkmark -->
                <Button x:Name="ConfirmDestButton" 
                        Grid.Column="1" 
                        Text="check" 
                        FontFamily="MaterialSymbols"
                        FontSize="24"
                        Clicked="OnConfirmDestinationClicked" 
                        WidthRequest="56" 
                        HeightRequest="56" 
                        CornerRadius="28" 
                        BackgroundColor="#00E676" 
                        TextColor="#1B5E20" 
                        FontAttributes="Bold" 
                        IsEnabled="False" 
                        VerticalOptions="Center">
                    <Button.Shadow>
                        <Shadow Brush="#00E676" Offset="0,4" Opacity="0.3" Radius="8"/>
                    </Button.Shadow>
                </Button>
            </Grid>

            <!-- Suggestions Dropdown Frame -->
            <!-- UPGRADE: Removed ListView, implemented CollectionView for smoother autocomplete scrolling -->
            <Border x:Name="SuggestionsFrame" 
                    IsVisible="False" 
                    Padding="0" 
                    StrokeThickness="1" 
                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" 
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,6" Opacity="0.15" Radius="12"/>
                </Border.Shadow>

                <!-- NOTE: Update your C# code behind from 'ItemSelected' to 'SelectionChanged' -->
                <CollectionView x:Name="SuggestionsListView" 
                                SelectionMode="Single" 
                                SelectionChanged="OnSuggestionSelected" 
                                MaximumHeightRequest="260">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <!-- VisualState manager handles tap highlighting for CollectionView items naturally -->
                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12" Padding="16,14">

                                <!-- UPGRADE: Added map pin icon to autocomplete results -->
                                <Label Grid.Column="0" 
                                       Text="location_on" 
                                       FontFamily="MaterialSymbols" 
                                       FontSize="20" 
                                       TextColor="#9E9E9E" 
                                       VerticalOptions="Center"/>

                                <Label Grid.Column="1" 
                                       Text="{Binding Description}" 
                                       TextColor="{AppThemeBinding Light=#212121, Dark=#E0E0E0}" 
                                       FontSize="15" 
                                       LineBreakMode="TailTruncation"
                                       VerticalOptions="Center"/>

                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>

        </VerticalStackLayout>
    </Grid>
</ContentView>