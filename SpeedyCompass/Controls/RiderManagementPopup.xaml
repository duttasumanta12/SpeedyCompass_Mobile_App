<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SpeedyCompass.Controls.RiderManagementOverlay"
             x:Name="thisControl"
             IsVisible="False"
             ZIndex="999">

    <!-- Dark transparent background overlay -->
    <Grid BackgroundColor="#80000000">
        <Grid.GestureRecognizers>
            <!-- Tapping the background cancels/closes the menu -->
            <TapGestureRecognizer Tapped="OnCancelTapped" />
        </Grid.GestureRecognizers>

        <!-- The Menu Card -->
        <Border WidthRequest="300" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" StrokeThickness="0" VerticalOptions="Center" HorizontalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,10" Opacity="0.3" Radius="20"/>
            </Border.Shadow>

            <VerticalStackLayout Spacing="0" Padding="10,15">

                <!-- Header -->
                <Label x:Name="TitleLabel" Text="Manage Rider" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,0,0,15" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>

                <!-- Visibility Toggle -->
                <Grid x:Name="VisibilityRow" Padding="20,15" ColumnDefinitions="Auto, *">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnActionTapped" CommandParameter="ToggleVisibility" />
                    </Grid.GestureRecognizers>
                    <Label x:Name="VisibilityIcon" Grid.Column="0" FontFamily="MaterialSymbols" Text="visibility_off" FontSize="24" VerticalOptions="Center" Margin="0,0,15,0" TextColor="{AppThemeBinding Light=#444, Dark=#CCC}"/>
                    <Label x:Name="VisibilityLabel" Grid.Column="1" Text="Hide from Map" FontSize="16" VerticalOptions="Center" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                </Grid>

                <!-- Admin Options -->
                <VerticalStackLayout x:Name="AdminOptionsLayout" Spacing="0">
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#EEEEEE, Dark=#333333}" Margin="10,5"/>

                    <Grid Padding="20,15" ColumnDefinitions="Auto, *">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnActionTapped" CommandParameter="View Emergency Info" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0" FontFamily="MaterialSymbols" Text="medical_services" FontSize="24" TextColor="#D32F2F" VerticalOptions="Center" Margin="0,0,15,0"/>
                        <Label Grid.Column="1" Text="Emergency Info" FontSize="16" VerticalOptions="Center" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                    </Grid>

                    <Grid Padding="20,15" ColumnDefinitions="Auto, *">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnActionTapped" CommandParameter="Lead" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0" FontFamily="MaterialSymbols" Text="sports_motorsports" FontSize="24" TextColor="DodgerBlue" VerticalOptions="Center" Margin="0,0,15,0"/>
                        <Label Grid.Column="1" Text="Promote to Lead" FontSize="16" VerticalOptions="Center" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                    </Grid>

                    <Grid Padding="20,15" ColumnDefinitions="Auto, *">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnActionTapped" CommandParameter="Tail" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0" FontFamily="MaterialSymbols" Text="security" FontSize="24" TextColor="Orange" VerticalOptions="Center" Margin="0,0,15,0"/>
                        <Label Grid.Column="1" Text="Assign as Tail" FontSize="16" VerticalOptions="Center" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                    </Grid>

                    <Grid Padding="20,15" ColumnDefinitions="Auto, *">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnActionTapped" CommandParameter="Marshal" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0" FontFamily="MaterialSymbols" Text="local_police" FontSize="24" TextColor="MediumPurple" VerticalOptions="Center" Margin="0,0,15,0"/>
                        <Label Grid.Column="1" Text="Assign as Marshal" FontSize="16" VerticalOptions="Center" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                    </Grid>

                    <Grid Padding="20,15" ColumnDefinitions="Auto, *">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnActionTapped" CommandParameter="Standard Rider" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0" FontFamily="MaterialSymbols" Text="person" FontSize="24" TextColor="Gray" VerticalOptions="Center" Margin="0,0,15,0"/>
                        <Label Grid.Column="1" Text="Standard Rider" FontSize="16" VerticalOptions="Center" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                    </Grid>
                </VerticalStackLayout>

                <!-- Cancel Button -->
                <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#EEEEEE, Dark=#333333}" Margin="10,5"/>
                <Grid Padding="20,15" ColumnDefinitions="Auto, *">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCancelTapped" />
                    </Grid.GestureRecognizers>
                    <Label Grid.Column="0" FontFamily="MaterialSymbols" Text="close" FontSize="24" TextColor="Gray" VerticalOptions="Center" Margin="0,0,15,0"/>
                    <Label Grid.Column="1" Text="Cancel" FontSize="16" FontAttributes="Bold" TextColor="Gray" VerticalOptions="Center"/>
                </Grid>

            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>