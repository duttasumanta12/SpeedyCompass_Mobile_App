<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SpeedyCompass.MainPage"
             Title="SpeedyCompass Dashboard">

    <Grid>
        <!-- 1. GOOGLE LOGIN VIEW (Visible when not logged in) -->
        <Grid x:Name="LoginView" BackgroundColor="{AppThemeBinding Light=White, Dark=#121212}" IsVisible="True" Padding="30">
            <StackLayout VerticalOptions="Center" Spacing="20">
                <Image Source="compass_logo.png" WidthRequest="150" HeightRequest="150" HorizontalOptions="Center"/>
                <Label Text="SpeedyCompass" FontSize="32" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                <Label Text="Ride together, never get lost." FontSize="16" TextColor="Gray" HorizontalTextAlignment="Center" Margin="0,0,0,30"/>

                <Button Text="Sign in with Google" 
                        BackgroundColor="White" 
                        TextColor="Black" 
                        BorderColor="LightGray" 
                        BorderWidth="1"
                        CornerRadius="8" 
                        HeightRequest="50" 
                        FontAttributes="Bold"
                        Clicked="OnGoogleLoginClicked"
                        Shadow="{Shadow Brush=Black, Offset='0,2', Opacity=0.1, Radius=4}"/>
            </StackLayout>
        </Grid>

        <!-- 2. MAIN DASHBOARD VIEW (Visible when logged in) -->
        <Grid x:Name="DashboardView" IsVisible="False" RowDefinitions="Auto, Auto, *" Padding="20">

            <!-- User Profile Header -->
            <Frame Grid.Row="0" CornerRadius="12" Padding="15" Margin="0,0,0,20" BackgroundColor="{AppThemeBinding Light=#F0F8FF, Dark=#1E2A38}" HasShadow="False" BorderColor="Transparent">
                <StackLayout>
                    <Label Text="Welcome back," FontSize="14" TextColor="Gray"/>
                    <Grid ColumnDefinitions="*, Auto">
                        <Entry x:Name="UsernameEntry" Grid.Column="0" FontSize="22" FontAttributes="Bold" TextColor="DodgerBlue" BackgroundColor="Transparent" ClearButtonVisibility="WhileEditing"/>
                        <Button Grid.Column="1" Text="Save" Clicked="OnSaveUsernameClicked" HeightRequest="35" CornerRadius="6" BackgroundColor="MediumSeaGreen" TextColor="White" Padding="10,0"/>
                    </Grid>
                </StackLayout>
            </Frame>

            <!-- Create Group Controls -->
            <StackLayout Grid.Row="1" Spacing="10" Margin="0,0,0,20">
                <Label Text="Create or Join a Group" FontAttributes="Bold" FontSize="18"/>
                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                    <Entry x:Name="GroupNameEntry" Placeholder="Enter Group Name" BackgroundColor="{AppThemeBinding Light=#F9F9F9, Dark=#2A2A2A}"/>
                    <Button Grid.Column="1" Text="Create" BackgroundColor="DodgerBlue" TextColor="White" CornerRadius="8" Clicked="OnCreateGroupClicked"/>
                </Grid>
            </StackLayout>

            <!-- Available Groups List -->
            <RefreshView Grid.Row="2" x:Name="GroupsRefreshView" Refreshing="OnRefreshGroups">
                <CollectionView x:Name="GroupsCollectionView">
                    <CollectionView.EmptyView>
                        <Label Text="No active groups found. Pull to refresh." HorizontalTextAlignment="Center" TextColor="Gray" Margin="0,50,0,0"/>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame CornerRadius="8" HasShadow="True" Padding="15" Margin="0,0,0,10" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                                <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, Auto">
                                    <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                        <Label Text="{Binding GroupName}" FontSize="18" FontAttributes="Bold"/>
                                        <Label Text="👑" IsVisible="{Binding IsMyAdmin}" VerticalOptions="Center" ToolTipProperties.Text="You created this group"/>
                                    </StackLayout>

                                    <Label Grid.Row="1" Grid.Column="0" Text="{Binding MemberCountDisplay}" FontSize="14" TextColor="Gray" Margin="0,5,0,0"/>

                                    <StackLayout Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalOptions="Center">
                                        <!-- Only Admin can delete -->
                                        <Button Text="✖" BackgroundColor="Red" TextColor="White" CornerRadius="20" WidthRequest="40" HeightRequest="40" IsVisible="{Binding IsMyAdmin}" Clicked="OnDeleteGroupClicked" CommandParameter="{Binding GroupName}"/>
                                        <!-- Dynamic Join/Enter button (Disabled if full) -->
                                        <Button Text="{Binding JoinButtonText}" BackgroundColor="MediumSeaGreen" TextColor="White" CornerRadius="8" Clicked="OnJoinGroupClicked" CommandParameter="{Binding GroupName}" IsEnabled="{Binding CanJoin}"/>
                                    </StackLayout>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

        </Grid>
    </Grid>
</ContentPage>