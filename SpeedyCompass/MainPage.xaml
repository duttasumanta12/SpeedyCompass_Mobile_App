<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SpeedyCompass.MainPage"
             BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#121212}">

    <Grid>
        <!-- ========================================== -->
        <!-- 1. LOGIN VIEW                              -->
        <!-- ========================================== -->
        <VerticalStackLayout x:Name="LoginView" VerticalOptions="Center" HorizontalOptions="Center" Spacing="25" Padding="30">
            <Image Source="appicon.png" WidthRequest="100" HeightRequest="100" HorizontalOptions="Center"/>
            <Label Text="SpeedyCompass" FontSize="32" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#0066CC"/>
            <Label Text="Ride together. Stay connected." FontSize="16" TextColor="Gray" HorizontalOptions="Center" Margin="0,-15,0,20"/>
            <Button Text="Authenticate to Ride" BackgroundColor="#0066CC" TextColor="White" CornerRadius="25" HeightRequest="55" FontAttributes="Bold" Clicked="OnAzureLoginClicked">
                <Button.Shadow>
                    <Shadow Brush="#0066CC" Offset="0,8" Opacity="0.4" Radius="15"/>
                </Button.Shadow>
            </Button>
        </VerticalStackLayout>

        <!-- ========================================== -->
        <!-- 2. DASHBOARD VIEW                          -->
        <!-- ========================================== -->
        <Grid x:Name="DashboardView" IsVisible="False" RowDefinitions="Auto, Auto, *">

            <!-- MODERN HEADER -->
            <Border Grid.Row="0" StrokeThickness="0" Margin="0,0,0,15">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0066CC" Offset="0.0" />
                        <GradientStop Color="#003399" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0,0,30,30"/>
                </Border.StrokeShape>

                <Grid ColumnDefinitions="*, Auto" Padding="25,50,25,30">
                    <StackLayout Grid.Column="0" Spacing="0" VerticalOptions="Center">
                        <Label Text="Welcome back," TextColor="#AADDFF" FontSize="14" FontAttributes="Bold"/>
                        <Label x:Name="WelcomeNameLabel" Text="Rider" TextColor="White" FontSize="28" FontAttributes="Bold" LineBreakMode="TailTruncation"/>
                    </StackLayout>

                    <Button Grid.Column="1" Text="⚙ Profile" BackgroundColor="#33FFFFFF" TextColor="White" FontAttributes="Bold" CornerRadius="20" HeightRequest="45" Padding="15,0" Clicked="OnOpenProfileClicked" VerticalOptions="Center"/>
                </Grid>
            </Border>

            <!-- FLOATING CREATE ACTION -->
            <Border Grid.Row="1" Margin="20,-35,20,10" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" StrokeThickness="0" Padding="5">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,10" Opacity="0.1" Radius="20"/>
                </Border.Shadow>

                <Grid ColumnDefinitions="*, Auto" Padding="15,10">
                    <StackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                        <Label Text="Start a new Convoy" FontAttributes="Bold" FontSize="16" TextColor="{AppThemeBinding Light=#333333, Dark=White}"/>
                        <Label Text="Generate a secure PIN for your riders" FontSize="12" TextColor="Gray"/>
                    </StackLayout>
                    <Button Grid.Column="1" Text="+" FontSize="24" BackgroundColor="#FF8C00" TextColor="White" CornerRadius="25" WidthRequest="50" HeightRequest="50" FontAttributes="Bold" Clicked="OnOpenCreateGroupModalClicked">
                        <Button.Shadow>
                            <Shadow Brush="#FF8C00" Offset="0,5" Opacity="0.4" Radius="10"/>
                        </Button.Shadow>
                    </Button>
                </Grid>
            </Border>

            <!-- ACTIVE GROUPS LIST -->
            <RefreshView x:Name="GroupsRefreshView" Grid.Row="2" Refreshing="OnRefreshGroups" Margin="0,10,0,0">
                <CollectionView x:Name="GroupsCollectionView">
                    <CollectionView.Header>
                        <Label Text="Active Convoys" FontSize="18" FontAttributes="Bold" Margin="25,10,0,15" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                    </CollectionView.Header>
                    <CollectionView.EmptyView>
                        <StackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10" Margin="0,50,0,0">
                            <Label Text="🏍️" FontSize="48" HorizontalOptions="Center" Opacity="0.5"/>
                            <Label Text="No active convoys right now." TextColor="Gray" HorizontalOptions="Center"/>
                        </StackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="20,0,20,15" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=White, Dark=#252525}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16"/>
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="Black" Offset="0,4" Opacity="0.05" Radius="10"/>
                                </Border.Shadow>

                                <Grid ColumnDefinitions="Auto, *, Auto" Padding="15">
                                    <!-- Icon -->
                                    <Frame Grid.Column="0" BackgroundColor="#E6F2FF" CornerRadius="12" WidthRequest="50" HeightRequest="50" HasShadow="False" BorderColor="Transparent" Padding="0" Margin="0,0,15,0" VerticalOptions="Center">
                                        <Label Text="📍" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Frame>

                                    <!-- Info -->
                                    <StackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding GroupName}" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333333, Dark=White}"/>
                                        <Label Text="{Binding MemberCountDisplay}" FontSize="13" TextColor="Gray"/>
                                        <Label Text="You are the Admin" FontSize="11" TextColor="DarkOrange" FontAttributes="Bold" IsVisible="{Binding IsMyAdmin}"/>
                                    </StackLayout>

                                    <!-- Actions -->
                                    <StackLayout Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalOptions="Center">
                                        <Button Text="✖" BackgroundColor="#FFF0F0" TextColor="#CC0000" CornerRadius="10" WidthRequest="45" HeightRequest="40" FontAttributes="Bold" IsVisible="{Binding IsMyAdmin}" Clicked="OnDeleteGroupClicked" CommandParameter="{Binding GroupName}"/>

                                        <Button Text="{Binding JoinButtonText}" BackgroundColor="{Binding JoinButtonColor}" TextColor="White" CornerRadius="10" WidthRequest="80" HeightRequest="40" FontAttributes="Bold" Clicked="OnJoinGroupClicked" CommandParameter="{Binding .}" IsEnabled="{Binding CanJoin}">
                                            <Button.Shadow>
                                                <Shadow Brush="{Binding JoinButtonColor}" Offset="0,4" Opacity="0.3" Radius="8"/>
                                            </Button.Shadow>
                                        </Button>
                                    </StackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </Grid>

        <!-- ========================================== -->
        <!-- 3. CREATE GROUP CONFIG MODAL               -->
        <!-- ========================================== -->
        <Grid x:Name="CreateGroupModalOverlay" BackgroundColor="#B3000000" IsVisible="False" InputTransparent="False" ZIndex="2000" Padding="20">
            <Border VerticalOptions="Center" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" Padding="25">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="25"/>
                </Border.StrokeShape>
                <ScrollView>
                    <StackLayout Spacing="20">
                        <Label Text="Configure Convoy" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center"/>
                        <Label Text="Set up the safety parameters for this ride." FontSize="13" TextColor="Gray" HorizontalOptions="Center" Margin="0,-10,0,10"/>

                        <!-- Group Name -->
                        <StackLayout Spacing="5">
                            <Label Text="Convoy Name" FontAttributes="Bold" FontSize="14"/>
                            <Border Stroke="#E0E0E0" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light=#F9F9F9, Dark=#2A2A2A}" Padding="15,0" HeightRequest="50">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <Entry x:Name="NewGroupNameEntry" Placeholder="e.g. Sunday Morning Canyon" BackgroundColor="Transparent" VerticalOptions="Center"/>
                            </Border>
                        </StackLayout>

                        <!-- Group Size -->
                        <StackLayout Spacing="5">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Max Group Size" FontAttributes="Bold" FontSize="14"/>
                                <Label x:Name="CreateSizeLabel" Grid.Column="1" Text="10 Riders" FontAttributes="Bold" TextColor="DodgerBlue"/>
                            </Grid>
                            <Slider x:Name="CreateSizeSlider" Minimum="2" Maximum="30" Value="10" MinimumTrackColor="DodgerBlue" ValueChanged="OnCreateSizeSliderChanged"/>
                        </StackLayout>

                        <!-- Lag Warning -->
                        <StackLayout Spacing="5">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Lag Warning Distance" FontAttributes="Bold" FontSize="14"/>
                                <Label x:Name="CreateLagLabel" Grid.Column="1" Text="500m" FontAttributes="Bold" TextColor="DodgerBlue"/>
                            </Grid>
                            <Slider x:Name="CreateLagSlider" Minimum="0" Maximum="2000" Value="500" MinimumTrackColor="DodgerBlue" ValueChanged="OnCreateLagSliderChanged"/>
                            <Label Text="Alerts the Admin if a rider falls behind this distance." FontSize="11" TextColor="Gray"/>
                        </StackLayout>

                        <!-- Splinter Warning -->
                        <StackLayout Spacing="5">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Splinter Warning" FontAttributes="Bold" FontSize="14"/>
                                <Label x:Name="CreateSplinterLabel" Grid.Column="1" Text="2000m" FontAttributes="Bold" TextColor="DodgerBlue"/>
                            </Grid>
                            <Slider x:Name="CreateSplinterSlider" Minimum="0" Maximum="10000" Value="2000" MinimumTrackColor="DodgerBlue" ValueChanged="OnCreateSplinterSliderChanged"/>
                            <Label Text="Alerts if the group stretches too far from front to back." FontSize="11" TextColor="Gray"/>
                        </StackLayout>

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0,15,0,0">
                            <Button Grid.Column="0" Text="Cancel" BackgroundColor="#F0F0F0" TextColor="#333333" FontAttributes="Bold" CornerRadius="12" HeightRequest="50" Clicked="OnCloseCreateGroupModalClicked"/>
                            <Button Grid.Column="1" Text="Generate PIN" BackgroundColor="DarkOrange" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="50" Clicked="OnConfirmCreateGroupClicked"/>
                        </Grid>
                    </StackLayout>
                </ScrollView>
            </Border>
        </Grid>

        <!-- ========================================== -->
        <!-- 4. JOIN GROUP PIN MODAL                    -->
        <!-- ========================================== -->
        <Grid x:Name="JoinGroupModalOverlay" BackgroundColor="#B3000000" IsVisible="False" InputTransparent="False" ZIndex="2000" Padding="20">
            <Border VerticalOptions="Center" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" Padding="25">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="25"/>
                </Border.StrokeShape>
                <StackLayout Spacing="20">
                    <Label Text="Enter Convoy PIN" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <Label Text="Ask the Convoy Admin for the 6-digit access code." FontSize="13" TextColor="Gray" HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="0,-10,0,10"/>

                    <Border Stroke="#E0E0E0" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light=#F9F9F9, Dark=#2A2A2A}" Padding="15,0" HeightRequest="60">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="15"/>
                        </Border.StrokeShape>
                        <Entry x:Name="JoinPinEntry" Placeholder="• • • • • •" Keyboard="Numeric" MaxLength="6" FontSize="24" FontAttributes="Bold" HorizontalTextAlignment="Center" BackgroundColor="Transparent" VerticalOptions="Center"/>
                    </Border>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0,15,0,0">
                        <Button Grid.Column="0" Text="Cancel" BackgroundColor="#F0F0F0" TextColor="#333333" FontAttributes="Bold" CornerRadius="12" HeightRequest="50" Clicked="OnCloseJoinModalClicked"/>
                        <Button Grid.Column="1" Text="Join Ride" BackgroundColor="MediumSeaGreen" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="50" Clicked="OnConfirmJoinPinClicked"/>
                    </Grid>
                </StackLayout>
            </Border>
        </Grid>

        <!-- ========================================== -->
        <!-- 5. PROFILE MODAL                           -->
        <!-- ========================================== -->
        <Grid x:Name="ProfileModalOverlay" BackgroundColor="#CC000000" IsVisible="False" InputTransparent="False" ZIndex="2000" Padding="20">
            <!-- (Kept your exact Profile UI here, just wrapped in a modern Border instead of Frame) -->
            <Border VerticalOptions="Center" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" Padding="25">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="25"/>
                </Border.StrokeShape>
                <ScrollView>
                    <StackLayout Spacing="15">
                        <Label x:Name="ProfileModalTitle" Text="Rider Profile" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center"/>
                        <Label x:Name="ProfileModalSubtitle" Text="Complete your emergency info before riding." FontSize="14" TextColor="Gray" HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="0,0,0,10"/>

                        <!-- Username -->
                        <StackLayout Spacing="5">
                            <Label Text="Rider Name / Alias" FontAttributes="Bold" FontSize="14"/>
                            <Border Stroke="Transparent" BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#2A2A2A}" Padding="10,0" HeightRequest="45">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <Entry x:Name="ProfileUsernameEntry" Placeholder="e.g. Maverick" BackgroundColor="Transparent" VerticalOptions="Center"/>
                            </Border>
                        </StackLayout>

                        <!-- Blood Group -->
                        <StackLayout Spacing="5">
                            <Label Text="Blood Group" FontAttributes="Bold" FontSize="14"/>
                            <Border Stroke="Transparent" BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#2A2A2A}" Padding="10,0" HeightRequest="45">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <Picker x:Name="ProfileBloodGroupPicker" Title="Select Blood Group" BackgroundColor="Transparent" VerticalOptions="Center">
                                    <Picker.ItemsSource>
                                        <x:Array Type="{x:Type x:String}">
                                            <x:String>A+</x:String>
                                            <x:String>A-</x:String>
                                            <x:String>B+</x:String>
                                            <x:String>B-</x:String>
                                            <x:String>AB+</x:String>
                                            <x:String>AB-</x:String>
                                            <x:String>O+</x:String>
                                            <x:String>O-</x:String>
                                            <x:String>Unknown</x:String>
                                        </x:Array>
                                    </Picker.ItemsSource>
                                </Picker>
                            </Border>
                        </StackLayout>

                        <!-- Emergency Contact -->
                        <StackLayout Spacing="5">
                            <Label Text="Emergency Contact Phone" FontAttributes="Bold" FontSize="14"/>
                            <Border Stroke="Transparent" BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#2A2A2A}" Padding="10,0" HeightRequest="45">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <Entry x:Name="ProfileContactEntry" Placeholder="e.g. +1 555-0199" Keyboard="Telephone" BackgroundColor="Transparent" VerticalOptions="Center"/>
                            </Border>
                        </StackLayout>

                        <!-- Vehicle Number -->
                        <StackLayout Spacing="5">
                            <Label Text="Vehicle License Plate (Optional)" FontAttributes="Bold" FontSize="14"/>
                            <Border Stroke="Transparent" BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#2A2A2A}" Padding="10,0" HeightRequest="45">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <Entry x:Name="ProfileVehicleEntry" Placeholder="e.g. ABC-1234" TextTransform="Uppercase" BackgroundColor="Transparent" VerticalOptions="Center"/>
                            </Border>
                        </StackLayout>

                        <!-- Keep Screen On Toggle -->
                        <StackLayout Orientation="Horizontal" Spacing="10" Margin="0,5,0,0">
                            <Switch x:Name="KeepScreenOnSwitch" OnColor="MediumSeaGreen" VerticalOptions="Center"/>
                            <StackLayout VerticalOptions="Center">
                                <Label Text="Keep Screen On" FontAttributes="Bold" FontSize="14"/>
                                <Label Text="Prevents phone from sleeping." FontSize="12" TextColor="Gray"/>
                            </StackLayout>
                        </StackLayout>

                        <!-- Consent -->
                        <Border Stroke="DodgerBlue" StrokeThickness="1" BackgroundColor="#1A0099FF" Padding="15" Margin="0,10,0,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="Auto, *">
                                <CheckBox x:Name="ConsentCheckbox" Grid.Column="0" VerticalOptions="Start" Color="DodgerBlue"/>
                                <Label Grid.Column="1" Text="I consent to SpeedyCompass storing this medical info in the cloud securely for emergency broadcast purposes." FontSize="12" TextColor="Gray" VerticalOptions="Center"/>
                            </Grid>
                        </Border>

                        <Button Text="Save &amp; Continue" BackgroundColor="MediumSeaGreen" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="50" Clicked="OnSaveProfileClicked" Margin="0,10,0,0"/>
                        <Button Text="Log Out" BackgroundColor="#FFF0F0" TextColor="#CC0000" FontAttributes="Bold" CornerRadius="12" HeightRequest="50" Clicked="OnLogoutClicked" Margin="0,5,0,0"/>
                        <Button x:Name="CancelProfileButton" Text="Cancel" BackgroundColor="Transparent" TextColor="Gray" FontAttributes="Bold" Clicked="OnCancelProfileClicked" IsVisible="True"/>
                    </StackLayout>
                </ScrollView>
            </Border>
        </Grid>

        <!-- ========================================== -->
        <!-- 6. LOADING OVERLAY                         -->
        <!-- ========================================== -->
        <Grid x:Name="LoadingOverlay" BackgroundColor="#CC000000" IsVisible="False" InputTransparent="False" ZIndex="9999">
            <StackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="20">
                <ActivityIndicator IsRunning="{Binding Source={x:Reference LoadingOverlay}, Path=IsVisible}" Color="DodgerBlue" WidthRequest="60" HeightRequest="60" />
                <Label x:Name="LoadingText" Text="Connecting..." TextColor="White" FontAttributes="Bold" FontSize="18" HorizontalOptions="Center" />
            </StackLayout>
        </Grid>

    </Grid>
</ContentPage>