<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SpeedyCompass.MainPage">

    <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">

        <Label Text="Speedy Compass" FontSize="32" FontAttributes="Bold" HorizontalOptions="Center" />

        <Entry x:Name="UserNameEntry" Placeholder="Your Rider Name" HorizontalTextAlignment="Center" />

        <Entry x:Name="GroupNameEntry" Placeholder="e.g., Adventure Torque" HorizontalTextAlignment="Center" />

        <Grid ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0, 10, 0, 0">
            <Button Grid.Column="0" Text="Create Group" Clicked="OnCreateGroupClicked" BackgroundColor="#2196F3" />
            <Button Grid.Column="1" Text="Join Group" Clicked="OnJoinGroupClicked" BackgroundColor="#4CAF50" />
        </Grid>

    </VerticalStackLayout>
</ContentPage>