<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SpeedyCompass.MainPage"
             xmlns:controls="clr-namespace:SpeedyCompass.Controls"
             BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#121212}">

    <Grid>
        <!-- ========================================== -->
        <!-- 1. LOGIN VIEW                              -->
        <!-- ========================================== -->
        <VerticalStackLayout x:Name="LoginView" VerticalOptions="Center" HorizontalOptions="Center" Spacing="24" Padding="32">
            <Image Source="appicon.png" WidthRequest="120" HeightRequest="120" HorizontalOptions="Center"/>

            <VerticalStackLayout Spacing="4">
                <Label Text="SpeedyCompass" FontSize="32" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=#1976D2, Dark=#64B5F6}"/>
                <Label Text="Ride together. Stay connected." FontSize="16" TextColor="{AppThemeBinding Light=#757575, Dark=#9E9E9E}" HorizontalOptions="Center" Margin="0,0,0,24"/>
            </VerticalStackLayout>

            <Button Text="AUTHENTICATE TO RIDE" 
                    BackgroundColor="#1E88E5" 
                    TextColor="White" 
                    CornerRadius="28" 
                    HeightRequest="56" 
                    FontAttributes="Bold" 
                    CharacterSpacing="1"
                    Padding="32,0"
                    Clicked="OnAzureLoginClicked">
                <Button.Shadow>
                    <Shadow Brush="#1E88E5" Offset="0,6" Opacity="0.4" Radius="12"/>
                </Button.Shadow>
            </Button>
        </VerticalStackLayout>

        <!-- ========================================== -->
        <!-- 2. DASHBOARD VIEW                          -->
        <!-- ========================================== -->
        <Grid x:Name="DashboardView" IsVisible="False" RowDefinitions="Auto, Auto, *, Auto">

            <!-- MODERN HEADER -->
            <!-- UPGRADE: Deepened gradient and added a bottom shadow to separate it from the content -->
            <Border Grid.Row="0" StrokeThickness="0" Margin="0,0,0,16" ZIndex="10">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1565C0" Offset="0.0" />
                        <GradientStop Color="#0D47A1" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0,0,32,32"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#0D47A1" Offset="0,4" Opacity="0.3" Radius="12"/>
                </Border.Shadow>

                <Grid ColumnDefinitions="*, Auto" Padding="24,64,24,40">
                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                        <Label Text="WELCOME BACK" TextColor="#90CAF9" FontSize="12" FontAttributes="Bold" CharacterSpacing="1.5"/>
                        <Label x:Name="WelcomeNameLabel" Text="Rider" TextColor="White" FontSize="28" FontAttributes="Bold" LineBreakMode="TailTruncation"/>
                    </VerticalStackLayout>

                    <!-- UPGRADE: Replaced generic button with a Glassmorphic Material Symbol button -->
                    <Border Grid.Column="1" BackgroundColor="#33FFFFFF" StrokeThickness="0" VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnOpenProfileClicked" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Padding="16,10" Spacing="8" VerticalOptions="Center">
                            <Label Text="account_circle" FontFamily="MaterialSymbols" TextColor="White" FontSize="20" VerticalOptions="Center"/>
                            <Label Text="PROFILE" TextColor="White" FontAttributes="Bold" FontSize="13" VerticalOptions="Center" CharacterSpacing="1"/>
                        </HorizontalStackLayout>
                    </Border>
                </Grid>
            </Border>

            <!-- FLOATING CREATE ACTION -->
            <!-- UPGRADE: Standardized corner radii, massive touch target for the FAB, and added dark mode border stroke -->
            <Border Grid.Row="1" Margin="24,-48,24,16" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" StrokeThickness="1" Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" Padding="8" ZIndex="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,8" Opacity="0.15" Radius="16"/>
                </Border.Shadow>

                <Grid ColumnDefinitions="*, Auto" Padding="16,12" ColumnSpacing="16">
                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="4">
                        <Label Text="Start a New Convoy" FontAttributes="Bold" FontSize="16" TextColor="{AppThemeBinding Light=#212121, Dark=White}"/>
                        <Label Text="Generate a secure PIN for your riders" FontSize="13" TextColor="#757575"/>
                    </VerticalStackLayout>

                    <Button Grid.Column="1" 
                            Text="add" 
                            Padding="0" 
                            FontFamily="MaterialSymbols" 
                            FontSize="28" 
                            BackgroundColor="#FB8C00" 
                            TextColor="White" 
                            CornerRadius="28" 
                            WidthRequest="56" 
                            HeightRequest="56" 
                            Clicked="OnOpenCreateGroupModalClicked"
                            VerticalOptions="Center">
                        <Button.Shadow>
                            <Shadow Brush="#FB8C00" Offset="0,4" Opacity="0.3" Radius="8"/>
                        </Button.Shadow>
                    </Button>
                </Grid>
            </Border>

            <!-- ACTIVE GROUPS LIST -->
            <controls:ActiveGroupsList x:Name="GroupsListControl"
                                       Grid.Row="2"
                                       ItemsSource="{Binding Groups}"
                                       IsLoading="{Binding IsFetchingData}"
                                       IsLoadingMore="{Binding IsFetchingNextPage}"
                                       EmptyMessage="{Binding DynamicEmptyText}"
                                       RefreshRequested="OnListRefreshed"
                                       SearchQueryChanged="OnListSearched"
                                       LoadMoreRequested="OnListLoadMore"
                                       JoinClicked="OnListJoin" />

            <!-- ========================================== -->
            <!-- 3. FOOTER                                  -->
            <!-- ========================================== -->
            <HorizontalStackLayout Grid.Row="3" 
                                   HorizontalOptions="Center" 
                                   Padding="0,16,0,32"
                                   Spacing="8">
                <Label Text="support_agent" 
                       FontFamily="MaterialSymbols" 
                       TextColor="#9E9E9E" 
                       FontSize="20" 
                       VerticalOptions="Center" />

                <Label Text="Need help?" 
                       TextColor="#9E9E9E" 
                       FontSize="14" 
                       VerticalOptions="Center" />

                <Label Text="CONTACT US" 
                       TextColor="#1E88E5" 
                       FontSize="14" 
                       FontAttributes="Bold" 
                       CharacterSpacing="0.5"
                       VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnContactUsTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>
        </Grid>

        <!-- ========================================== -->
        <!-- OVERLAYS (ZIndex explicitly ordered)       -->
        <!-- ========================================== -->

        <controls:ConvoySettingsOverlay x:Name="ConvoySettingsOverlay" 
                                        SettingsSubmitted="OnSettingsSubmitted" 
                                        ZIndex="90" />

        <controls:JoinGroupOverlay x:Name="JoinGroupOverlay" 
                                   JoinConfirmed="OnJoinConfirmed" 
                                   ZIndex="100" />

        <controls:ProfileOverlay x:Name="ProfileOverlay" 
                                 ProfileSaved="OnProfileSaved" 
                                 LogoutRequested="OnLogoutRequested" 
                                 ZIndex="110" />

        <controls:LoadingOverlay x:Name="GlobalLoadingOverlay" 
                                 ZIndex="9999" />

    </Grid>
</ContentPage>