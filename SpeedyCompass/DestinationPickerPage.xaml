<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             x:Class="SpeedyCompass.DestinationPickerPage"
             Title="Pick Destination">

    <Grid RowDefinitions="Auto, *, Auto" BackgroundColor="{AppThemeBinding Light=White, Dark=#121212}">

        <!-- 1. Top Bar Area (Search) -->
        <Frame Grid.Row="0" 
               Margin="15,15,15,10" 
               Padding="0" 
               CornerRadius="12" 
               HasShadow="True"
               BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
               BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">

            <SearchBar x:Name="DestinationSearchBar"
                       Placeholder="Search for a destination..."
                       TextChanged="OnSearchTextChanged"
                       BackgroundColor="Transparent"
                       TextColor="{AppThemeBinding Light=Black, Dark=White}"
                       PlaceholderColor="{AppThemeBinding Light=Gray, Dark=#A9A9A9}"/>
        </Frame>

        <!-- 2. The Map (Perfectly contained in the middle row, corners unobstructed) -->
        <maps:Map x:Name="PreviewMap" 
                  Grid.Row="1" 
                  IsShowingUser="True" />

        <!-- 3. Floating Suggestions List (Overlaps the top of the map only) -->
        <Frame x:Name="SuggestionsFrame"
               Grid.Row="1" 
               VerticalOptions="Start"
               Margin="15,0,15,15" 
               Padding="0" 
               CornerRadius="12" 
               HasShadow="True"
               BorderColor="Transparent"
               IsVisible="False"
               BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">

            <ListView x:Name="SuggestionsListView"
                      SelectionMode="Single"
                      ItemSelected="OnSuggestionSelected"
                      BackgroundColor="Transparent"
                      SeparatorColor="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
                      MaximumHeightRequest="250">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <StackLayout Padding="15,12">
                                <Label Text="{Binding Description}"
                                       TextColor="{AppThemeBinding Light=#333333, Dark=#E0E0E0}"
                                       FontSize="15"
                                       LineBreakMode="TailTruncation"/>
                            </StackLayout>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Frame>

        <!-- 4. Bottom Action Area (Start Navigation) -->
        <Grid Grid.Row="2" Padding="20,15,20,30">
            <Button x:Name="StartNavButton" 
                    Text="Start Navigation"
                    IsEnabled="False"
                    Clicked="OnStartNavigationClicked"
                    CornerRadius="25"
                    HeightRequest="55"
                    BackgroundColor="{AppThemeBinding Light=#0066CC, Dark=#3399FF}"
                    TextColor="White"
                    FontAttributes="Bold"
                    Shadow="{Shadow Brush=Black, Offset='0,4', Opacity=0.3, Radius=8}" />
        </Grid>
    </Grid>

</ContentPage>