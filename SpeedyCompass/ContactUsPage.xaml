<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SpeedyCompass.ContactUsPage"
             Title="Contact Us"
             BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#121212}">

    <VerticalStackLayout Spacing="20" Padding="24" MaximumWidthRequest="400" HorizontalOptions="Center" VerticalOptions="Center">

        <!-- Header -->
        <Label Text="mail" 
               FontFamily="MaterialSymbols" 
               FontSize="64" 
               HorizontalOptions="Center" 
               TextColor="DodgerBlue" />

        <Label Text="Get in Touch" 
               FontSize="28" 
               FontAttributes="Bold" 
               HorizontalOptions="Center" 
               TextColor="{AppThemeBinding Light=#212121, Dark=White}" />

        <Label Text="Have a question, feedback, or need support with Speedy Compass Link? We would love to hear from you." 
               FontSize="15" 
               HorizontalTextAlignment="Center" 
               TextColor="{AppThemeBinding Light=#757575, Dark=#BDBDBD}" 
               Margin="0,0,0,16" />

        <!-- Email Display Card -->
        <Border StrokeThickness="1" 
                Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" 
                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" 
                Padding="24">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,4" Opacity="0.05" Radius="8"/>
            </Border.Shadow>

            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                <Label Text="Email us directly at:" 
                       FontSize="14" 
                       TextColor="Gray" 
                       HorizontalOptions="Center"/>

                <Label Text="support@speedycompass.com" 
                       FontSize="18" 
                       FontAttributes="Bold" 
                       TextColor="DodgerBlue" 
                       HorizontalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnEmailTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>
        </Border>

        <!-- Action Button -->
        <Button Text="OPEN EMAIL APP" 
                Clicked="OnEmailTapped" 
                BackgroundColor="DodgerBlue" 
                TextColor="White" 
                FontAttributes="Bold" 
                CornerRadius="24" 
                HeightRequest="48" 
                Margin="0,16,0,0">
            <Button.Shadow>
                <Shadow Brush="DodgerBlue" Offset="0,4" Opacity="0.3" Radius="8"/>
            </Button.Shadow>
        </Button>

    </VerticalStackLayout>
</ContentPage>