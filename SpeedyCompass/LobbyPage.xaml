<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             xmlns:controls="clr-namespace:SpeedyCompass.Controls"
             xmlns:local="clr-namespace:SpeedyCompass"
             x:Class="SpeedyCompass.LobbyPage"
             x:Name="ThisPage"
             Title="Ride Lobby">
    <Grid RowDefinitions="Auto, *">

        <!-- ===================================================================== -->
        <!-- 1. MODERN HEADER -->
        <!-- ===================================================================== -->
        <Grid Grid.Row="0" ZIndex="100" ColumnDefinitions="*, Auto" BackgroundColor="{AppThemeBinding Light=White, Dark=#121212}" Padding="20,15,20,15">
            <Grid.Shadow>
                <Shadow Brush="Black" Offset="0,4" Opacity="0.05" Radius="10"/>
            </Grid.Shadow>
            <Label Grid.Column="0" Text="{Binding Source={x:Reference GroupNameLabel}, Path=Text}" FontSize="22" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#111, Dark=White}" VerticalOptions="Center"/>
            <Button Grid.Column="1" Text="Leave" BackgroundColor="#FFEBEB" TextColor="#D32F2F" CornerRadius="18" HeightRequest="36" Padding="20,0" Clicked="OnLeaveGroupClicked" FontAttributes="Bold"/>
        </Grid>

        <!-- Hidden Label to satisfy existing bindings -->
        <Label x:Name="GroupNameLabel" IsVisible="False"/>

        <!-- ===================================================================== -->
        <!-- 2. MAIN MAP VIEW & FLOATING UI -->
        <!-- ===================================================================== -->
        <Grid Grid.Row="1">

            <!-- ALWAYS VISIBLE MAP -->
            <controls:CustomMap x:Name="LiveMap" MapClicked="OnMapClicked" IsShowingUser="False" CustomPins="{Binding MapPins, Source={x:Reference ThisPage}}" />

            <AbsoluteLayout x:Name="PinOverlayLayout" InputTransparent="True" CascadeInputTransparent="True" ZIndex="10" Grid.Row="0" Grid.RowSpan="2" BindableLayout.ItemsSource="{Binding MapPins, Source={x:Reference ThisPage}}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <!-- ContentView acts as the 0,0 anchor. The Translation binds to the Android Projection Engine! -->
                        <ContentView AbsoluteLayout.LayoutBounds="0,0,-1,-1"
                                     TranslationX="{Binding ScreenX}"
                                     TranslationY="{Binding ScreenY}">

                            <!-- The Grid translates negatively to hover precisely over the dot -->
                            <Grid TranslationX="-50" TranslationY="-75" WidthRequest="100" HorizontalOptions="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- The Main Bubble -->
                                <Border Grid.Row="0" BackgroundColor="#E61E1E1E" Stroke="{Binding PinColor}" StrokeThickness="2" 
                                        StrokeShape="RoundRectangle 10" Padding="8,4" HorizontalOptions="Fill">
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Offset="0,4" Opacity="0.3" Radius="5"/>
                                    </Border.Shadow>
                                    <VerticalStackLayout Spacing="0">
                                        <Label Text="{Binding Username}" TextColor="White" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center" LineBreakMode="TailTruncation" MaxLines="1"/>
                                        <Label Text="{Binding Speed}" TextColor="DodgerBlue" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center"/>
                                    </VerticalStackLayout>
                                </Border>

                                <!-- The Downward Tail (Drawn via Vector Path) -->
                                <Path Grid.Row="1" Data="M 0,0 L 12,0 L 6,8 Z" Fill="{Binding PinColor}" HorizontalOptions="Center" Margin="0,-2,0,0"/>
                            </Grid>
                        </ContentView>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </AbsoluteLayout>
            <!-- OVERLAYS: Admin Search UI -->
            <Grid x:Name="AdminSearchUI" ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" Margin="20,20,20,10" VerticalOptions="Start" IsVisible="False" ZIndex="20">
                <Border Grid.Row="0" Grid.Column="0" Padding="0" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="25"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,4" Opacity="0.1" Radius="10"/>
                    </Border.Shadow>
                    <SearchBar x:Name="DestinationSearchBar" TextChanged="OnSearchTextChanged" Placeholder="Search destination..." SearchButtonPressed="OnSearchPressed" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                </Border>

                <Border x:Name="SuggestionsFrame" Grid.Row="1" Grid.ColumnSpan="2" VerticalOptions="Start" Margin="0,10,0,15" Padding="0" StrokeThickness="0" IsVisible="False" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,4" Opacity="0.1" Radius="10"/>
                    </Border.Shadow>
                    <ListView x:Name="SuggestionsListView" SelectionMode="Single" ItemSelected="OnSuggestionSelected" BackgroundColor="Transparent" SeparatorColor="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" MaximumHeightRequest="250">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <StackLayout Padding="15,12">
                                        <Label Text="{Binding Description}" TextColor="{AppThemeBinding Light=#333333, Dark=#E0E0E0}" FontSize="15" LineBreakMode="TailTruncation"/>
                                    </StackLayout>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
                <Button x:Name="ConfirmDestButton" Grid.Row="0" Grid.Column="1" Text="✔️" Clicked="OnConfirmDestinationClicked" Margin="10,0,0,0" WidthRequest="50" HeightRequest="50" CornerRadius="25" BackgroundColor="MediumSeaGreen" TextColor="White" FontAttributes="Bold" IsEnabled="False" VerticalOptions="Center" Shadow="{Shadow Brush=Black, Offset='0,4', Opacity=0.2, Radius=8}"/>
                <!--<Button x:Name="ResetDestButton" Grid.Row="0" Grid.Column="1" Text="✖️" IsVisible="False" Clicked="OnResetDestinationClicked" Margin="10,0,0,0" WidthRequest="50" HeightRequest="50" CornerRadius="25" BackgroundColor="Red" TextColor="White" FontAttributes="Bold" VerticalOptions="Center" Shadow="{Shadow Brush=Black, Offset='0,4', Opacity=0.2, Radius=8}"/>-->
            </Grid>

            <Border x:Name="AdminInstructionBanner" VerticalOptions="Start" HorizontalOptions="Center" Margin="0,90,0,0" Padding="20,10" StrokeThickness="0" BackgroundColor="#E6000000" IsVisible="False" ZIndex="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <Label Text="Search above to set the Convoy destination" TextColor="White" FontAttributes="Bold" FontSize="13"/>
            </Border>

            <!-- ===================================================================== -->
            <!-- THE COMPACT NEXT TURN OVERLAY -->
            <!-- ===================================================================== -->
            <Border x:Name="NextTurnOverlay" IsVisible="False" HorizontalOptions="Start" VerticalOptions="Start" Margin="15,15,0,0" Padding="10,8" BackgroundColor="{AppThemeBinding Light=#F2FFFFFF, Dark=#F21E1E1E}" StrokeThickness="0" ZIndex="25">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Opacity="0.15" Radius="10"/>
                </Border.Shadow>
                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                    <Label x:Name="NextTurnIcon" Grid.Column="0" Text="⬆️" FontSize="24" VerticalOptions="Center" TextColor="DodgerBlue"/>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                        <Label x:Name="NextTurnDistLabel" Text="500m" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                        <Label x:Name="NextTurnInstructionLabel" Text="Continue straight" FontSize="11" TextColor="Gray" MaxLines="2" LineBreakMode="TailTruncation" WidthRequest="120"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- FLOATING MAP CONTROLS -->
            <VerticalStackLayout x:Name="FloatingMapControls" IsVisible="False" HorizontalOptions="End" VerticalOptions="End" Margin="0, 0, 15, 180" Spacing="15" ZIndex="30">
                <Button x:Name="ClearPoisBtn" IsVisible="False" Text="🧹 Clear POIs" BackgroundColor="#D32F2F" TextColor="White" CornerRadius="25" HeightRequest="50" WidthRequest="120" FontAttributes="Bold" FontSize="12" Margin="0,0,0,10" Clicked="OnClearPoisClicked">
                    <Button.Shadow>
                        <Shadow Brush="Black" Offset="0,4" Opacity="0.3" Radius="5" />
                    </Button.Shadow>
                </Button>
                <!--#if DEBUG
                <Frame x:Name="SimSpeedFrame" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" Padding="0" CornerRadius="10" IsVisible="False" HasShadow="True" WidthRequest="40" HeightRequest="150" HorizontalOptions="Center">
                    <Slider x:Name="SimSpeedSlider" Minimum="0" Maximum="140" Value="60" Rotation="-90" VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="130" ValueChanged="OnSimSpeedSliderChanged" MinimumTrackColor="DodgerBlue" />
                </Frame>
                #endif-->
                <Button x:Name="HeadingUpButton" Text="🧭" FontSize="24" BackgroundColor="{AppThemeBinding Light=White, Dark=#333333}" TextColor="DodgerBlue" CornerRadius="27" WidthRequest="55" HeightRequest="55" Clicked="OnHeadingUpClicked" Shadow="{Shadow Brush=Black, Offset='0,4', Opacity=0.2, Radius=8}" />
                <Button x:Name="RecenterMapButton" Text="🎯" FontSize="24" BackgroundColor="{AppThemeBinding Light=White, Dark=#333333}" TextColor="DodgerBlue" CornerRadius="27" WidthRequest="55" HeightRequest="55" Clicked="OnRecenterMapClicked" Shadow="{Shadow Brush=Black, Offset='0,4', Opacity=0.2, Radius=8}" />
                <Button x:Name="MapFollowButton" Text="📍" FontSize="24" BackgroundColor="{AppThemeBinding Light=White, Dark=#333333}" TextColor="MediumSeaGreen" CornerRadius="27" WidthRequest="55" HeightRequest="55" Clicked="OnMapFollowClicked" IsVisible="False" Shadow="{Shadow Brush=Black, Offset='0,4', Opacity=0.2, Radius=8}" />
                <Button x:Name="OverviewButton" Text="🗺️" FontSize="24" BackgroundColor="{AppThemeBinding Light=White, Dark=#333333}" TextColor="DodgerBlue" CornerRadius="27" WidthRequest="55" HeightRequest="55" Clicked="OnOverviewClicked" Shadow="{Shadow Brush=Black, Offset='0,4', Opacity=0.2, Radius=8}" />
            </VerticalStackLayout>

            <!-- ========================================== -->
            <!-- 3. ALWAYS-ON BOTTOM SHEET DRAWER -->
            <!-- ========================================== -->
            <Border x:Name="ActionDrawer" VerticalOptions="End" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" StrokeThickness="0" Margin="0,0,0,-40" ZIndex="40">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,-4" Opacity="0.15" Radius="15" />
                </Border.Shadow>

                <Grid RowDefinitions="Auto, Auto, Auto, *">
                    <Grid Grid.Row="0">
                        <!-- 1. IDLE HEADER -->
                        <Grid x:Name="IdleHeader" Padding="15,15,15,5" BackgroundColor="Transparent" IsVisible="True">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDrawerHandleTapped" />
                                <PanGestureRecognizer PanUpdated="OnDrawerPanUpdated" />
                            </Grid.GestureRecognizers>

                            <!-- Visible ONLY to Admin -->
                            <VerticalStackLayout x:Name="AdminIdleHeader" HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                                <Label Text="Select a destination above" FontSize="16" FontAttributes="Bold" TextColor="Gray" HorizontalOptions="Center"/>
                                <Label Text="to begin a new ride session." FontSize="12" TextColor="LightGray" HorizontalOptions="Center"/>
                            </VerticalStackLayout>

                            <!-- Visible ONLY to Standard Riders -->
                            <VerticalStackLayout x:Name="RiderIdleHeader" HorizontalOptions="Center" VerticalOptions="Center" Spacing="2" IsVisible="False">
                                <Label Text="Waiting for Admin" FontSize="16" FontAttributes="Bold" TextColor="Gray" HorizontalOptions="Center"/>
                                <Label Text="to set the convoy destination." FontSize="12" TextColor="LightGray" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- 2. PRE-NAVIGATION HEADER (Replaces PendingDestinationFrame) -->
                        <Grid x:Name="PreNavigationHeader" ColumnDefinitions="*, Auto" Padding="15,15,15,5" BackgroundColor="Transparent" IsVisible="False">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDrawerHandleTapped" />
                                <PanGestureRecognizer PanUpdated="OnDrawerPanUpdated" />
                            </Grid.GestureRecognizers>
                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                                <Label x:Name="PreNavDestLabel" Text="Target Destination" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333, Dark=White}" LineBreakMode="TailTruncation" MaxLines="1"/>
                                <Label x:Name="PreNavDistLabel" Text="Calculating route..." FontSize="13" TextColor="DodgerBlue" FontAttributes="Bold"/>
                            </VerticalStackLayout>
                            <Button x:Name="StartJourneyButton" Grid.Column="1" Text="🚀 Start" BackgroundColor="DodgerBlue" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="45" Padding="15,0" Clicked="OnStartJourneyClicked" IsVisible="False" VerticalOptions="Center"/>
                        </Grid>

                        <!-- 3. REDESIGNED TELEMETRY HEADER -->
                        <Grid x:Name="TelemetryHeader" Padding="20,15,20,15" BackgroundColor="Transparent" IsVisible="False">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDrawerHandleTapped" />
                                <PanGestureRecognizer PanUpdated="OnDrawerPanUpdated" />
                            </Grid.GestureRecognizers>

                            <Grid ColumnDefinitions="1.2*, 1*, Auto" ColumnSpacing="10">
                                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="4">
                                    <StackLayout Orientation="Horizontal" Spacing="4">
                                        <Label Text="Distance" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333, Dark=White}"/>
                                        <Label x:Name="MyDistanceLabel" Text="-- km" FontSize="14" FontAttributes="Bold" TextColor="DodgerBlue"/>
                                    </StackLayout>

                                    <!-- THE FIX: Use a Grid so TailTruncation actually works! -->
                                    <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto" RowSpacing="2" ColumnSpacing="5">
                                        <Label Grid.Row="0" Grid.Column="0" Text="○" FontSize="10" TextColor="Gray" VerticalOptions="Center"/>
                                        <Label Grid.Row="0" Grid.Column="1" Text="My Location" FontSize="11" TextColor="Gray" LineBreakMode="TailTruncation" MaxLines="1"/>

                                        <Label Grid.Row="1" Grid.Column="0" Text="📍" FontSize="10" TextColor="DodgerBlue" VerticalOptions="Center"/>
                                        <Label Grid.Row="1" Grid.Column="1" x:Name="TelemetryDestLabel" Text="Destination" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333, Dark=White}" LineBreakMode="TailTruncation" MaxLines="1"/>
                                    </Grid>
                                </VerticalStackLayout>

                                <!-- Middle: Progress Bar Layout -->
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                    <Label Text="Route" FontSize="11" TextColor="Gray" FontAttributes="Bold" HorizontalOptions="Center"/>

                                    <!-- THE FIX: Wrap in a Grid so they overlap safely! -->
                                    <Grid HorizontalOptions="Center" WidthRequest="60" HeightRequest="60">
                                        <controls:CircularProgressBar x:Name="RouteProgressBar" WidthRequest="60" HeightRequest="60" StrokeThickness="5" ProgressColor="MediumSeaGreen" TrackColor="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" />
                                        <Label x:Name="MyProgressPercentLabel" Text="0%" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333, Dark=White}" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Grid>

                                    <StackLayout Orientation="Horizontal" HorizontalOptions="Center" Spacing="2">
                                        <Label x:Name="MyTotalTraveledLabel" Text="0.0" FontSize="10" FontAttributes="Bold" TextColor="Gray"/>
                                        <Label Text="/" FontSize="10" TextColor="Gray" VerticalOptions="Center"/>
                                        <Label x:Name="MyTotalRouteLabel" Text="-- km" FontSize="10" TextColor="Gray" VerticalOptions="Center"/>
                                    </StackLayout>
                                </VerticalStackLayout>

                                <!-- Right: Arrival Time -->
                                <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" HorizontalOptions="End" Spacing="2">
                                    <Label Text="Arrival time" FontSize="11" TextColor="Gray" FontAttributes="Bold" HorizontalOptions="End"/>
                                    <Label x:Name="MyEtaLabel" Text="10:10 PM" FontSize="15" FontAttributes="Bold" TextColor="DarkOrange" HorizontalOptions="End"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- DRAG HANDLE -->
                    <Grid Grid.Row="1" Padding="0,5,0,15" BackgroundColor="Transparent">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDrawerHandleTapped" />
                            <PanGestureRecognizer PanUpdated="OnDrawerPanUpdated" />
                        </Grid.GestureRecognizers>
                        <BoxView HeightRequest="5" WidthRequest="40" CornerRadius="2.5" BackgroundColor="LightGray" HorizontalOptions="Center" />
                    </Grid>

                    <!-- DRAWER TABS -->
                    <Grid Grid.Row="2" ColumnDefinitions="*, *, *, *" Margin="10,0,10,10">
                        <Button x:Name="TabActionsBtn" Grid.Column="0" Text="Safety" BackgroundColor="Transparent" TextColor="Gray" CornerRadius="20" Margin="2" Clicked="OnDrawerTabClicked" />
                        <Button x:Name="TabStatsBtn" Grid.Column="1" Text="Convoy" BackgroundColor="DodgerBlue" TextColor="White" CornerRadius="20" Margin="2" Clicked="OnDrawerTabClicked" />
                        <Button x:Name="TabMapSettingsBtn" Grid.Column="2" Text="Map" BackgroundColor="Transparent" TextColor="Gray" CornerRadius="20" Margin="2" Clicked="OnDrawerTabClicked" />
                        <Button x:Name="TabAdminBtn" Grid.Column="3" Text="Admin" BackgroundColor="Transparent" TextColor="Gray" CornerRadius="20" Margin="2" Clicked="OnDrawerTabClicked" />
                    </Grid>

                    <!-- SCROLLABLE CONTENT AREA -->
                    <ScrollView Grid.Row="3" Padding="20,10,20,50">
                        <Grid>
                            <!-- TAB 1: SAFETY & ACTIONS -->
                            <VerticalStackLayout x:Name="DrawerActionsTab" IsVisible="False" Spacing="15">
                                <Border HeightRequest="80" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#2C3E50, Dark=#1A1C1E}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20" />
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Offset="0,6" Opacity="0.2" Radius="10" />
                                    </Border.Shadow>
                                    <Grid ColumnDefinitions="Auto, *, Auto" Padding="20,0">
                                        <Frame Grid.Column="0" WidthRequest="45" HeightRequest="45" CornerRadius="22.5" BackgroundColor="#27AE60" HasShadow="False" Padding="0" VerticalOptions="Center">
                                            <Label Text="🎤" HorizontalOptions="Center" VerticalOptions="Center" FontSize="20"/>
                                        </Frame>
                                        <StackLayout Grid.Column="1" VerticalOptions="Center" Margin="15,0,0,0" Spacing="2">
                                            <Label Text="PUSH TO TALK" FontSize="18" FontAttributes="Bold" TextColor="White" />
                                            <Label Text="Global Convoy Channel" FontSize="12" TextColor="#B0BEC5" />
                                        </StackLayout>
                                        <BoxView Grid.Column="2" WidthRequest="10" HeightRequest="10" CornerRadius="5" BackgroundColor="#27AE60" VerticalOptions="Center"/>
                                    </Grid>
                                </Border>

                                <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                                    <Border Grid.Column="0" HeightRequest="70" StrokeThickness="1" Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="16"/>
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnRefuelStopClicked" />
                                        </Border.GestureRecognizers>
                                        <StackLayout Orientation="Horizontal" HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                                            <Label Text="⛽" FontSize="22" VerticalOptions="Center"/>
                                            <Label Text="Refuel" FontSize="17" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333333, Dark=White}" VerticalOptions="Center"/>
                                        </StackLayout>
                                    </Border>
                                    <Border Grid.Column="1" HeightRequest="70" StrokeThickness="1" Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="16"/>
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnRestStopClicked" />
                                        </Border.GestureRecognizers>
                                        <StackLayout Orientation="Horizontal" HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                                            <Label Text="☕" FontSize="22" VerticalOptions="Center"/>
                                            <Label Text="Rest" FontSize="17" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333333, Dark=White}" VerticalOptions="Center"/>
                                        </StackLayout>
                                    </Border>
                                </Grid>

                                <Border HeightRequest="70" StrokeThickness="0">
                                    <Border.Background>
                                        <LinearGradientBrush EndPoint="1,0">
                                            <GradientStop Color="#D32F2F" Offset="0.0" />
                                            <GradientStop Color="#C62828" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16"/>
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnEmergencyStopClicked" />
                                    </Border.GestureRecognizers>
                                    <Border.Shadow>
                                        <Shadow Brush="Red" Offset="0,4" Opacity="0.25" Radius="10" />
                                    </Border.Shadow>
                                    <StackLayout Orientation="Horizontal" HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                                        <Label Text="⚠️" FontSize="22" VerticalOptions="Center"/>
                                        <Label Text="EMERGENCY STOP" FontSize="18" FontAttributes="Bold" TextColor="White" VerticalOptions="Center" CharacterSpacing="1"/>
                                    </StackLayout>
                                </Border>

                                <Border x:Name="StartNavButton" HeightRequest="65" StrokeThickness="1.5" Stroke="#0F9D58" BackgroundColor="{AppThemeBinding Light=#F1FAF4, Dark=#15261B}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16"/>
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnLaunchNativeNavClicked" />
                                    </Border.GestureRecognizers>
                                    <StackLayout Orientation="Horizontal" HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                                        <Label Text="🗺️" FontSize="20" VerticalOptions="Center"/>
                                        <Label Text="OPEN NATIVE GPS" FontSize="16" FontAttributes="Bold" TextColor="#0F9D58" VerticalOptions="Center" CharacterSpacing="1"/>
                                    </StackLayout>
                                </Border>
                            </VerticalStackLayout>

                            <!-- TAB 2: CONVOY (Unified Roster + Telemetry Merge) -->
                            <VerticalStackLayout x:Name="DrawerStatsTab" Spacing="15" IsVisible="True">
                                <!-- Status & PIN -->
                                <StackLayout Orientation="Horizontal" HorizontalOptions="Center" Spacing="8" Margin="0,0,0,5">
                                    <BoxView x:Name="StatusDot" WidthRequest="10" HeightRequest="10" CornerRadius="5" BackgroundColor="Orange" VerticalOptions="Center"/>
                                    <Label x:Name="StatusLabel" Text="Connecting..." VerticalOptions="Center" FontSize="13" FontAttributes="Bold" TextColor="Gray"/>
                                </StackLayout>

                                <Border x:Name="AdminPinCard" IsVisible="False" StrokeThickness="0" Margin="0,0,0,10">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#0066CC" Offset="0.0" />
                                            <GradientStop Color="#003399" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16" />
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="*, Auto" Padding="20">
                                        <StackLayout Grid.Column="0" VerticalOptions="Center" Spacing="0">
                                            <Label Text="CONVOY PIN" FontSize="11" FontAttributes="Bold" TextColor="#AADDFF" CharacterSpacing="1"/>
                                            <Label Text="{Binding ConvoyPin}" FontSize="32" FontAttributes="Bold" TextColor="White" CharacterSpacing="4"/>
                                            <Label Text="Share this with riders to join" FontSize="12" TextColor="#AADDFF" Margin="0,2,0,0"/>
                                        </StackLayout>
                                        <Button Grid.Column="1" Text="📋 Copy" BackgroundColor="#33FFFFFF" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="45" Padding="15,0" Clicked="OnCopyPinClicked" VerticalOptions="Center"/>
                                    </Grid>
                                </Border>

                                <!-- UNIFIED RIDERS & TELEMETRY LIST -->
                                <Label Text="LIVE CONVOY SPREAD" FontSize="12" FontAttributes="Bold" TextColor="Gray" CharacterSpacing="1"/>
                                <CollectionView x:Name="RidersCollectionView" SelectionMode="None" MaximumHeightRequest="300">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="local:Rider">
                                            <Border StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}" Margin="0,0,0,10">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="14"/>
                                                </Border.StrokeShape>
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnRiderTapped" CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="15" Padding="15">
                                                    <Ellipse Grid.Column="0" WidthRequest="12" HeightRequest="12" VerticalOptions="Center" StrokeThickness="0">
                                                        <Ellipse.Triggers>
                                                            <DataTrigger TargetType="Ellipse" Binding="{Binding IsOnline}" Value="True">
                                                                <Setter Property="Fill" Value="MediumSeaGreen" />
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Ellipse" Binding="{Binding IsOnline}" Value="False">
                                                                <Setter Property="Fill" Value="Red" />
                                                            </DataTrigger>
                                                        </Ellipse.Triggers>
                                                    </Ellipse>
                                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                                        <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#222, Dark=White}"/>

                                                        <!-- THE FIX: Speed and Ahead/Behind Status side-by-side -->
                                                        <StackLayout Orientation="Horizontal" Spacing="8">
                                                            <Label Text="{Binding SpeedStr}" FontSize="12" TextColor="DodgerBlue" FontAttributes="Bold"/>
                                                            <Label Text="{Binding StatusStr}" FontSize="12" TextColor="{Binding StatusColor}" FontAttributes="Bold"/>
                                                        </StackLayout>
                                                    </VerticalStackLayout>
                                                    <Border Grid.Column="2" BackgroundColor="{Binding RoleColor}" StrokeThickness="0" Padding="10,5" VerticalOptions="Center">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="8"/>
                                                        </Border.StrokeShape>
                                                        <Label Text="{Binding RoleDisplay}" TextColor="White" FontSize="11" FontAttributes="Bold" CharacterSpacing="1"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>

                            <!-- TAB 3: ADMIN CONTROLS -->
                            <VerticalStackLayout x:Name="DrawerAdminTab" IsVisible="False" Spacing="15">
                                <Label Text="Ride Management" FontAttributes="Bold" FontSize="18" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                                <Button x:Name="PauseNavBtn" Text="⏸ Pause Ride" BackgroundColor="Goldenrod" TextColor="White" HeightRequest="55" CornerRadius="15" FontAttributes="Bold" Clicked="OnPauseNavClicked" />
                                <Button x:Name="ResumeNavBtn" Text="▶️ Resume Ride" IsVisible="False" BackgroundColor="MediumSeaGreen" TextColor="White" HeightRequest="55" CornerRadius="15" FontAttributes="Bold" Clicked="OnResumeJourneyClicked" />
                                <Button x:Name="MeetupPointBtn" Text="🔄 Sync Routes (Late Joiners)" BackgroundColor="DarkViolet" TextColor="White" HeightRequest="55" CornerRadius="15" FontAttributes="Bold" Clicked="OnGenerateMeetupClicked" />
                                <Button Text="⚙️ Group Settings" BackgroundColor="DimGray" TextColor="White" HeightRequest="55" CornerRadius="15" FontAttributes="Bold" Clicked="OnAdminSettingsClicked" />
                                <Button x:Name="CompleteNavBtn" Text="🏁 Finish Route" BackgroundColor="Crimson" TextColor="White" HeightRequest="55" CornerRadius="15" FontAttributes="Bold" Clicked="OnCompleteNavClicked" />
                                <Button x:Name="ResetTripBtn" Text="✖️ Cancel / Reset Trip" BackgroundColor="Red" TextColor="White" HeightRequest="55" CornerRadius="15" FontAttributes="Bold" Clicked="OnResetDestinationClicked" />
                            </VerticalStackLayout>

                            <!-- TAB 4: MAP SETTINGS -->
                            <VerticalStackLayout x:Name="DrawerMapSettingsTab" IsVisible="False" Spacing="15">
                                <Label Text="Map &amp; Navigation" FontAttributes="Bold" FontSize="18" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                                <StackLayout Spacing="5">
                                    <Label Text="Map Style" FontAttributes="Bold" FontSize="14"/>
                                    <Border StrokeThickness="1" Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#1E1E1E}" HeightRequest="45">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="22.5" />
                                        </Border.StrokeShape>
                                        <Grid ColumnDefinitions="*,*,*">
                                            <Button x:Name="MapStyleStreetBtn" Grid.Column="0" Text="Street" Clicked="OnMapStyleClicked" CornerRadius="20" BackgroundColor="DodgerBlue" TextColor="White" FontSize="12" FontAttributes="Bold" Margin="2"/>
                                            <Button x:Name="MapStyleSatBtn" Grid.Column="1" Text="Satellite" Clicked="OnMapStyleClicked" CornerRadius="20" BackgroundColor="Transparent" TextColor="Gray" FontSize="12" FontAttributes="Bold" Margin="2"/>
                                            <Button x:Name="MapStyleTerBtn" Grid.Column="2" Text="Hybrid" Clicked="OnMapStyleClicked" CornerRadius="20" BackgroundColor="Transparent" TextColor="Gray" FontSize="12" FontAttributes="Bold" Margin="2"/>
                                        </Grid>
                                    </Border>
                                </StackLayout>
                                <StackLayout Spacing="10" Margin="0,10,0,0">
                                    <Label Text="Layers &amp; Context" FontAttributes="Bold" FontSize="14"/>
                                    <Grid ColumnDefinitions="*, Auto">
                                        <Label Text="Live Traffic Layer" VerticalOptions="Center"/>
                                        <Switch x:Name="TrafficSwitch" Grid.Column="1" OnColor="MediumSeaGreen" Toggled="OnMapSettingChanged" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*, Auto">
                                        <Label Text="Speed Limit Alerts" VerticalOptions="Center"/>
                                        <Switch x:Name="SpeedLimitSwitch" Grid.Column="1" OnColor="MediumSeaGreen" Toggled="OnMapSettingChanged" />
                                    </Grid>
                                </StackLayout>
                                <StackLayout Spacing="10" Margin="0,10,0,0">
                                    <Label Text="Camera Physics" FontAttributes="Bold" FontSize="14"/>
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackLayout Grid.Column="0" VerticalOptions="Center">
                                            <Label Text="Speed-Based Auto-Zoom" />
                                            <Label Text="Zooms out on highways, in on streets." FontSize="11" TextColor="Gray"/>
                                        </StackLayout>
                                        <Switch x:Name="AutoZoomSwitch" Grid.Column="1" OnColor="MediumSeaGreen" Toggled="OnMapSettingChanged" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackLayout Grid.Column="0" VerticalOptions="Center">
                                            <Label Text="Auto-Tilt (3D Horizon)" />
                                            <Label Text="Tilts map at high speeds for visibility." FontSize="11" TextColor="Gray"/>
                                        </StackLayout>
                                        <Switch x:Name="AutoTiltSwitch" Grid.Column="1" OnColor="MediumSeaGreen" Toggled="OnMapSettingChanged" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackLayout Grid.Column="0" VerticalOptions="Center">
                                            <Label Text="Voice Navigation" />
                                            <Label Text="Enables/Disables map navigation instructions" FontSize="11" TextColor="Gray"/>
                                        </StackLayout>
                                        <Switch x:Name="VoiceNavSwitch" Grid.Column="1" OnColor="MediumSeaGreen" Toggled="OnMapSettingChanged" />
                                    </Grid>
                                </StackLayout>
                            </VerticalStackLayout>
                        </Grid>
                    </ScrollView>
                </Grid>
            </Border>

            <!-- OVERLAYS: ALERTS & LOADERS -->
            <controls:SensoryAlertOverlay x:Name="SensoryAlertOverlay" Grid.RowSpan="100" ZIndex="999" />

            <controls:PttOverlay x:Name="PttOverlay" Grid.RowSpan="100" ZIndex="2000" />

            <controls:LocationDisabledOverlay x:Name="LocationDisabledOverlay" Grid.RowSpan="100" ZIndex="1000" 
                                          OpenSettingsRequested="OnOpenSettingsClicked" 
                                          RetryRequested="OnRetryLocationClicked" />

            <controls:AdminSettingsOverlay x:Name="AdminSettingsOverlay" 
                                       SettingsSaved="OnAdminSettingsSaved" />

            <controls:LoadingOverlay x:Name="GlobalLoadingOverlay" Grid.RowSpan="100" 
                             Grid.ColumnSpan="100" 
                             ZIndex="9999" />

            <controls:RideSummaryOverlay x:Name="RideSummaryOverlay" Grid.RowSpan="100" ZIndex="3000" 
                                     CloseRequested="OnCloseRideSummaryClicked" />

        </Grid>
    </Grid>
</ContentPage>