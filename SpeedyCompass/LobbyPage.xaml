<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             xmlns:controls="clr-namespace:SpeedyCompass.Controls"
             xmlns:local="clr-namespace:SpeedyCompass"
             x:Class="SpeedyCompass.LobbyPage"
             x:Name="ThisPage"
             Title="Ride Lobby">
    <!-- Remove x:DataType from root, set BindingContext in code-behind instead -->
    <Grid RowDefinitions="Auto, *">
        <!-- 1. Custom Tab Bar -->
        <Grid Grid.Row="0" ZIndex="100" ColumnDefinitions="*,*, Auto" BackgroundColor="{AppThemeBinding Light=#EEEEEE, Dark=#1E1E1E}" Padding="10">
            <Button x:Name="TabRoster" Text="Roster" Clicked="OnTabClicked" CornerRadius="10" BackgroundColor="DodgerBlue" TextColor="White" FontAttributes="Bold"/>
            <Button x:Name="TabMap" Grid.Column="1" Text="Live Map" Clicked="OnTabClicked" CornerRadius="10" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=Black, Dark=White}" FontAttributes="Bold"/>

            <!-- NEW: Leave Group Button -->
            <Button Grid.Column="2" Text="🚪 Leave" BackgroundColor="Transparent" TextColor="Red" Clicked="OnLeaveGroupClicked" FontAttributes="Bold" Margin="5,0,0,0"/>
        </Grid>

        <!-- 2. TAB 1: The Roster View -->
        <Grid x:Name="RosterView" Grid.Row="1" RowDefinitions="Auto, Auto, Auto, Auto, *" Padding="20">

            <!-- Connection Status Indicator -->
            <Frame Grid.Row="0" CornerRadius="8" Padding="10" Margin="0,0,0,15" BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#2A2A2A}" BorderColor="Transparent" HasShadow="False">
                <StackLayout Orientation="Horizontal" HorizontalOptions="Center" Spacing="8">
                    <BoxView x:Name="StatusDot" WidthRequest="12" HeightRequest="12" CornerRadius="6" BackgroundColor="Orange" VerticalOptions="Center"/>
                    <Label x:Name="StatusLabel" Text="Connecting..." VerticalOptions="Center" FontSize="14" FontAttributes="Bold"/>
                </StackLayout>
            </Frame>

            <StackLayout Grid.Row="1" HorizontalOptions="Center" Margin="0,0,0,20">
                <Label Text="Group ID" FontSize="14" TextColor="Gray" HorizontalOptions="Center"/>
                <Label x:Name="GroupNameLabel" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
            </StackLayout>

            <Frame Grid.Row="2" CornerRadius="12" HasShadow="True" Padding="15" Margin="0,0,0,20" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" BorderColor="Transparent">
                <Grid ColumnDefinitions="*, Auto">
                    <StackLayout Grid.Column="0">
                        <Label Text="You" FontSize="12" TextColor="Gray"/>
                        <Label x:Name="CurrentUserNameLabel" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                    </StackLayout>
                    <Label x:Name="CurrentUserRoleLabel" Grid.Column="1" VerticalOptions="Center" FontAttributes="Bold" TextColor="DodgerBlue"/>
                </Grid>
            </Frame>

            <Frame x:Name="PendingDestinationFrame" Grid.Row="3" CornerRadius="12" HasShadow="True" Padding="15" Margin="0,0,0,20" BackgroundColor="{AppThemeBinding Light=#E3F2FD, Dark=#4A2C00}" BorderColor="DarkOrange" IsVisible="False">
                <StackLayout>
                    <Label Text="Target Destination" FontSize="12" TextColor="Gray"/>
                    <Label x:Name="PendingDestinationLabel" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>

                    <!-- Only visible to the Admin -->
                    <Button x:Name="StartJourneyButton" 
                            Text="🚀 Start Journey" 
                            BackgroundColor="MediumSeaGreen" 
                            TextColor="White" 
                            FontAttributes="Bold" 
                            CornerRadius="8" 
                            Margin="0,10,0,0" 
                            IsVisible="False" 
                            Clicked="OnStartJourneyClicked" />
                </StackLayout>
            </Frame>

            <CollectionView x:Name="RidersCollectionView" Grid.Row="4">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="local:Rider">
                        <!-- Now x:DataType is properly used in the template -->
                        <Frame CornerRadius="8" HasShadow="False" Padding="15" Margin="0,0,0,10" BackgroundColor="{AppThemeBinding Light=#F9F9F9, Dark=#2C2C2C}" BorderColor="Transparent">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="{Binding Name}" Grid.Column="0" VerticalOptions="Center" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                                <Frame Grid.Column="1" BackgroundColor="{Binding RoleColor}" CornerRadius="6" Padding="8,4" HasShadow="False">
                                    <Label Text="{Binding RoleDisplay}" TextColor="White" FontSize="12" FontAttributes="Bold"/>
                                </Frame>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- 3. TAB 2: The Unified Live Map View -->
        <Grid x:Name="MapView" Grid.Row="1" IsVisible="False" RowDefinitions="Auto, *">

            <!-- Map Container bound to the ObservableCollection using MVVM -->
            <controls:CustomMap x:Name="LiveMap" 
                                Grid.Row="0" Grid.RowSpan="2"
                                MapClicked="OnMapClicked" 
                                IsShowingUser="False"
                                IsTrafficEnabled="True"
                                CustomPins="{Binding MapPins, Source={x:Reference ThisPage}}"
            />

            <!-- FLOATING MAP CONTROLS: Grouped perfectly together -->
            <VerticalStackLayout x:Name="FloatingControlsLayout"
                                 Grid.Row="1"
                                 HorizontalOptions="End"
                                 VerticalOptions="End"
                                 Margin="0,0,20,30"
                                 Spacing="15"
                                 ZIndex="30">

                <!-- NEW: CURRENT LOCATION BUTTON -->
                <Button x:Name="RecenterMapButton" 
                        Text="🎯" 
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#333333}" 
                        TextColor="DodgerBlue" 
                        WidthRequest="55" 
                        HeightRequest="55" 
                        CornerRadius="27" 
                        FontSize="24" 
                        Clicked="OnRecenterMapClicked"
                        HorizontalOptions="End"
                        Shadow="{Shadow Brush=Black, Offset='0,4', Opacity=0.4, Radius=8}" />

                <!-- STANDALONE GMAP BUTTON -->
                <Button x:Name="StartNavButton" 
                        Text="🗺️ GMAP" 
                        BackgroundColor="MediumSeaGreen" 
                        TextColor="White" 
                        WidthRequest="110" 
                        HeightRequest="55" 
                        CornerRadius="27" 
                        FontSize="14" 
                        FontAttributes="Bold"
                        Clicked="OnLaunchNativeNavClicked"
                        HorizontalOptions="End"
                        IsVisible="False"
                        Shadow="{Shadow Brush=Black, Offset='0,4', Opacity=0.4, Radius=8}" />

                <!-- DRAWER TOGGLE BUTTON -->
                <Button x:Name="MinimizePanelButton"
                        Text="🔼"
                        IsVisible="False"
                        Clicked="OnMinimizePanelClicked" 
                        HorizontalOptions="End"
                        WidthRequest="55"
                        HeightRequest="55"
                        CornerRadius="27"
                        BackgroundColor="Grey"
                        TextColor="White"
                        FontSize="18"
                        FontAttributes="Bold"
                        Shadow="{Shadow Brush=Black, Offset='0,4', Opacity=0.4, Radius=8}" />
            </VerticalStackLayout>

            <!-- NEW: BOTTOM ACTION DRAWER UPGRADED TO BORDER FOR ASYMMETRIC CORNERS -->
            <Border x:Name="ActionDrawer" 
                   Grid.Row="1" 
                   VerticalOptions="End" 
                   Margin="0,0,0,0" 
                   Padding="20,25,20,40" 
                   StrokeShape="RoundRectangle 30,30,0,0"
                   StrokeThickness="0"
                   BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" 
                   IsVisible="False" 
                   ZIndex="20">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,-4" Opacity="0.3" Radius="10" />
                </Border.Shadow>

                <Grid x:Name="ActionButtonsStack" ColumnDefinitions="*, *, *" RowDefinitions="Auto, Auto" RowSpacing="15" ColumnSpacing="15">
                    <!-- Row 1: Alerts -->
                    <Button Grid.Row="0" Grid.Column="0" Text="🛑" BackgroundColor="Wheat" TextColor="White" HeightRequest="65" CornerRadius="20" FontSize="28" Clicked="OnEmergencyStopClicked" Shadow="{Shadow Brush=Black, Offset='0,4', Opacity=0.4, Radius=8}" />
                    <Button Grid.Row="0" Grid.Column="1" Text="⛽" BackgroundColor="DarkOrange" TextColor="White" HeightRequest="65" CornerRadius="20" FontSize="28" Clicked="OnRefuelStopClicked" Shadow="{Shadow Brush=Black, Offset='0,4', Opacity=0.4, Radius=8}" />
                    <Button Grid.Row="0" Grid.Column="2" Text="☕" BackgroundColor="DodgerBlue" TextColor="White" HeightRequest="65" CornerRadius="20" FontSize="28" Clicked="OnRestStopClicked" Shadow="{Shadow Brush=Black, Offset='0,4', Opacity=0.4, Radius=8}" />

                    <!-- Row 2: Nav / Audio Actions -->
                    <Button x:Name="OverviewButton" Grid.Row="1" Grid.Column="0" Text="🤝" BackgroundColor="FloralWhite" TextColor="White" HeightRequest="65" CornerRadius="20" FontSize="28" Clicked="OnOverviewClicked" Shadow="{Shadow Brush=Black, Offset='0,4', Opacity=0.4, Radius=8}" />
                    <Button x:Name="ResumeNavButton" Grid.Row="1" Grid.Column="0" Text="📍" BackgroundColor="AntiqueWhite" TextColor="White" HeightRequest="65" CornerRadius="20" FontSize="28" Clicked="OnResumeNavClicked" IsVisible="False" Shadow="{Shadow Brush=Black, Offset='0,4', Opacity=0.4, Radius=8}" />

                    <Button Grid.Row="1" Grid.Column="1" Text="🗣️" BackgroundColor="GhostWhite" TextColor="White" HeightRequest="65" CornerRadius="20" FontSize="28" Shadow="{Shadow Brush=Black, Offset='0,4', Opacity=0.4, Radius=8}" />
                </Grid>
            </Border>

            <!-- FULL SCREEN SENSORY ALERT OVERLAY -->
            <Grid x:Name="SensoryAlertOverlay" Grid.Row="0" Grid.RowSpan="2" BackgroundColor="Red" Opacity="0" IsVisible="False" InputTransparent="True" ZIndex="999">
                <StackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
                    <Label x:Name="AlertIconLabel" Text="🛑" FontSize="100" HorizontalTextAlignment="Center" />
                    <Label x:Name="AlertTitleLabel" Text="EMERGENCY STOP!" TextColor="White" FontSize="36" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                    <Label x:Name="AlertSenderLabel" Text="Triggered by: You" TextColor="White" FontSize="20" HorizontalTextAlignment="Center" />
                </StackLayout>
            </Grid>

            <!-- Destination Picker UI (Admin Only) -->
            <Grid x:Name="AdminSearchUI" Grid.Row="0" ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" Margin="15,15,15,10" IsVisible="False">
                <Frame Grid.Row="0" Grid.Column="0" Padding="0" CornerRadius="25" HasShadow="True" BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                    <SearchBar x:Name="DestinationSearchBar"
                               TextChanged="OnSearchTextChanged"
                               Placeholder="Search or tap map..."
                               SearchButtonPressed="OnSearchPressed"
                               BackgroundColor="Transparent"
                               TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                </Frame>
                <!-- 3. Floating Suggestions List (Overlaps the top of the map only) -->
                <Frame x:Name="SuggestionsFrame"
                           Grid.Row="1"
                           Grid.ColumnSpan="2"
                           VerticalOptions="Start"
                           Margin="15,10,15,15"
                           Padding="0"
                           CornerRadius="12"
                           HasShadow="True"
                           BorderColor="Transparent"
                           IsVisible="False"
                           BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">

                    <ListView x:Name="SuggestionsListView"
                              SelectionMode="Single"
                              ItemSelected="OnSuggestionSelected"
                              BackgroundColor="Transparent"
                              SeparatorColor="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
                              MaximumHeightRequest="250">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <StackLayout Padding="15,12">
                                        <Label Text="{Binding Description}"
                                               TextColor="{AppThemeBinding Light=#333333, Dark=#E0E0E0}"
                                               FontSize="15"
                                               LineBreakMode="TailTruncation"/>
                                    </StackLayout>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Frame>
                <Button x:Name="ConfirmDestButton" 
                        Grid.Row="0"
                        Grid.Column="1" 
                        Text="✔️" 
                        Clicked="OnConfirmDestinationClicked" 
                        Margin="10,0,0,0" 
                        WidthRequest="50"
                        HeightRequest="50"
                        CornerRadius="25" 
                        BackgroundColor="DodgerBlue" 
                        TextColor="White"
                        FontAttributes="Bold"
                        IsEnabled="False"
                        VerticalOptions="Center"
                        Shadow="{Shadow Brush=Black, Offset='0,4', Opacity=0.3, Radius=8}"/>
                <!-- NEW: The Reset Button (Hidden by default) -->
                <Button x:Name="ResetDestButton" 
                        Grid.Row="0"
                        Grid.Column="1" 
                        Text="✖️" 
                        IsVisible="False"
                        Clicked="OnResetDestinationClicked" 
                        Margin="10,0,0,0" 
                        WidthRequest="50"
                        HeightRequest="50"
                        CornerRadius="25" 
                        BackgroundColor="Red" 
                        TextColor="White"
                        FontAttributes="Bold"
                        VerticalOptions="Center"
                        Shadow="{Shadow Brush=Black, Offset='0,4', Opacity=0.3, Radius=8}"/>
            </Grid>

            <Frame x:Name="AdminInstructionBanner" 
                   Grid.Row="1"
                   VerticalOptions="Start" 
                   HorizontalOptions="Center" 
                   Margin="0,15,0,0" 
                   Padding="15,10" 
                   CornerRadius="20" 
                   BackgroundColor="#CC000000" 
                   BorderColor="Transparent"
                   IsVisible="False">
                <Label Text="Tap the map or search to set a destination" TextColor="White" FontAttributes="Bold" FontSize="14"/>
            </Frame>
        </Grid>
        <!-- PICTURE-IN-PICTURE (PiP) SQUARE DASHBOARD OVERLAY -->
        <Grid x:Name="PipOverlayGrid" Grid.Row="0" Grid.RowSpan="2" BackgroundColor="#121212" IsVisible="False" ZIndex="1500" Padding="15">
            <StackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
                <!-- Status Indicator -->
                <StackLayout Orientation="Horizontal" Spacing="5" HorizontalOptions="Center">
                    <BoxView Color="MediumSeaGreen" WidthRequest="12" HeightRequest="12" CornerRadius="6" VerticalOptions="Center"/>
                    <Label Text="Route Active" TextColor="White" FontSize="14" FontAttributes="Bold" VerticalOptions="Center"/>
                </StackLayout>

                <!-- Speed & Riders -->
                <Label x:Name="PipSpeedLabel" Text="0 mph" TextColor="DodgerBlue" FontSize="36" FontAttributes="Bold" HorizontalOptions="Center"/>
                <Label x:Name="PipRiderCountLabel" Text="Connecting..." TextColor="LightGray" FontSize="14" HorizontalOptions="Center"/>
            </StackLayout>
        </Grid>
        <!-- PUSH-TO-TALK (PTT) OVERLAY -->
        <Grid x:Name="PttOverlay" Grid.RowSpan="3" BackgroundColor="#CC000000" IsVisible="False" ZIndex="2000" Padding="20">
            <StackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="15">
                <Image x:Name="PttIcon" Source="mic_icon.png" WidthRequest="60" HeightRequest="60" HorizontalOptions="Center" />

                <Label x:Name="PttStatusLabel" Text="Mic Open" TextColor="MediumSeaGreen" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center"/>

                <!-- Explicit Text Notification -->
                <Label x:Name="PttSpeakerLabel" Text="You can now speak to the group." TextColor="White" FontSize="16" HorizontalOptions="Center"/>

                <!-- 30-Second Countdown Timer -->
                <Label x:Name="PttCountdownLabel" Text="Closing in 30s..." TextColor="LightCoral" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" IsVisible="False"/>
            </StackLayout>
        </Grid>

        <!-- FULL SCREEN LOCATION DISABLED OVERLAY -->
        <Grid x:Name="LocationDisabledOverlay" Grid.Row="0" Grid.RowSpan="2" BackgroundColor="#E6000000" IsVisible="False" InputTransparent="False" ZIndex="1000">
            <StackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="20" Padding="30">
                <Label Text="📍" FontSize="80" HorizontalTextAlignment="Center"/>
                <Label Text="Location Services Disabled" TextColor="White" FontSize="24" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                <Label Text="SpeedyCompass requires your location to track your ride. Please enable GPS and location permissions to continue." TextColor="LightGray" FontSize="16" HorizontalTextAlignment="Center"/>

                <Button Text="Open Settings" 
                        BackgroundColor="DodgerBlue" 
                        TextColor="White" 
                        CornerRadius="8" 
                        HeightRequest="50" 
                        FontAttributes="Bold" 
                        Clicked="OnOpenSettingsClicked" 
                        Margin="0,20,0,0"/>

                <Button Text="I've Enabled It (Retry)" 
                        BackgroundColor="MediumSeaGreen" 
                        TextColor="White" 
                        CornerRadius="8" 
                        HeightRequest="50" 
                        FontAttributes="Bold" 
                        Clicked="OnRetryLocationClicked"/>
            </StackLayout>
        </Grid>
    </Grid>
</ContentPage>