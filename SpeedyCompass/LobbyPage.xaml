<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                 xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
                 xmlns:controls="clr-namespace:SpeedyCompass.Controls"
                 xmlns:local="clr-namespace:SpeedyCompass"
                 x:Class="SpeedyCompass.LobbyPage"
                 x:Name="ThisPage"
                 Title="Ride Lobby">
    <Grid RowDefinitions="Auto, *">

        <!-- ===================================================================== -->
        <!-- 1. MODERN HEADER & SEGMENTED TAB BAR -->
        <!-- ===================================================================== -->
        <Grid Grid.Row="0" ZIndex="100" ColumnDefinitions="Auto, *, Auto" BackgroundColor="{AppThemeBinding Light=White, Dark=#121212}" Padding="15,10,15,15" RowDefinitions="Auto, Auto">
            <Grid.Shadow>
                <Shadow Brush="Black" Offset="0,4" Opacity="0.05" Radius="10"/>
            </Grid.Shadow>

            <!-- Top Row: Title & Leave Button -->
            <Label Grid.Row="0" Grid.Column="0" Text="{Binding Source={x:Reference GroupNameLabel}, Path=Text}" FontSize="22" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#111, Dark=White}" VerticalOptions="Center"/>

            <StackLayout Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="10">
                <Button x:Name="AdminSettingsBtn" Text="⚙️" BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#2A2A2A}" CornerRadius="18" WidthRequest="36" HeightRequest="36" Padding="0" IsVisible="False" Clicked="OnAdminSettingsClicked" />
                <Button Text="Leave" BackgroundColor="#FFEBEB" TextColor="#D32F2F" CornerRadius="18" HeightRequest="36" Padding="15,0" Clicked="OnLeaveGroupClicked" FontAttributes="Bold"/>
            </StackLayout>

            <!-- Bottom Row: Segmented Toggle -->
            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,15,0,0" StrokeThickness="1" Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#1E1E1E}" HeightRequest="45">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22.5" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="*,*">
                    <Button x:Name="TabRoster" Grid.Column="0" Text="Roster" Clicked="OnTabClicked" CornerRadius="22" BackgroundColor="DodgerBlue" TextColor="White" FontAttributes="Bold" Margin="2"/>
                    <Grid Grid.Column="1" Margin="2">
                        <Button x:Name="TabMap" Text="Live Map" Clicked="OnTabClicked" CornerRadius="22" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#666, Dark=#AAA}" FontAttributes="Bold" HorizontalOptions="Fill" VerticalOptions="Fill"/>
                        <Ellipse x:Name="MapTabStatusDot" WidthRequest="10" HeightRequest="10" Fill="Orange" HorizontalOptions="End" VerticalOptions="Start" Margin="10,8"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ===================================================================== -->
        <!-- 2. ROSTER VIEW TAB -->
        <!-- ===================================================================== -->
        <ScrollView x:Name="RosterView" Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="15">

                <!-- Connection Status -->
                <StackLayout Orientation="Horizontal" HorizontalOptions="Center" Spacing="8" Margin="0,0,0,5">
                    <BoxView x:Name="StatusDot" WidthRequest="10" HeightRequest="10" CornerRadius="5" BackgroundColor="Orange" VerticalOptions="Center"/>
                    <Label x:Name="StatusLabel" Text="Connecting..." VerticalOptions="Center" FontSize="13" FontAttributes="Bold" TextColor="Gray"/>
                </StackLayout>

                <!-- ADMIN ONLY: SECURE CONVOY PIN CARD -->
                <Border x:Name="AdminPinCard" IsVisible="False" StrokeThickness="0" Margin="0,0,0,10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0066CC" Offset="0.0" />
                            <GradientStop Color="#003399" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#0066CC" Offset="0,6" Opacity="0.3" Radius="12" />
                    </Border.Shadow>

                    <Grid ColumnDefinitions="*, Auto" Padding="20">
                        <StackLayout Grid.Column="0" VerticalOptions="Center" Spacing="0">
                            <Label Text="CONVOY PIN" FontSize="11" FontAttributes="Bold" TextColor="#AADDFF" CharacterSpacing="1"/>
                            <Label Text="{Binding ConvoyPin}" FontSize="32" FontAttributes="Bold" TextColor="White" CharacterSpacing="4"/>
                            <Label Text="Share this with riders to join" FontSize="12" TextColor="#AADDFF" Margin="0,2,0,0"/>
                        </StackLayout>
                        <Button Grid.Column="1" Text="📋 Copy" BackgroundColor="#33FFFFFF" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="45" Padding="15,0" Clicked="OnCopyPinClicked" VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- Hidden Label to satisfy existing bindings -->
                <Label x:Name="GroupNameLabel" IsVisible="False"/>

                <!-- Pending Destination (Syncs with Search) -->
                <Border x:Name="PendingDestinationFrame" StrokeThickness="1.5" Stroke="DarkOrange" BackgroundColor="{AppThemeBinding Light=#FFF3E0, Dark=#2D1A00}" IsVisible="False" Margin="0,0,0,10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <StackLayout Padding="20">
                        <Label Text="Target Destination" FontSize="12" TextColor="DarkOrange" FontAttributes="Bold" CharacterSpacing="1"/>
                        <Label x:Name="PendingDestinationLabel" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333, Dark=White}" Margin="0,5,0,15"/>
                        <Button x:Name="StartJourneyButton" Text="🚀 Start Navigation" BackgroundColor="DarkOrange" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="50" IsVisible="False" Clicked="OnStartJourneyClicked" />
                    </StackLayout>
                </Border>

                <!-- Roster List -->
                <Label Text="CONVOY MEMBERS" FontSize="12" FontAttributes="Bold" TextColor="Gray" CharacterSpacing="1" Margin="5,10,0,0"/>

                <CollectionView x:Name="RidersCollectionView" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="local:Rider">
                            <Border StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" Margin="0,0,0,10">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14"/>
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="Black" Offset="0,2" Opacity="0.05" Radius="6"/>
                                </Border.Shadow>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRiderTapped" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="15" Padding="15">
                                    <Ellipse Grid.Column="0" WidthRequest="12" HeightRequest="12" VerticalOptions="Center" StrokeThickness="0">
                                        <Ellipse.Triggers>
                                            <DataTrigger TargetType="Ellipse" Binding="{Binding IsOnline}" Value="True">
                                                <Setter Property="Fill" Value="MediumSeaGreen" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Ellipse" Binding="{Binding IsOnline}" Value="False">
                                                <Setter Property="Fill" Value="Red" />
                                            </DataTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>

                                    <Label Text="{Binding Name}" Grid.Column="1" VerticalOptions="Center" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#222, Dark=White}"/>

                                    <Border Grid.Column="2" BackgroundColor="{Binding RoleColor}" StrokeThickness="0" Padding="10,5">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8"/>
                                        </Border.StrokeShape>
                                        <Label Text="{Binding RoleDisplay}" TextColor="White" FontSize="11" FontAttributes="Bold" CharacterSpacing="1"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <!-- ===================================================================== -->
        <!-- 3. LIVE MAP TAB -->
        <!-- ===================================================================== -->
        <Grid x:Name="MapView" Grid.Row="1" IsVisible="False">

            <controls:CustomMap x:Name="LiveMap" Grid.Row="0" Grid.RowSpan="2" MapClicked="OnMapClicked" IsShowingUser="False" CustomPins="{Binding MapPins, Source={x:Reference ThisPage}}" />

            <!-- FLOATING MAP CONTROLS -->
            <VerticalStackLayout x:Name="FloatingMapControls" Grid.Row="1" IsVisible="False" HorizontalOptions="End" VerticalOptions="End" Margin="0, 0, 15, 180" Spacing="15" ZIndex="30">
                <Button x:Name="ClearPoisBtn" 
                        IsVisible="False"
                        Text="🧹 Clear POIs" 
                        BackgroundColor="#D32F2F" 
                        TextColor="White" 
                        CornerRadius="25" 
                        HeightRequest="50"
                        WidthRequest="120"
                        FontAttributes="Bold"
                        FontSize="12"
                        Margin="0,0,0,10"
                        Clicked="OnClearPoisClicked">
                    <Button.Shadow>
                        <Shadow Brush="Black" Offset="0,4" Opacity="0.3" Radius="5" />
                    </Button.Shadow>
                </Button>
                <!-- NEW: SIMULATION SPEED SLIDER (Hidden by default, enabled by C# #if DEBUG) -->
                <Frame x:Name="SimSpeedFrame" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" Padding="0" CornerRadius="10" IsVisible="False" HasShadow="True" WidthRequest="40" HeightRequest="150" HorizontalOptions="Center">
                    <Slider x:Name="SimSpeedSlider" Minimum="0" Maximum="140" Value="60" Rotation="-90" VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="130" ValueChanged="OnSimSpeedSliderChanged" MinimumTrackColor="DodgerBlue" />
                </Frame>
                <Button x:Name="HeadingUpButton" Text="🧭" FontSize="24" BackgroundColor="{AppThemeBinding Light=White, Dark=#333333}" TextColor="DodgerBlue" CornerRadius="27" WidthRequest="55" HeightRequest="55" Clicked="OnHeadingUpClicked" Shadow="{Shadow Brush=Black, Offset='0,4', Opacity=0.2, Radius=8}" />
                <Button x:Name="RecenterMapButton" Text="🎯" FontSize="24" BackgroundColor="{AppThemeBinding Light=White, Dark=#333333}" TextColor="DodgerBlue" CornerRadius="27" WidthRequest="55" HeightRequest="55" Clicked="OnRecenterMapClicked" Shadow="{Shadow Brush=Black, Offset='0,4', Opacity=0.2, Radius=8}" />
                <Button x:Name="MapFollowButton" Text="📍" FontSize="24" BackgroundColor="{AppThemeBinding Light=White, Dark=#333333}" TextColor="MediumSeaGreen" CornerRadius="27" WidthRequest="55" HeightRequest="55" Clicked="OnMapFollowClicked" IsVisible="False" Shadow="{Shadow Brush=Black, Offset='0,4', Opacity=0.2, Radius=8}" />
                <Button x:Name="OverviewButton" Text="🗺️" FontSize="24" BackgroundColor="{AppThemeBinding Light=White, Dark=#333333}" TextColor="DodgerBlue" CornerRadius="27" WidthRequest="55" HeightRequest="55" Clicked="OnOverviewClicked" Shadow="{Shadow Brush=Black, Offset='0,4', Opacity=0.2, Radius=8}" />
            </VerticalStackLayout>

            <!-- STREAMING_CHUNK: Bottom Swipeable Drawer -->
            <!-- ========================================== -->
            <!-- 2. SCROLLABLE BOTTOM SHEET DRAWER -->
            <!-- ========================================== -->
            <Border x:Name="ActionDrawer" 
                Grid.Row="1"
                IsVisible="False"
                VerticalOptions="End" 
                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                StrokeThickness="0"
                Margin="0,0,0,-40"
                ZIndex="40">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,-4" Opacity="0.15" Radius="15" />
                </Border.Shadow>

                <Grid RowDefinitions="Auto, Auto, Auto, *">

                    <!-- ============================================================== -->
                    <!-- NEW: STICKY TELEMETRY HEADER (Always visible in Peek State)    -->
                    <!-- ============================================================== -->
                    <Grid Grid.Row="0" ColumnDefinitions="*, *, *, *" Padding="10,10,10,5" BackgroundColor="Transparent">
                        <Grid.GestureRecognizers>
                            <!-- Tapping the numbers themselves will also expand/collapse the drawer -->
                            <TapGestureRecognizer Tapped="OnDrawerHandleTapped" />
                            <PanGestureRecognizer PanUpdated="OnDrawerPanUpdated" />
                        </Grid.GestureRecognizers>

                        <!-- Metric 1: Speed & Limit -->
                        <StackLayout Grid.Column="0" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Text="Speed" FontSize="10" TextColor="Gray" HorizontalOptions="Center" FontAttributes="Bold" TextTransform="Uppercase"/>
                            <StackLayout Orientation="Horizontal" Spacing="4" HorizontalOptions="Center">
                                <Label x:Name="MySpeedLabel" Text="0" FontSize="18" FontAttributes="Bold" TextColor="DodgerBlue" VerticalOptions="Center"/>
                                <!-- NEW: The Speed Limit Badge -->
                                <Border x:Name="SpeedLimitBadge" IsVisible="False" BackgroundColor="White" Stroke="Red" StrokeThickness="2" WidthRequest="22" HeightRequest="22" VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="4"/>
                                    </Border.StrokeShape>
                                    <Label x:Name="SpeedLimitLabel" Text="60" TextColor="Black" FontSize="9" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                            </StackLayout>
                        </StackLayout>

                        <!-- Metric 2: Covered -->
                        <StackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Text="Covered" FontSize="10" TextColor="Gray" HorizontalOptions="Center" FontAttributes="Bold" TextTransform="Uppercase"/>
                            <Label x:Name="MyTotalTraveledLabel" Text="0.0 km" FontSize="18" FontAttributes="Bold" TextColor="DarkOrange" HorizontalOptions="Center"/>
                        </StackLayout>

                        <!-- Metric 3: Remaining & ETA -->
                        <StackLayout Grid.Column="2" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Text="Remaining" FontSize="10" TextColor="Gray" HorizontalOptions="Center" FontAttributes="Bold" TextTransform="Uppercase"/>
                            <Label x:Name="MyDistanceLabel" Text="-- km" FontSize="18" FontAttributes="Bold" TextColor="MediumSeaGreen" HorizontalOptions="Center" Margin="0,0,0,-4"/>
                            <!-- NEW: The ETA Tracker -->
                            <Label x:Name="MyEtaLabel" Text="ETA --:--" FontSize="10" FontAttributes="Bold" TextColor="DarkOrange" HorizontalOptions="Center" IsVisible="False"/>
                        </StackLayout>
                        <!-- Metric 4: Total Route -->
                        <StackLayout Grid.Column="3" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Text="Total Dist" FontSize="10" TextColor="Gray" HorizontalOptions="Center" FontAttributes="Bold" TextTransform="Uppercase"/>
                            <Label x:Name="MyTotalRouteLabel" Text="-- km" FontSize="18" FontAttributes="Bold" TextColor="MediumPurple" HorizontalOptions="Center"/>
                        </StackLayout>
                    </Grid>

                    <!-- DRAG HANDLE AREA -->
                    <Grid Grid.Row="1" Padding="0,5,0,15" BackgroundColor="Transparent">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDrawerHandleTapped" />
                            <PanGestureRecognizer PanUpdated="OnDrawerPanUpdated" />
                        </Grid.GestureRecognizers>
                        <BoxView HeightRequest="5" WidthRequest="40" CornerRadius="2.5" BackgroundColor="LightGray" HorizontalOptions="Center" />
                    </Grid>

                    <!-- DRAWER TABS (Removed the "My Ride" tab since it's always at the top now!) -->
                    <Grid Grid.Row="2" ColumnDefinitions="*, *, *, *" Margin="10,0,10,10">
                        <Button x:Name="TabActionsBtn" Grid.Column="0" Text="Safety" BackgroundColor="DodgerBlue" TextColor="White" CornerRadius="20" Margin="2" Clicked="OnDrawerTabClicked" />
                        <Button x:Name="TabStatsBtn" Grid.Column="1" Text="Convoy" BackgroundColor="Transparent" TextColor="Gray" CornerRadius="20" Margin="2" Clicked="OnDrawerTabClicked" />
                        <!-- NEW: Map Settings Tab -->
                        <Button x:Name="TabMapSettingsBtn" Grid.Column="2" Text="Map" BackgroundColor="Transparent" TextColor="Gray" CornerRadius="20" Margin="2" Clicked="OnDrawerTabClicked" />
                        <Button x:Name="TabAdminBtn" Grid.Column="3" Text="Admin" BackgroundColor="Transparent" TextColor="Gray" CornerRadius="20" Margin="2" Clicked="OnDrawerTabClicked" />
                    </Grid>

                    <!-- SCROLLABLE CONTENT AREA -->
                    <ScrollView Grid.Row="3" Padding="20,10,20,50">
                        <Grid>
                            <!-- TAB 1: SAFETY & ACTIONS -->
                            <VerticalStackLayout x:Name="DrawerActionsTab" Spacing="15">
                                <!-- 1. PTT (PRIMARY COMMS) -->
                                <Border HeightRequest="80" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#2C3E50, Dark=#1A1C1E}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20" />
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Offset="0,6" Opacity="0.2" Radius="10" />
                                    </Border.Shadow>
                                    <Grid ColumnDefinitions="Auto, *, Auto" Padding="20,0">
                                        <Frame Grid.Column="0" WidthRequest="45" HeightRequest="45" CornerRadius="22.5" BackgroundColor="#27AE60" HasShadow="False" Padding="0" VerticalOptions="Center">
                                            <Label Text="🎤" HorizontalOptions="Center" VerticalOptions="Center" FontSize="20"/>
                                        </Frame>
                                        <StackLayout Grid.Column="1" VerticalOptions="Center" Margin="15,0,0,0" Spacing="2">
                                            <Label Text="PUSH TO TALK" FontSize="18" FontAttributes="Bold" TextColor="White" />
                                            <Label Text="Global Convoy Channel" FontSize="12" TextColor="#B0BEC5" />
                                        </StackLayout>
                                        <BoxView Grid.Column="2" WidthRequest="10" HeightRequest="10" CornerRadius="5" BackgroundColor="#27AE60" VerticalOptions="Center"/>
                                    </Grid>
                                </Border>

                                <!-- 2. UTILITY ROW (REFUEL / REST) -->
                                <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                                    <Border Grid.Column="0" HeightRequest="70" StrokeThickness="1" Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="16"/>
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnRefuelStopClicked" />
                                        </Border.GestureRecognizers>
                                        <StackLayout Orientation="Horizontal" HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                                            <Label Text="⛽" FontSize="22" VerticalOptions="Center"/>
                                            <Label Text="Refuel" FontSize="17" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333333, Dark=White}" VerticalOptions="Center"/>
                                        </StackLayout>
                                    </Border>
                                    <Border Grid.Column="1" HeightRequest="70" StrokeThickness="1" Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="16"/>
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnRestStopClicked" />
                                        </Border.GestureRecognizers>
                                        <StackLayout Orientation="Horizontal" HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                                            <Label Text="☕" FontSize="22" VerticalOptions="Center"/>
                                            <Label Text="Rest" FontSize="17" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333333, Dark=White}" VerticalOptions="Center"/>
                                        </StackLayout>
                                    </Border>
                                </Grid>

                                <!-- 3. EMERGENCY STOP -->
                                <Border HeightRequest="70" StrokeThickness="0">
                                    <Border.Background>
                                        <LinearGradientBrush EndPoint="1,0">
                                            <GradientStop Color="#D32F2F" Offset="0.0" />
                                            <GradientStop Color="#C62828" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16"/>
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnEmergencyStopClicked" />
                                    </Border.GestureRecognizers>
                                    <Border.Shadow>
                                        <Shadow Brush="Red" Offset="0,4" Opacity="0.25" Radius="10" />
                                    </Border.Shadow>
                                    <StackLayout Orientation="Horizontal" HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                                        <Label Text="⚠️" FontSize="22" VerticalOptions="Center"/>
                                        <Label Text="EMERGENCY STOP" FontSize="18" FontAttributes="Bold" TextColor="White" VerticalOptions="Center" CharacterSpacing="1"/>
                                    </StackLayout>
                                </Border>

                                <!-- 4. OPEN NATIVE GPS -->
                                <Border x:Name="StartNavButton" HeightRequest="65" StrokeThickness="1.5" Stroke="#0F9D58" BackgroundColor="{AppThemeBinding Light=#F1FAF4, Dark=#15261B}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16"/>
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnLaunchNativeNavClicked" />
                                    </Border.GestureRecognizers>
                                    <StackLayout Orientation="Horizontal" HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                                        <Label Text="🗺️" FontSize="20" VerticalOptions="Center"/>
                                        <Label Text="OPEN NATIVE GPS" FontSize="16" FontAttributes="Bold" TextColor="#0F9D58" VerticalOptions="Center" CharacterSpacing="1"/>
                                    </StackLayout>
                                </Border>
                            </VerticalStackLayout>

                            <!-- TAB 2: TELEMETRY -->
                            <VerticalStackLayout x:Name="DrawerStatsTab" IsVisible="False" Spacing="15">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Live Convoy Spread" VerticalOptions="Center" FontAttributes="Bold" FontSize="18" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                                    <Button Grid.Column="1" Text="Refresh" BackgroundColor="DodgerBlue" TextColor="White" CornerRadius="10" HeightRequest="35" FontAttributes="Bold" Clicked="OnRefreshTelemetryClicked" />
                                </Grid>
                                <CollectionView x:Name="TelemetryCollectionView" HeightRequest="250">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Frame CornerRadius="10" Padding="12" Margin="0,0,0,10" BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2A2A2A}" HasShadow="False" BorderColor="Transparent">
                                                <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                                                    <Label Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontAttributes="Bold" FontSize="16" TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                                                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding SpeedDisplay}" FontAttributes="Bold" TextColor="DodgerBlue" FontSize="16" />
                                                    <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding StatusDisplay}" TextColor="{Binding StatusColor}" FontSize="14" FontAttributes="Bold" Margin="0,4,0,0" />
                                                </Grid>
                                            </Frame>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>

                            <!-- TAB 3: ADMIN CONTROLS -->
                            <VerticalStackLayout x:Name="DrawerAdminTab" IsVisible="False" Spacing="15">
                                <Label Text="Ride Management" FontAttributes="Bold" FontSize="18" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>

                                <Button x:Name="PauseNavBtn" Text="⏸ Pause Ride" BackgroundColor="Goldenrod" TextColor="White" HeightRequest="55" CornerRadius="15" FontAttributes="Bold" Clicked="OnPauseNavClicked" />
                                <Button x:Name="ResumeNavBtn" Text="▶️ Resume Ride" IsVisible="False" BackgroundColor="MediumSeaGreen" TextColor="White" HeightRequest="55" CornerRadius="15" FontAttributes="Bold" Clicked="OnResumeJourneyClicked" />
                                <Button x:Name="MeetupPointBtn" Text="📍 Generate Meetup Point" BackgroundColor="DarkViolet" TextColor="White" HeightRequest="55" CornerRadius="15" FontAttributes="Bold" Clicked="OnGenerateMeetupClicked" />
                                <Button Text="⚙️ Group Settings" BackgroundColor="DimGray" TextColor="White" HeightRequest="55" CornerRadius="15" FontAttributes="Bold" Clicked="OnAdminSettingsClicked" />
                                <Button x:Name="CompleteNavBtn" Text="🏁 Finish Route" BackgroundColor="Crimson" TextColor="White" HeightRequest="55" CornerRadius="15" FontAttributes="Bold" Clicked="OnCompleteNavClicked" />
                            </VerticalStackLayout>
                            <!-- TAB 4: MAP SETTINGS -->
                            <VerticalStackLayout x:Name="DrawerMapSettingsTab" IsVisible="False" Spacing="15">
                                <Label Text="Map &amp; Navigation" FontAttributes="Bold" FontSize="18" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>

                                <!-- Map Type Selector -->
                                <StackLayout Spacing="5">
                                    <Label Text="Map Style" FontAttributes="Bold" FontSize="14"/>
                                    <Border StrokeThickness="1" Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#1E1E1E}" HeightRequest="45">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="22.5" />
                                        </Border.StrokeShape>
                                        <Grid ColumnDefinitions="*,*,*">
                                            <Button x:Name="MapStyleStreetBtn" Grid.Column="0" Text="Street" Clicked="OnMapStyleClicked" CornerRadius="20" BackgroundColor="DodgerBlue" TextColor="White" FontSize="12" FontAttributes="Bold" Margin="2"/>
                                            <Button x:Name="MapStyleSatBtn" Grid.Column="1" Text="Satellite" Clicked="OnMapStyleClicked" CornerRadius="20" BackgroundColor="Transparent" TextColor="Gray" FontSize="12" FontAttributes="Bold" Margin="2"/>
                                            <Button x:Name="MapStyleTerBtn" Grid.Column="2" Text="Hybrid" Clicked="OnMapStyleClicked" CornerRadius="20" BackgroundColor="Transparent" TextColor="Gray" FontSize="12" FontAttributes="Bold" Margin="2"/>
                                        </Grid>
                                    </Border>
                                </StackLayout>

                                <!-- Layers & Overlays -->
                                <StackLayout Spacing="10" Margin="0,10,0,0">
                                    <Label Text="Layers &amp; Context" FontAttributes="Bold" FontSize="14"/>
                                    <Grid ColumnDefinitions="*, Auto">
                                        <Label Text="Live Traffic Layer" VerticalOptions="Center"/>
                                        <Switch x:Name="TrafficSwitch" Grid.Column="1" OnColor="MediumSeaGreen" Toggled="OnMapSettingChanged" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*, Auto">
                                        <Label Text="Speed Limit Alerts" VerticalOptions="Center"/>
                                        <Switch x:Name="SpeedLimitSwitch" Grid.Column="1" OnColor="MediumSeaGreen" Toggled="OnMapSettingChanged" />
                                    </Grid>
                                </StackLayout>

                                <!-- Camera Physics -->
                                <StackLayout Spacing="10" Margin="0,10,0,0">
                                    <Label Text="Camera Physics" FontAttributes="Bold" FontSize="14"/>
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackLayout Grid.Column="0" VerticalOptions="Center">
                                            <Label Text="Speed-Based Auto-Zoom" />
                                            <Label Text="Zooms out on highways, in on streets." FontSize="11" TextColor="Gray"/>
                                        </StackLayout>
                                        <Switch x:Name="AutoZoomSwitch" Grid.Column="1" OnColor="MediumSeaGreen" Toggled="OnMapSettingChanged" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackLayout Grid.Column="0" VerticalOptions="Center">
                                            <Label Text="Auto-Tilt (3D Horizon)" />
                                            <Label Text="Tilts map at high speeds for visibility." FontSize="11" TextColor="Gray"/>
                                        </StackLayout>
                                        <Switch x:Name="AutoTiltSwitch" Grid.Column="1" OnColor="MediumSeaGreen" Toggled="OnMapSettingChanged" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackLayout Grid.Column="0" VerticalOptions="Center">
                                            <Label Text="Voice Navigation" />
                                            <Label Text="Enables/Disables map navigation instructions" FontSize="11" TextColor="Gray"/>
                                        </StackLayout>
                                        <Switch x:Name="VoiceNavSwitch" Grid.Column="1" OnColor="MediumSeaGreen" Toggled="OnMapSettingChanged" />
                                    </Grid>
                                </StackLayout>
                            </VerticalStackLayout>
                        </Grid>
                    </ScrollView>
                </Grid>
            </Border>

            <!-- OVERLAYS: Admin Search UI -->
            <Grid x:Name="AdminSearchUI" ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" Margin="20,20,20,10" VerticalOptions="Start" IsVisible="False" ZIndex="20">
                <Border Grid.Row="0" Grid.Column="0" Padding="0" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="25"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,4" Opacity="0.1" Radius="10"/>
                    </Border.Shadow>
                    <SearchBar x:Name="DestinationSearchBar" TextChanged="OnSearchTextChanged" Placeholder="Search destination..." SearchButtonPressed="OnSearchPressed" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                </Border>

                <Border x:Name="SuggestionsFrame" Grid.Row="1" Grid.ColumnSpan="2" VerticalOptions="Start" Margin="0,10,0,15" Padding="0" StrokeThickness="0" IsVisible="False" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,4" Opacity="0.1" Radius="10"/>
                    </Border.Shadow>
                    <ListView x:Name="SuggestionsListView" SelectionMode="Single" ItemSelected="OnSuggestionSelected" BackgroundColor="Transparent" SeparatorColor="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" MaximumHeightRequest="250">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <StackLayout Padding="15,12">
                                        <Label Text="{Binding Description}" TextColor="{AppThemeBinding Light=#333333, Dark=#E0E0E0}" FontSize="15" LineBreakMode="TailTruncation"/>
                                    </StackLayout>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
                <Button x:Name="ConfirmDestButton" Grid.Row="0" Grid.Column="1" Text="✔️" Clicked="OnConfirmDestinationClicked" Margin="10,0,0,0" WidthRequest="50" HeightRequest="50" CornerRadius="25" BackgroundColor="MediumSeaGreen" TextColor="White" FontAttributes="Bold" IsEnabled="False" VerticalOptions="Center" Shadow="{Shadow Brush=Black, Offset='0,4', Opacity=0.2, Radius=8}"/>
                <Button x:Name="ResetDestButton" Grid.Row="0" Grid.Column="1" Text="✖️" IsVisible="False" Clicked="OnResetDestinationClicked" Margin="10,0,0,0" WidthRequest="50" HeightRequest="50" CornerRadius="25" BackgroundColor="Red" TextColor="White" FontAttributes="Bold" VerticalOptions="Center" Shadow="{Shadow Brush=Black, Offset='0,4', Opacity=0.2, Radius=8}"/>
            </Grid>

            <Border x:Name="AdminInstructionBanner" VerticalOptions="Start" HorizontalOptions="Center" Margin="0,90,0,0" Padding="20,10" StrokeThickness="0" BackgroundColor="#E6000000" IsVisible="False" ZIndex="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <Label Text="Search above to set the Convoy destination" TextColor="White" FontAttributes="Bold" FontSize="13"/>
            </Border>
        </Grid>

        <!-- OVERLAYS -->
        <Grid x:Name="SensoryAlertOverlay" Grid.Row="0" Grid.RowSpan="2" BackgroundColor="Red" Opacity="0" IsVisible="False" InputTransparent="True" ZIndex="999">
            <StackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
                <Label x:Name="AlertIconLabel" Text="🛑" FontSize="100" HorizontalTextAlignment="Center" />
                <Label x:Name="AlertTitleLabel" Text="EMERGENCY STOP!" TextColor="White" FontSize="36" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                <Label x:Name="AlertSenderLabel" Text="Triggered by: You" TextColor="White" FontSize="20" HorizontalTextAlignment="Center" />
            </StackLayout>
        </Grid>

        <Grid x:Name="PttOverlay" Grid.RowSpan="2" BackgroundColor="#E6000000" IsVisible="False" ZIndex="2000" Padding="20">
            <StackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="15">
                <Label Text="🎤" FontSize="80" HorizontalOptions="Center" />
                <Label x:Name="PttStatusLabel" Text="Mic Open" TextColor="MediumSeaGreen" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center" CharacterSpacing="1"/>
                <Label x:Name="PttSpeakerLabel" Text="You can now speak to the group." TextColor="White" FontSize="16" HorizontalOptions="Center"/>
                <Label x:Name="PttCountdownLabel" Text="Closing in 30s..." TextColor="LightCoral" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" IsVisible="False"/>
            </StackLayout>
        </Grid>

        <Grid x:Name="LocationDisabledOverlay" Grid.Row="0" Grid.RowSpan="2" BackgroundColor="#F2000000" IsVisible="False" InputTransparent="False" ZIndex="1000">
            <StackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="20" Padding="30">
                <Label Text="📍" FontSize="80" HorizontalTextAlignment="Center"/>
                <Label Text="Location Required" TextColor="White" FontSize="24" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                <Label Text="SpeedyCompass requires your location to track your ride. Please enable GPS and location permissions to continue." TextColor="LightGray" FontSize="16" HorizontalTextAlignment="Center"/>
                <Button Text="Open Settings" BackgroundColor="DodgerBlue" TextColor="White" CornerRadius="12" HeightRequest="50" FontAttributes="Bold" Clicked="OnOpenSettingsClicked" Margin="0,20,0,0"/>
                <Button Text="I've Enabled It (Retry)" BackgroundColor="MediumSeaGreen" TextColor="White" CornerRadius="12" HeightRequest="50" FontAttributes="Bold" Clicked="OnRetryLocationClicked"/>
            </StackLayout>
        </Grid>

        <Grid x:Name="AdminSettingsOverlay" Grid.RowSpan="2" BackgroundColor="#CC000000" IsVisible="False" ZIndex="2500" Padding="20">
            <Border Margin="20" VerticalOptions="Center" MaximumHeightRequest="600" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" Padding="25">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="25"/>
                </Border.StrokeShape>

                <!-- THE FIX: Header, ScrollView, and Buttons are now DIRECT children of this Grid -->
                <Grid RowDefinitions="Auto, *, Auto" RowSpacing="20">

                    <!-- HEADER (Row 0) -->
                    <VerticalStackLayout Grid.Row="0" Spacing="5">
                        <Label Text="Convoy Settings" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center"/>
                        <Label Text="Adjust live telemetry rules." FontSize="13" TextColor="Gray" HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                    <!-- SCROLLABLE CONTENT (Row 1 - The '*' ensures it takes exactly the remaining space) -->
                    <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Always">
                        <VerticalStackLayout Spacing="15" Padding="0,5,15,5">

                            <StackLayout Spacing="5">
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label Text="Max Lag Distance" FontAttributes="Bold" VerticalOptions="Center"/>
                                    <Label x:Name="LagValueLabel" Grid.Column="1" Text="500m" TextColor="DodgerBlue" FontAttributes="Bold"/>
                                </Grid>
                                <Label Text="Alerts the Lead if a rider falls this far behind." FontSize="11" TextColor="Gray"/>
                                <Slider x:Name="LagSlider" Minimum="100" Maximum="2000" Value="500" ValueChanged="OnLagSliderChanged" MinimumTrackColor="DodgerBlue"/>
                            </StackLayout>

                            <StackLayout Spacing="5">
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label Text="Splinter Warning" FontAttributes="Bold" VerticalOptions="Center"/>
                                    <Label x:Name="SplinterValueLabel" Grid.Column="1" Text="2000m" TextColor="Orange" FontAttributes="Bold"/>
                                </Grid>
                                <Label Text="Alerts if the convoy stretches too far from front to back." FontSize="11" TextColor="Gray"/>
                                <Slider x:Name="SplinterSlider" Minimum="500" Maximum="5000" Value="2000" ValueChanged="OnSplinterSliderChanged" MinimumTrackColor="Orange"/>
                            </StackLayout>

                            <StackLayout Spacing="5">
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label Text="Max Group Size" FontAttributes="Bold" VerticalOptions="Center"/>
                                    <Label x:Name="SizeValueLabel" Grid.Column="1" Text="15 Riders" TextColor="MediumSeaGreen" FontAttributes="Bold"/>
                                </Grid>
                                <Label Text="Cap the total number of allowed riders." FontSize="11" TextColor="Gray"/>
                                <Slider x:Name="SizeSlider" Minimum="2" Maximum="20" Value="15" ValueChanged="OnSizeSliderChanged" MinimumTrackColor="MediumSeaGreen"/>
                            </StackLayout>

                            <StackLayout Spacing="5">
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label Text="Pitstop Reminder" FontAttributes="Bold" VerticalOptions="Center"/>
                                    <Label x:Name="PitstopValueLabel" Grid.Column="1" Text="100 km" TextColor="DodgerBlue" FontAttributes="Bold"/>
                                </Grid>
                                <Label Text="Voice reminder for a rest stop (0 to turn off)." FontSize="11" TextColor="Gray"/>
                                <Slider x:Name="PitstopSlider" Minimum="0" Maximum="300" Value="100" ValueChanged="OnPitstopSliderChanged" MinimumTrackColor="DodgerBlue"/>
                            </StackLayout>

                            <StackLayout Orientation="Horizontal" Spacing="10" Margin="0,5,0,5">
                                <Switch x:Name="DynamicRoutingSwitch" OnColor="MediumSeaGreen" IsToggled="True" VerticalOptions="Center"/>
                                <StackLayout VerticalOptions="Center">
                                    <Label Text="Dynamic Group Routing" FontAttributes="Bold" FontSize="14"/>
                                    <Label Text="Sync the Lead's route to the whole group." FontSize="12" TextColor="Gray"/>
                                </StackLayout>
                            </StackLayout>

                            <StackLayout Spacing="5">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Min Broadcast Distance" FontAttributes="Bold" FontSize="14"/>
                                    <Label x:Name="MinUpdateValueLabel" Grid.Column="1" Text="10m" FontAttributes="Bold" TextColor="DodgerBlue"/>
                                </Grid>
                                <Label Text="Updates at low speeds." FontSize="11" TextColor="Gray"/>
                                <Slider x:Name="MinUpdateSlider" Minimum="5" Maximum="50" Value="10" MinimumTrackColor="DodgerBlue" ValueChanged="OnMinUpdateSliderChanged"/>
                            </StackLayout>

                            <StackLayout Spacing="5">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Max Broadcast Distance" FontAttributes="Bold" FontSize="14"/>
                                    <Label x:Name="MaxUpdateValueLabel" Grid.Column="1" Text="100m" FontAttributes="Bold" TextColor="DodgerBlue"/>
                                </Grid>
                                <Label Text="Expands the update gap at high speeds to save battery." FontSize="11" TextColor="Gray"/>
                                <Slider x:Name="MaxUpdateSlider" Minimum="50" Maximum="500" Value="100" MinimumTrackColor="DodgerBlue" ValueChanged="OnMaxUpdateSliderChanged"/>
                            </StackLayout>

                        </VerticalStackLayout>
                    </ScrollView>

                    <!-- FOOTER BUTTONS (Row 2) -->
                    <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="15">
                        <Button Grid.Column="0" Text="Cancel" BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#333}" TextColor="{AppThemeBinding Light=#333, Dark=White}" FontAttributes="Bold" CornerRadius="12" HeightRequest="50" Clicked="OnCloseSettingsClicked"/>
                        <Button Grid.Column="1" Text="Save" BackgroundColor="MediumSeaGreen" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="50" Clicked="OnSaveSettingsClicked"/>
                    </Grid>

                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="LoadingOverlay" Grid.Row="0" Grid.RowSpan="2" BackgroundColor="#CC000000" IsVisible="False" InputTransparent="False" ZIndex="9999">
            <StackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="20">
                <ActivityIndicator IsRunning="{Binding Source={x:Reference LoadingOverlay}, Path=IsVisible}" Color="DodgerBlue" WidthRequest="60" HeightRequest="60" />
                <Label x:Name="LoadingText" Text="Calculating Route..." TextColor="White" FontAttributes="Bold" FontSize="18" HorizontalOptions="Center" />
            </StackLayout>
        </Grid>

        <Grid x:Name="RideSummaryOverlay" Grid.RowSpan="2" BackgroundColor="#E6000000" IsVisible="False" ZIndex="3000" Padding="20">
            <Border VerticalOptions="Center" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" Padding="25">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="25"/>
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="20">

                    <StackLayout Spacing="5" HorizontalOptions="Center">
                        <Label Text="🏁 Ride Complete!" FontSize="26" FontAttributes="Bold" HorizontalOptions="Center" TextColor="MediumSeaGreen"/>
                        <Label x:Name="SummaryDestLabel" Text="Target Destination" FontSize="16" TextColor="Gray" FontAttributes="Bold" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                    </StackLayout>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" Margin="0,5"/>

                    <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="*, *" RowSpacing="20" ColumnSpacing="15">

                        <!-- Distance -->
                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" HorizontalOptions="Center" Spacing="2">
                            <Label Text="TOTAL DISTANCE" FontSize="11" TextColor="Gray" FontAttributes="Bold" HorizontalOptions="Center"/>
                            <Label x:Name="SummaryDistLabel" Text="0.0 km" FontSize="22" FontAttributes="Bold" TextColor="DodgerBlue" HorizontalOptions="Center"/>
                        </VerticalStackLayout>

                        <!-- Moving Time -->
                        <VerticalStackLayout Grid.Row="0" Grid.Column="1" HorizontalOptions="Center" Spacing="2">
                            <Label Text="MOVING TIME" FontSize="11" TextColor="Gray" FontAttributes="Bold" HorizontalOptions="Center"/>
                            <Label x:Name="SummaryMovingTimeLabel" Text="00:00:00" FontSize="22" FontAttributes="Bold" TextColor="DodgerBlue" HorizontalOptions="Center"/>
                        </VerticalStackLayout>

                        <!-- Avg Speed -->
                        <VerticalStackLayout Grid.Row="1" Grid.Column="0" HorizontalOptions="Center" Spacing="2">
                            <Label Text="AVG SPEED" FontSize="11" TextColor="Gray" FontAttributes="Bold" HorizontalOptions="Center"/>
                            <Label x:Name="SummaryAvgSpeedLabel" Text="0.0 km/h" FontSize="22" FontAttributes="Bold" TextColor="MediumPurple" HorizontalOptions="Center"/>
                        </VerticalStackLayout>

                        <!-- Top Speed -->
                        <VerticalStackLayout Grid.Row="1" Grid.Column="1" HorizontalOptions="Center" Spacing="2">
                            <Label Text="TOP SPEED" FontSize="11" TextColor="Gray" FontAttributes="Bold" HorizontalOptions="Center"/>
                            <Label x:Name="SummaryTopSpeedLabel" Text="0.0 km/h" FontSize="22" FontAttributes="Bold" TextColor="DarkOrange" HorizontalOptions="Center"/>
                        </VerticalStackLayout>

                        <!-- Total Time -->
                        <VerticalStackLayout Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" HorizontalOptions="Center" Spacing="2">
                            <Label Text="TOTAL ELAPSED TIME (WITH STOPS)" FontSize="11" TextColor="Gray" FontAttributes="Bold" HorizontalOptions="Center"/>
                            <Label x:Name="SummaryTotalTimeLabel" Text="00:00:00" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333, Dark=White}" HorizontalOptions="Center"/>
                        </VerticalStackLayout>

                    </Grid>

                    <Button Text="Awesome!" BackgroundColor="MediumSeaGreen" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="50" Clicked="OnCloseRideSummaryClicked" Margin="0,15,0,0"/>

                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>