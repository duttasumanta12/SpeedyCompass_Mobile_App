<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             xmlns:controls="clr-namespace:SpeedyCompass.Controls"
             xmlns:local="clr-namespace:SpeedyCompass"
             xmlns:models="clr-namespace:SpeedyCompass.Models"
             x:Class="SpeedyCompass.LobbyPage"
             x:Name="ThisPage"
             Title="Ride Lobby"
             Shell.NavBarIsVisible="False"
             Shell.PresentationMode="ModalAnimated">

    <!-- UPGRADE: Centralized Animation Styles for interactive map elements -->
    <ContentPage.Resources>
        <Style TargetType="Border" x:Key="FloatingBtnStyle">
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="Scale" Value="1.0" />
                                <Setter Property="Opacity" Value="1.0" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="Scale" Value="0.92" />
                                <Setter Property="Opacity" Value="0.8" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentPage.Resources>

    <Grid>
        <!-- Hidden Label to satisfy existing C# bindings -->
        <Label x:Name="GroupNameLabel" IsVisible="False"/>

        <!-- ===================================================================== -->
        <!-- ALWAYS VISIBLE MAP LAYER                                              -->
        <!-- ===================================================================== -->
        <controls:CustomMap x:Name="LiveMap" MapClicked="OnMapClicked" IsShowingUser="False" CustomPins="{Binding MapPins, Source={x:Reference ThisPage}}" Margin="0,0,0,140" ZIndex="0" />

        <!-- Pin Overlay -->
        <AbsoluteLayout x:Name="PinOverlayLayout" 
                        InputTransparent="True" 
                        CascadeInputTransparent="True" 
                        ZIndex="10" 
                        BindableLayout.ItemsSource="{Binding MapPins, Source={x:Reference ThisPage}}" 
                        Margin="0,0,0,160">
            <BindableLayout.ItemTemplate>
                <DataTemplate>
                    <controls:MapPinView AbsoluteLayout.LayoutBounds="0,0,-1,-1"
                                         TranslationX="{Binding ScreenX}"
                                         TranslationY="{Binding ScreenY}"
                                         Username="{Binding Username}"
                                         Speed="{Binding Speed}"
                                         BatteryLevel="{Binding BatteryLevel}"
                                         PinColor="{Binding PinColor}" />
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </AbsoluteLayout>

        <!-- Search Bar -->
        <controls:DestinationSearchView x:Name="DestinationSearchControl" 
                                        PreviewRequested="OnDestinationPreviewRequested" 
                                        Confirmed="OnDestinationConfirmed" 
                                        Cleared="OnDestinationCleared" 
                                        ZIndex="20" />

        <!-- ===================================================================== -->
        <!-- FLOATING UI ELEMENTS                                                  -->
        <!-- ===================================================================== -->

        <!-- Turn Overlay -->
        <Border x:Name="NextTurnOverlay" IsVisible="False" HorizontalOptions="Start" VerticalOptions="Start" Margin="16,16,0,0" Padding="16,12" BackgroundColor="{AppThemeBinding Light=#E6FFFFFF, Dark=#E61E1E1E}" StrokeThickness="1" Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" ZIndex="25">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,6" Opacity="0.15" Radius="12"/>
            </Border.Shadow>
            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                <!-- UPGRADE: Replaced ⬆️ with clean Material Symbol -->
                <Label x:Name="NextTurnIcon" FontFamily="MaterialSymbols" Grid.Column="0" Text="turn_slight_right" FontSize="40" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#1976D2, Dark=#64B5F6}"/>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                    <Label x:Name="NextTurnDistLabel" Text="500m" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#212121, Dark=White}"/>
                    <Label x:Name="NextTurnInstructionLabel" Text="Continue straight" FontSize="13" TextColor="#757575" MaxLines="2" LineBreakMode="TailTruncation" WidthRequest="140"/>
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- FLOATING MAP CONTROLS -->
        <VerticalStackLayout x:Name="FloatingMapControls" IsVisible="False" HorizontalOptions="End" VerticalOptions="End" Margin="0,0,16,180" Spacing="12" ZIndex="30">

            <!-- UPGRADE: Converted to Border to combine text and Material Symbols cleanly -->
            <Border x:Name="ClearPoisBtn" IsVisible="False" BackgroundColor="#E53935" HeightRequest="48" WidthRequest="130" Margin="0,0,0,8" Style="{StaticResource FloatingBtnStyle}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#E53935" Offset="0,4" Opacity="0.3" Radius="8" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnClearPoisClicked" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="6">
                    <Label Text="delete" FontFamily="MaterialSymbols" TextColor="White" FontSize="18" VerticalOptions="Center"/>
                    <Label Text="CLEAR POIS" TextColor="White" FontAttributes="Bold" FontSize="12" VerticalOptions="Center" CharacterSpacing="0.5"/>
                </HorizontalStackLayout>
            </Border>

            <!-- UPGRADE: Replaced emojis with crisp Material map icons -->
            <Button x:Name="HeadingUpButton" Text="explore" FontFamily="MaterialSymbols" FontSize="26" BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}" TextColor="#1E88E5" CornerRadius="28" WidthRequest="56" HeightRequest="56" Clicked="OnHeadingUpClicked">
                <Button.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Opacity="0.2" Radius="10"/>
                </Button.Shadow>
            </Button>

            <Button x:Name="RecenterMapButton" Text="my_location" FontFamily="MaterialSymbols" FontSize="26" BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}" TextColor="#1E88E5" CornerRadius="28" WidthRequest="56" HeightRequest="56" Clicked="OnRecenterMapClicked">
                <Button.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Opacity="0.2" Radius="10"/>
                </Button.Shadow>
            </Button>

            <Button x:Name="MapFollowButton" Text="navigation" FontFamily="MaterialSymbols" FontSize="26" BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}" TextColor="#00E676" CornerRadius="28" WidthRequest="56" HeightRequest="56" Clicked="OnMapFollowClicked" IsVisible="False">
                <Button.Shadow>
                    <Shadow Brush="#00E676" Offset="0,4" Opacity="0.3" Radius="10"/>
                </Button.Shadow>
            </Button>

            <Button x:Name="OverviewButton" Text="map" FontFamily="MaterialSymbols" FontSize="26" BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}" TextColor="#1E88E5" CornerRadius="28" WidthRequest="56" HeightRequest="56" Clicked="OnOverviewClicked">
                <Button.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Opacity="0.2" Radius="10"/>
                </Button.Shadow>
            </Button>
        </VerticalStackLayout>


        <!-- ========================================== -->
        <!-- BOTTOM SHEET DRAWER                        -->
        <!-- ========================================== -->
        <!-- UPGRADE: Top-only corner radius for a true native bottom sheet look -->
        <Border x:Name="ActionDrawer" VerticalOptions="End" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" StrokeThickness="0" Margin="0,0,0,-40" ZIndex="40">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24,24,0,0"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,-6" Opacity="0.15" Radius="20" />
            </Border.Shadow>

            <Grid RowDefinitions="Auto, Auto, Auto, *">

                <!-- Drawer Headers -->
                <Grid Grid.Row="0">
                    <!-- Idle Header -->
                    <Grid x:Name="IdleHeader" Padding="16,16,16,8" BackgroundColor="Transparent" IsVisible="True">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDrawerHandleTapped" />
                            <PanGestureRecognizer PanUpdated="OnDrawerPanUpdated" />
                        </Grid.GestureRecognizers>

                        <VerticalStackLayout x:Name="AdminIdleHeader" HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                            <Label Text="Select a destination above" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#424242, Dark=#E0E0E0}" HorizontalOptions="Center"/>
                            <Label Text="to begin a new ride session." FontSize="13" TextColor="#9E9E9E" HorizontalOptions="Center"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout x:Name="RiderIdleHeader" HorizontalOptions="Center" VerticalOptions="Center" Spacing="2" IsVisible="False">
                            <Label Text="Waiting for Admin" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#424242, Dark=#E0E0E0}" HorizontalOptions="Center"/>
                            <Label Text="to set the convoy destination." FontSize="13" TextColor="#9E9E9E" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Pre-Nav Header -->
                    <Grid x:Name="PreNavigationHeader" ColumnDefinitions="*, Auto" Padding="20,16,20,8" BackgroundColor="Transparent" IsVisible="False">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDrawerHandleTapped" />
                            <PanGestureRecognizer PanUpdated="OnDrawerPanUpdated" />
                        </Grid.GestureRecognizers>

                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                            <Label x:Name="PreNavDestLabel" Text="Target Destination" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#212121, Dark=White}" LineBreakMode="TailTruncation" MaxLines="1"/>
                            <Label x:Name="PreNavDistLabel" Text="Calculating route..." FontSize="13" TextColor="#1E88E5" FontAttributes="Bold"/>
                        </VerticalStackLayout>

                        <Button x:Name="StartJourneyButton" Grid.Column="1" Text="START" BackgroundColor="#1E88E5" TextColor="White" FontAttributes="Bold" CharacterSpacing="1" CornerRadius="16" HeightRequest="48" Padding="24,0" Clicked="OnStartJourneyClicked" IsVisible="False" VerticalOptions="Center">
                            <Button.Shadow>
                                <Shadow Brush="#1E88E5" Offset="0,4" Opacity="0.3" Radius="8"/>
                            </Button.Shadow>
                        </Button>
                    </Grid>

                    <controls:LiveTelemetryHeaderView x:Name="TelemetryHeaderControl" IsVisible="False" HeaderTapped="OnDrawerHandleTapped" HeaderPanUpdated="OnDrawerPanUpdated" />
                </Grid>

                <!-- Drag Handle -->
                <Grid Grid.Row="1" Padding="0,4,0,16" BackgroundColor="Transparent">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDrawerHandleTapped" />
                        <PanGestureRecognizer PanUpdated="OnDrawerPanUpdated" />
                    </Grid.GestureRecognizers>
                    <BoxView HeightRequest="4" WidthRequest="36" CornerRadius="2" BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#424242}" HorizontalOptions="Center" />
                </Grid>

                <!-- Drawer Tabs -->
                <Grid Grid.Row="2" ColumnDefinitions="*, *, *, *" Margin="16,0,16,12" ColumnSpacing="8">
                    <Button x:Name="TabActionsBtn" Grid.Column="0" Text="Safety" BackgroundColor="Transparent" TextColor="#757575" FontAttributes="Bold" CornerRadius="16" HeightRequest="40" Clicked="OnDrawerTabClicked" />
                    <!-- TabStatsBtn is default active -->
                    <Button x:Name="TabStatsBtn" Grid.Column="1" Text="Convoy" BackgroundColor="#1E88E5" TextColor="White" FontAttributes="Bold" CornerRadius="16" HeightRequest="40" Clicked="OnDrawerTabClicked" />
                    <Button x:Name="TabMapSettingsBtn" Grid.Column="2" Text="Map" BackgroundColor="Transparent" TextColor="#757575" FontAttributes="Bold" CornerRadius="16" HeightRequest="40" Clicked="OnDrawerTabClicked" />
                    <Button x:Name="TabAdminBtn" Grid.Column="3" Text="Admin" BackgroundColor="Transparent" TextColor="#757575" FontAttributes="Bold" CornerRadius="16" HeightRequest="40" Clicked="OnDrawerTabClicked" />
                </Grid>

                <!-- Drawer Content Areas -->
                <ScrollView Grid.Row="3" Padding="0,0,0,50">
                    <Grid>
                        <controls:SafetyActionsTabView x:Name="DrawerActionsTab" IsVisible="False" EmergencyStopClicked="OnEmergencyStopClicked" RefuelStopClicked="OnRefuelStopClicked" RestStopClicked="OnRestStopClicked" LaunchNativeNavClicked="OnLaunchNativeNavClicked" FormationChangeClicked="OnFormationChangeClicked" />

                        <!-- TAB 2: CONVOY -->
                        <VerticalStackLayout x:Name="ConvoyTabContainer" IsVisible="True" Spacing="16" Padding="0">
                            <VerticalStackLayout x:Name="DrawerStatsTab" IsVisible="True" Spacing="16">
                                <Label Text="{Binding Source={x:Reference GroupNameLabel}, Path=Text}"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#212121, Dark=White}"
                                       HorizontalOptions="Start"
                                       Margin="16,4,16,0"/>

                                <controls:ConvoyRosterTabView x:Name="RosterControl"
                                                              RiderTapped="OnRiderTapped"
                                                              CopyPinClicked="OnCopyPinClicked" />
                            </VerticalStackLayout>

                            <!-- Leave Group Button -->
                            <Button Text="LEAVE CONVOY" 
                                    BackgroundColor="{AppThemeBinding Light=#FFF0F0, Dark=#331111}" 
                                    TextColor="#E53935" 
                                    CornerRadius="24" 
                                    HeightRequest="48" 
                                    HorizontalOptions="Fill" 
                                    Clicked="OnLeaveGroupClicked" 
                                    FontAttributes="Bold"
                                    CharacterSpacing="1"
                                    Margin="16,8,16,16"/>
                        </VerticalStackLayout>

                        <controls:AdminControlsTabView x:Name="DrawerAdminTab" IsVisible="False" PauseNavClicked="OnPauseNavClicked" ResumeNavClicked="OnResumeJourneyClicked" MeetupPointClicked="OnGenerateMeetupClicked" AdminSettingsClicked="OnAdminSettingsClicked" CompleteNavClicked="OnCompleteNavClicked" ResetTripClicked="OnResetDestinationClicked" />

                        <controls:MapSettingsTabView x:Name="DrawerMapSettingsTab" IsVisible="False" MapStyleChanged="OnMapStyleChanged" TrafficToggled="OnTrafficToggled" />
                    </Grid>
                </ScrollView>
            </Grid>
        </Border>

        <!-- ===================================================================== -->
        <!-- FULL SCREEN OVERLAYS (Stacked correctly without RowSpans)             -->
        <!-- ===================================================================== -->
        <controls:RiderManagementOverlay x:Name="RiderManagementOverlay" ActionSelected="OnRiderManagementActionSelected" ZIndex="90" />
        <controls:SensoryAlertOverlay x:Name="SensoryAlertOverlay" ZIndex="999" />
        <controls:PttOverlay x:Name="PttOverlay" ZIndex="2000" />
        <controls:LocationDisabledOverlay x:Name="LocationDisabledOverlay" ZIndex="1000" OpenSettingsRequested="OnOpenSettingsClicked" RetryRequested="OnRetryLocationClicked" />
        <controls:ConvoySettingsOverlay x:Name="ConvoySettingsOverlay" SettingsSubmitted="OnSettingsSubmitted" ZIndex="2500" />
        <controls:LoadingOverlay x:Name="GlobalLoadingOverlay" ZIndex="9999" />
        <controls:RideSummaryOverlay x:Name="RideSummaryOverlay" ZIndex="3000" CloseRequested="OnCloseRideSummaryClicked" />

        <!-- BIGGER, CENTERED AUTO-PAUSE BANNER -->
        <!-- UPGRADE: Replaced Frame with Border, glowing icon, and glassmorphism -->
        <Border x:Name="AutoPauseBanner" 
                IsVisible="False" 
                VerticalOptions="Center" 
                HorizontalOptions="Center" 
                WidthRequest="320" 
                Padding="24" 
                StrokeThickness="1"
                Stroke="#33FFFFFF"
                BackgroundColor="#E6121212" 
                ZIndex="200">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,10" Opacity="0.4" Radius="20"/>
            </Border.Shadow>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnAutoPauseTapped" />
            </Border.GestureRecognizers>

            <VerticalStackLayout Spacing="16" HorizontalOptions="Center">
                <Label Text="front_hand" FontFamily="MaterialSymbols" FontSize="56" TextColor="#FB8C00" HorizontalOptions="Center">
                    <Label.Shadow>
                        <Shadow Brush="#FB8C00" Offset="0,0" Radius="16" Opacity="0.5"/>
                    </Label.Shadow>
                </Label>
                <VerticalStackLayout Spacing="4">
                    <Label Text="You've been stopped." FontSize="20" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                    <Label Text="Tap here to Pause the ride for the entire group." FontSize="14" TextColor="#B0BEC5" HorizontalOptions="Center" HorizontalTextAlignment="Center" LineHeight="1.2"/>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>