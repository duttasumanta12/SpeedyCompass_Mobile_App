<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             xmlns:controls="clr-namespace:SpeedyCompass.Controls"
             xmlns:local="clr-namespace:SpeedyCompass"
             xmlns:models="clr-namespace:SpeedyCompass.Models"
             x:Class="SpeedyCompass.LobbyPage"
             x:Name="ThisPage"
             Title="Ride Lobby">
    <Grid RowDefinitions="Auto, *">

        <!-- ===================================================================== -->
        <!-- 1. MODERN HEADER -->
        <!-- ===================================================================== -->
        <Grid Grid.Row="0" ZIndex="100" ColumnDefinitions="*, Auto" BackgroundColor="{AppThemeBinding Light=White, Dark=#121212}" Padding="20,15,20,15">
            <Grid.Shadow>
                <Shadow Brush="Black" Offset="0,4" Opacity="0.05" Radius="10"/>
            </Grid.Shadow>
            <Label Grid.Column="0" Text="{Binding Source={x:Reference GroupNameLabel}, Path=Text}" FontSize="22" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#111, Dark=White}" VerticalOptions="Center"/>
            <Button Grid.Column="1" Text="Leave" BackgroundColor="#FFEBEB" TextColor="#D32F2F" CornerRadius="18" HeightRequest="36" Padding="20,0" Clicked="OnLeaveGroupClicked" FontAttributes="Bold"/>
        </Grid>

        <!-- Hidden Label to satisfy existing bindings -->
        <Label x:Name="GroupNameLabel" IsVisible="False"/>

        <!-- ===================================================================== -->
        <!-- 2. MAIN MAP VIEW & FLOATING UI -->
        <!-- ===================================================================== -->
        <Grid Grid.Row="1">

            <!-- ALWAYS VISIBLE MAP -->
            <controls:CustomMap x:Name="LiveMap" MapClicked="OnMapClicked" IsShowingUser="False" CustomPins="{Binding MapPins, Source={x:Reference ThisPage}}" Margin="0,0,0,140" />

            <AbsoluteLayout x:Name="PinOverlayLayout" InputTransparent="True" CascadeInputTransparent="True" ZIndex="10" Grid.Row="0" Grid.RowSpan="2" BindableLayout.ItemsSource="{Binding MapPins, Source={x:Reference ThisPage}}" Margin="0,0,0,160">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <!-- ContentView acts as the 0,0 anchor. The Translation binds to the Android Projection Engine! -->
                        <ContentView AbsoluteLayout.LayoutBounds="0,0,-1,-1"
                                     TranslationX="{Binding ScreenX}"
                                     TranslationY="{Binding ScreenY}">

                            <!-- The Grid translates negatively to hover precisely over the dot -->
                            <Grid TranslationX="-50" TranslationY="-75" WidthRequest="100" HorizontalOptions="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- The Main Bubble -->
                                <Border Grid.Row="0" BackgroundColor="#E61E1E1E" Stroke="{Binding PinColor}" StrokeThickness="2" 
                                        StrokeShape="RoundRectangle 10" Padding="8,4" HorizontalOptions="Fill">
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Offset="0,4" Opacity="0.3" Radius="5"/>
                                    </Border.Shadow>
                                    <VerticalStackLayout Spacing="0">
                                        <Label Text="{Binding Username}" TextColor="White" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center" LineBreakMode="TailTruncation" MaxLines="1"/>

                                        <!-- THE FIX: Automatically hide this label if the user is "You" -->
                                        <Label Text="{Binding Speed}" TextColor="DodgerBlue" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding Username}" Value="You">
                                                    <Setter Property="IsVisible" Value="False" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </VerticalStackLayout>
                                </Border>

                                <!-- The Downward Tail (Drawn via Vector Path) -->
                                <Path Grid.Row="1" Data="M 0,0 L 12,0 L 6,8 Z" Fill="{Binding PinColor}" HorizontalOptions="Center" Margin="0,-2,0,0"/>
                            </Grid>
                        </ContentView>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </AbsoluteLayout>
            
            <controls:DestinationSearchView x:Name="DestinationSearchControl" 
                                            PreviewRequested="OnDestinationPreviewRequested" 
                                            Confirmed="OnDestinationConfirmed" 
                                            Cleared="OnDestinationCleared" />

            <!-- ===================================================================== -->
            <!-- THE COMPACT NEXT TURN OVERLAY -->
            <!-- ===================================================================== -->
            <Border x:Name="NextTurnOverlay" IsVisible="False" HorizontalOptions="Start" VerticalOptions="Start" Margin="15,15,0,0" Padding="10,8" BackgroundColor="{AppThemeBinding Light=#F2FFFFFF, Dark=#F21E1E1E}" StrokeThickness="0" ZIndex="25">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Opacity="0.15" Radius="10"/>
                </Border.Shadow>
                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                    <Label x:Name="NextTurnIcon" Grid.Column="0" Text="⬆️" FontSize="24" VerticalOptions="Center" TextColor="DodgerBlue"/>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                        <Label x:Name="NextTurnDistLabel" Text="500m" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                        <Label x:Name="NextTurnInstructionLabel" Text="Continue straight" FontSize="11" TextColor="Gray" MaxLines="2" LineBreakMode="TailTruncation" WidthRequest="120"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- FLOATING MAP CONTROLS -->
            <VerticalStackLayout x:Name="FloatingMapControls" IsVisible="False" HorizontalOptions="End" VerticalOptions="End" Margin="0, 0, 15, 180" Spacing="15" ZIndex="30">
                <Button x:Name="ClearPoisBtn" IsVisible="False" Text="🧹 Clear POIs" BackgroundColor="#D32F2F" TextColor="White" CornerRadius="25" HeightRequest="50" WidthRequest="120" FontAttributes="Bold" FontSize="12" Margin="0,0,0,10" Clicked="OnClearPoisClicked">
                    <Button.Shadow>
                        <Shadow Brush="Black" Offset="0,4" Opacity="0.3" Radius="5" />
                    </Button.Shadow>
                </Button>
                <!--#if DEBUG
                <Frame x:Name="SimSpeedFrame" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" Padding="0" CornerRadius="10" IsVisible="False" HasShadow="True" WidthRequest="40" HeightRequest="150" HorizontalOptions="Center">
                    <Slider x:Name="SimSpeedSlider" Minimum="0" Maximum="140" Value="60" Rotation="-90" VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="130" ValueChanged="OnSimSpeedSliderChanged" MinimumTrackColor="DodgerBlue" />
                </Frame>
                #endif-->
                <Button x:Name="HeadingUpButton" Text="🧭" FontSize="24" BackgroundColor="{AppThemeBinding Light=White, Dark=#333333}" TextColor="DodgerBlue" CornerRadius="27" WidthRequest="55" HeightRequest="55" Clicked="OnHeadingUpClicked" Shadow="{Shadow Brush=Black, Offset='0,4', Opacity=0.2, Radius=8}" />
                <Button x:Name="RecenterMapButton" Text="🎯" FontSize="24" BackgroundColor="{AppThemeBinding Light=White, Dark=#333333}" TextColor="DodgerBlue" CornerRadius="27" WidthRequest="55" HeightRequest="55" Clicked="OnRecenterMapClicked" Shadow="{Shadow Brush=Black, Offset='0,4', Opacity=0.2, Radius=8}" />
                <Button x:Name="MapFollowButton" Text="📍" FontSize="24" BackgroundColor="{AppThemeBinding Light=White, Dark=#333333}" TextColor="MediumSeaGreen" CornerRadius="27" WidthRequest="55" HeightRequest="55" Clicked="OnMapFollowClicked" IsVisible="False" Shadow="{Shadow Brush=Black, Offset='0,4', Opacity=0.2, Radius=8}" />
                <Button x:Name="OverviewButton" Text="🗺️" FontSize="24" BackgroundColor="{AppThemeBinding Light=White, Dark=#333333}" TextColor="DodgerBlue" CornerRadius="27" WidthRequest="55" HeightRequest="55" Clicked="OnOverviewClicked" Shadow="{Shadow Brush=Black, Offset='0,4', Opacity=0.2, Radius=8}" />
            </VerticalStackLayout>

            <!-- ========================================== -->
            <!-- 3. ALWAYS-ON BOTTOM SHEET DRAWER -->
            <!-- ========================================== -->
            <Border x:Name="ActionDrawer" VerticalOptions="End" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" StrokeThickness="0" Margin="0,0,0,-40" ZIndex="40">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,-4" Opacity="0.15" Radius="15" />
                </Border.Shadow>

                <Grid RowDefinitions="Auto, Auto, Auto, *">
                    <Grid Grid.Row="0">
                        <!-- 1. IDLE HEADER -->
                        <Grid x:Name="IdleHeader" Padding="15,15,15,5" BackgroundColor="Transparent" IsVisible="True">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDrawerHandleTapped" />
                                <PanGestureRecognizer PanUpdated="OnDrawerPanUpdated" />
                            </Grid.GestureRecognizers>

                            <!-- Visible ONLY to Admin -->
                            <VerticalStackLayout x:Name="AdminIdleHeader" HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                                <Label Text="Select a destination above" FontSize="16" FontAttributes="Bold" TextColor="Gray" HorizontalOptions="Center"/>
                                <Label Text="to begin a new ride session." FontSize="12" TextColor="LightGray" HorizontalOptions="Center"/>
                            </VerticalStackLayout>

                            <!-- Visible ONLY to Standard Riders -->
                            <VerticalStackLayout x:Name="RiderIdleHeader" HorizontalOptions="Center" VerticalOptions="Center" Spacing="2" IsVisible="False">
                                <Label Text="Waiting for Admin" FontSize="16" FontAttributes="Bold" TextColor="Gray" HorizontalOptions="Center"/>
                                <Label Text="to set the convoy destination." FontSize="12" TextColor="LightGray" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- 2. PRE-NAVIGATION HEADER (Replaces PendingDestinationFrame) -->
                        <Grid x:Name="PreNavigationHeader" ColumnDefinitions="*, Auto" Padding="15,15,15,5" BackgroundColor="Transparent" IsVisible="False">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDrawerHandleTapped" />
                                <PanGestureRecognizer PanUpdated="OnDrawerPanUpdated" />
                            </Grid.GestureRecognizers>
                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                                <Label x:Name="PreNavDestLabel" Text="Target Destination" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#333, Dark=White}" LineBreakMode="TailTruncation" MaxLines="1"/>
                                <Label x:Name="PreNavDistLabel" Text="Calculating route..." FontSize="13" TextColor="DodgerBlue" FontAttributes="Bold"/>
                            </VerticalStackLayout>
                            <Button x:Name="StartJourneyButton" Grid.Column="1" Text="🚀 Start" BackgroundColor="DodgerBlue" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="45" Padding="15,0" Clicked="OnStartJourneyClicked" IsVisible="False" VerticalOptions="Center"/>
                        </Grid>
                        <!-- 3. REDESIGNED TELEMETRY HEADER COMPONENT -->
                        <controls:LiveTelemetryHeaderView x:Name="TelemetryHeaderControl" 
                                                          IsVisible="False" 
                                                          HeaderTapped="OnDrawerHandleTapped" 
                                                          HeaderPanUpdated="OnDrawerPanUpdated" />
                    </Grid>

                    <!-- DRAG HANDLE -->
                    <Grid Grid.Row="1" Padding="0,5,0,15" BackgroundColor="Transparent">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDrawerHandleTapped" />
                            <PanGestureRecognizer PanUpdated="OnDrawerPanUpdated" />
                        </Grid.GestureRecognizers>
                        <BoxView HeightRequest="5" WidthRequest="40" CornerRadius="2.5" BackgroundColor="LightGray" HorizontalOptions="Center" />
                    </Grid>

                    <!-- DRAWER TABS -->
                    <Grid Grid.Row="2" ColumnDefinitions="*, *, *, *" Margin="10,0,10,10">
                        <Button x:Name="TabActionsBtn" Grid.Column="0" Text="Safety" BackgroundColor="Transparent" TextColor="Gray" CornerRadius="20" Margin="2" Clicked="OnDrawerTabClicked" />
                        <Button x:Name="TabStatsBtn" Grid.Column="1" Text="Convoy" BackgroundColor="DodgerBlue" TextColor="White" CornerRadius="20" Margin="2" Clicked="OnDrawerTabClicked" />
                        <Button x:Name="TabMapSettingsBtn" Grid.Column="2" Text="Map" BackgroundColor="Transparent" TextColor="Gray" CornerRadius="20" Margin="2" Clicked="OnDrawerTabClicked" />
                        <Button x:Name="TabAdminBtn" Grid.Column="3" Text="Admin" BackgroundColor="Transparent" TextColor="Gray" CornerRadius="20" Margin="2" Clicked="OnDrawerTabClicked" />
                    </Grid>

                    <!-- SCROLLABLE CONTENT AREA -->
                    <ScrollView Grid.Row="3" Padding="20,10,20,50">
                        <Grid>
                            <!-- TAB 1: SAFETY & ACTIONS -->
                            <controls:SafetyActionsTabView x:Name="DrawerActionsTab" IsVisible="False"
                                       EmergencyStopClicked="OnEmergencyStopClicked"
                                       RefuelStopClicked="OnRefuelStopClicked"
                                       RestStopClicked="OnRestStopClicked"
                                       LaunchNativeNavClicked="OnLaunchNativeNavClicked" />

                            <!-- TAB 2: CONVOY (Unified Roster + Telemetry Merge) -->
                            <controls:ConvoyRosterTabView x:Name="DrawerStatsTab" IsVisible="True"
                                      RiderTapped="OnRiderTapped"
                                      CopyPinClicked="OnCopyPinClicked" />

                            <!-- TAB 3: ADMIN CONTROLS -->
                            <controls:AdminControlsTabView x:Name="DrawerAdminTab" IsVisible="False"
                                       PauseNavClicked="OnPauseNavClicked"
                                       ResumeNavClicked="OnResumeJourneyClicked"
                                       MeetupPointClicked="OnGenerateMeetupClicked"
                                       AdminSettingsClicked="OnAdminSettingsClicked"
                                       CompleteNavClicked="OnCompleteNavClicked"
                                       ResetTripClicked="OnResetDestinationClicked" />

                            <!-- TAB 4: MAP SETTINGS -->
                            <controls:MapSettingsTabView x:Name="DrawerMapSettingsTab" IsVisible="False"
                                     MapStyleChanged="OnMapStyleChanged"
                                     TrafficToggled="OnTrafficToggled" />
                        </Grid>
                    </ScrollView>
                </Grid>
            </Border>

            <!-- OVERLAYS: ALERTS & LOADERS -->
            <controls:SensoryAlertOverlay x:Name="SensoryAlertOverlay" Grid.RowSpan="100" ZIndex="999" />

            <controls:PttOverlay x:Name="PttOverlay" Grid.RowSpan="100" ZIndex="2000" />

            <controls:LocationDisabledOverlay x:Name="LocationDisabledOverlay" Grid.RowSpan="100" ZIndex="1000" 
                                          OpenSettingsRequested="OnOpenSettingsClicked" 
                                          RetryRequested="OnRetryLocationClicked" />

            <controls:AdminSettingsOverlay x:Name="AdminSettingsOverlay" 
                                       SettingsSaved="OnAdminSettingsSaved" />

            <controls:LoadingOverlay x:Name="GlobalLoadingOverlay" Grid.RowSpan="100" 
                             Grid.ColumnSpan="100" 
                             ZIndex="9999" />

            <controls:RideSummaryOverlay x:Name="RideSummaryOverlay" Grid.RowSpan="100" ZIndex="3000" 
                                     CloseRequested="OnCloseRideSummaryClicked" />

        </Grid>
    </Grid>
</ContentPage>